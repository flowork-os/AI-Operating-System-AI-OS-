[Unit]
Description=Flowork OS Sovereign Quantum Forex Calendar Desktop HUD
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/opt/floworkos/bin/flowork-forex-calendar-hud
Restart=always
RestartSec=3
Environment=DISPLAY=:0

[Install]
WantedBy=graphical-session.target default.target
