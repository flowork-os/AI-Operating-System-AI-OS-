#!/usr/bin/env python3
"""
Flowork Live Stage CLI Launcher
Controls the Dual-Plane Execution Virtual Stage (:99), Floating Control Pill,
and Pilot #1 Browser CDP connection.
"""

import json
import os
import socket
import subprocess
import sys
import time

APP_DIR = "/opt/floworkos/apps/flowork-stage"
STAGE_SOCK = "/tmp/flowork-stage.sock"


def ipc_call(req: dict) -> dict:
    if not os.path.exists(STAGE_SOCK):
        return {"ok": False, "error": "Stage not running"}
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(5.0)
        s.connect(STAGE_SOCK)
        s.sendall((json.dumps(req) + "\n").encode("utf-8"))
        data = s.recv(8192).decode("utf-8", errors="ignore").strip()
        s.close()
        return json.loads(data) if data else {"ok": False}
    except Exception as e:
        return {"ok": False, "error": str(e)}


def start_stage(with_browser: bool = False):
    st = ipc_call({"action": "status"})
    if st.get("ok"):
        print(json.dumps({"ok": True, "already_running": True, "status": st}))
        return

    daemon_args = [sys.executable, os.path.join(APP_DIR, "stage_daemon.py")]
    if with_browser:
        daemon_args.append("--with-browser")

    subprocess.Popen(
        daemon_args,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )

    for _ in range(50):
        if os.path.exists(STAGE_SOCK):
            st = ipc_call({"action": "status"})
            if st.get("ok"):
                break
        time.sleep(0.15)

    # Launch floating control pill on :0
    subprocess.Popen(
        [sys.executable, os.path.join(APP_DIR, "stage_hud.py")],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )

    if with_browser:
        subprocess.run(
            [os.path.join(APP_DIR, "stage_browser.py"), "connect"],
            capture_output=True,
        )

    print(json.dumps(ipc_call({"action": "status"}), indent=2))


def main():
    if len(sys.argv) < 2:
        print("Usage: flowork-stage <start [--with-browser]|stop|status|pause|resume|toggle|browser [url]>")
        sys.exit(1)

    cmd = sys.argv[1]
    if cmd == "start":
        start_stage("--with-browser" in sys.argv[2:])
    elif cmd in ("stop", "status", "pause", "resume", "toggle"):
        print(json.dumps(ipc_call({"action": cmd}), indent=2))
    elif cmd == "browser":
        url = sys.argv[2] if len(sys.argv) > 2 else "https://www.google.com"
        res = ipc_call({"action": "launch_browser", "url": url})
        if res.get("ok"):
            subprocess.run(
                [os.path.join(APP_DIR, "stage_browser.py"), "connect"],
                capture_output=True,
            )
        print(json.dumps(res, indent=2))
    else:
        print(f"Unknown command: {cmd}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
