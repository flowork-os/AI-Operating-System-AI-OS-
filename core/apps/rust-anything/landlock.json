{
  "schema_version": "1.0",
  "description": "Default least-privilege Landlock LSM permission manifest for Flowork OS apps and skills",
  "read_only": [
    "/usr",
    "/lib",
    "/lib64",
    "/bin",
    "/etc",
    "/opt/floworkos/bin",
    "/opt/floworkos/policies",
    "/opt/floworkos/skills",
    "/opt/floworkos/apps/rust-anything"
  ],
  "read_write": [
    "/tmp",
    "/dev/shm",
    "/opt/floworkos/documents"
  ],
  "execute": [
    "/usr/bin",
    "/bin",
    "/usr/local/bin",
    "/opt/floworkos/bin",
    "/lib",
    "/lib64",
    "/usr/lib"
  ],
  "network_ports": []
}