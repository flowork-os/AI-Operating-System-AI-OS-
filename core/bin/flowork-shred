#!/usr/bin/env python3
"""
Flowork OS — Forensic Shredder Engine
Performs DoD 5220.22-M / GNU 3-pass random + zero-fill forensic wipe.
Overwrites every data block 3 times with cryptographic random entropy,
then overwrites with 0x00 zero-fill, obfuscates metadata, and truncates.
Guarantees unrecoverability against forensic carving tools.
"""
import os
import sys
import uuid
import subprocess
import shutil
from pathlib import Path

SHRED_BIN = "/usr/bin/shred"
NOTIFY_SEND = "/usr/bin/notify-send"

def send_notification(title, message, urgency="critical"):
    if os.path.exists(NOTIFY_SEND):
        try:
            subprocess.run([
                NOTIFY_SEND,
                "-a", "Flowork Forensic Shredder",
                "-u", urgency,
                "-i", "security-high",
                title,
                message
            ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception:
            pass

def shred_single_file(file_path):
    p = Path(file_path).resolve()
    if not p.exists() or p.is_dir():
        return False, "File does not exist or is a directory"

    # 1. 3-pass random + 1-pass zero-fill + truncate unlink
    cmd = [SHRED_BIN, "-u", "-z", "-n", "3", str(p)]
    res = subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True)
    return (res.returncode == 0), ("Permanently wiped" if res.returncode == 0 else res.stderr)

def shred_directory(dir_path):
    d = Path(dir_path).resolve()
    if not d.exists() or not d.is_dir():
        return False, "Directory does not exist"

    wiped_files = 0
    # 1. Walk bottom-up to shred files and scramble names
    for root, dirs, files in os.walk(str(d), topdown=False):
        for f in files:
            fp = os.path.join(root, f)
            try:
                # Scramble filename first to destroy directory entry journal traces
                random_name = os.path.join(root, f".wipe_{uuid.uuid4().hex[:12]}")
                os.rename(fp, random_name)
                ok, _ = shred_single_file(random_name)
                if ok:
                    wiped_files += 1
            except Exception:
                pass

        for subd in dirs:
            dp = os.path.join(root, subd)
            try:
                os.rmdir(dp)
            except Exception:
                pass

    try:
        os.rmdir(str(d))
    except Exception:
        shutil.rmtree(str(d), ignore_errors=True)

    # Flush kernel filesystem journal
    subprocess.run(["sync"], check=False)
    return True, f"Wiped {wiped_files} files inside directory"

def main():
    if len(sys.argv) < 2:
        print("Usage: flowork-shred <path1> [path2...]")
        sys.exit(1)

    targets = sys.argv[1:]
    success_count = 0

    for t in targets:
        p = Path(t).resolve()
        if not p.exists():
            continue
        if p.is_dir():
            ok, msg = shred_directory(p)
        else:
            ok, msg = shred_single_file(p)

        if ok:
            success_count += 1
            print(f"[SHREDDED] {p.name}: {msg}")

    # Synchronize disks
    subprocess.run(["sync"], check=False)

    if success_count > 0:
        names = ", ".join(Path(t).name for t in targets[:3])
        if len(targets) > 3:
            names += f" (+{len(targets) - 3} more)"
        send_notification("💀 HAPUS PERMANEN SELESAI", f"{names}\nFile berhasil ditimpa 3-pass acak + 0x00 murni.\nTidak dapat dipulihkan ahli forensik.")

    sys.exit(0 if success_count > 0 else 1)

if __name__ == "__main__":
    main()
