#!/usr/bin/env python3
# ==============================================================================
# 👑 FLOWORK OS — REAL-TIME ANDROID APP & APK SYNC DAEMON
# Continuously monitors package lifecycle (Install/Uninstall) in Android Subsystem
# and instantly reflects changes in Start Menu and Launchpad within seconds.
# ==============================================================================

import os
import sys
import time
import subprocess
import hashlib

FLOWORK_ROOT = os.getenv("FLOWORK_ROOT", "/opt/floworkos")
ANDROID_SDK = os.getenv("ANDROID_SDK_ROOT", os.path.join(FLOWORK_ROOT, "android-sdk"))
ADB_BIN = os.path.join(ANDROID_SDK, "platform-tools/adb") if os.path.exists(os.path.join(ANDROID_SDK, "platform-tools/adb")) else "/usr/bin/adb"
SYNC_BIN = os.path.join(FLOWORK_ROOT, "bin/flowork-app-sync")

PID_FILE = f"/run/user/{os.getuid()}/flowork-app-sync-daemon.pid"

def is_adb_online():
    try:
        out = subprocess.check_output([ADB_BIN, "devices"], text=True, timeout=3)
        for line in out.splitlines():
            if "emulator-5554" in line and "device" in line and not "offline" in line:
                return True
    except Exception:
        pass
    return False

def get_packages_hash():
    try:
        res = subprocess.run([ADB_BIN, "shell", "pm", "list", "packages", "-3"],
                             capture_output=True, text=True, timeout=4)
        if res.returncode == 0:
            return hashlib.sha256(res.stdout.encode('utf-8')).hexdigest()
    except Exception:
        pass
    return None

def run_sync():
    try:
        subprocess.run([SYNC_BIN], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=20)
    except Exception as e:
        print(f"[flowork-app-sync-daemon] Sync error: {e}", file=sys.stderr)

def main():
    # Write PID
    with open(PID_FILE, "w") as f:
        f.write(str(os.getpid()))

    last_hash = None
    was_online = False

    while True:
        online = is_adb_online()
        if online:
            if not was_online:
                # Subsystem just came online -> sync immediately
                was_online = True
                run_sync()
                last_hash = get_packages_hash()
            else:
                curr_hash = get_packages_hash()
                if curr_hash and curr_hash != last_hash:
                    # Package set changed (App installed or uninstalled)
                    last_hash = curr_hash
                    run_sync()
        else:
            was_online = False

        time.sleep(4)

if __name__ == "__main__":
    main()
