#!/usr/bin/env python3
"""
Flowork OS — Audio Transformer Shim
Delegates audio calls to the unified /opt/floworkos/bin/flowork-transformer engine.
"""
import sys
import subprocess

TRANSFORMER = "/opt/floworkos/bin/flowork-transformer"

if __name__ == "__main__":
    if len(sys.argv) < 2:
        print("Usage: flowork-audio-transformer <clean-ai|mastering|denoise|split-stem> <file...>")
        sys.exit(1)
    
    cmd = [TRANSFORMER, sys.argv[1], *sys.argv[2:]]
    res = subprocess.run(cmd)
    sys.exit(res.returncode)
