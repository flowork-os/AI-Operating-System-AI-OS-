        # Neural Prompt Entry Field (Multi-line with Shift+Enter)
        class MultiLineNeuralEntry(Gtk.Overlay):
            def __init__(self):
                super().__init__()
                self._activate_cbs = []
                self._changed_cbs = []
                self.scroll = Gtk.ScrolledWindow()
                self.scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
                self.scroll.set_min_content_height(34)
                self.scroll.set_max_content_height(110)
                self.scroll.set_propagate_natural_height(True)
                self.scroll.set_hexpand(True)
                self.scroll.set_shadow_type(Gtk.ShadowType.NONE)
                self.scroll.set_valign(Gtk.Align.CENTER)
                self.scroll.get_style_context().add_class("neural-entry-scroll")

                self.tv = Gtk.TextView()
                self.tv.set_wrap_mode(Gtk.WrapMode.WORD_CHAR)
                self.tv.set_accepts_tab(False)
                self.tv.set_left_margin(4)
                self.tv.set_right_margin(4)
                self.tv.set_top_margin(7)
                self.tv.set_bottom_margin(7)
                self.tv.get_style_context().add_class("neural-entry")
                self.buf = self.tv.get_buffer()
                self.scroll.add(self.tv)
                self.add(self.scroll)

                self.placeholder_lbl = Gtk.Label(label="")
                self.placeholder_lbl.set_xalign(0.0)
                self.placeholder_lbl.set_margin_start(6)
                self.placeholder_lbl.set_no_show_all(True)
                self.placeholder_lbl.set_sensitive(False)
                self.placeholder_lbl.get_style_context().add_class("neural-entry-placeholder")
                self.add_overlay(self.placeholder_lbl)
                self.set_overlay_pass_through(self.placeholder_lbl, True)

                self.buf.connect("changed", self._on_buf_changed)

            def _on_buf_changed(self, *_):
                has_text = len(self.get_text()) > 0
                self.placeholder_lbl.set_visible(not has_text)
                for cb in self._changed_cbs:
                    cb(self)

            def set_placeholder_text(self, text):
                self.placeholder_lbl.set_text(text or "")
                self.placeholder_lbl.set_visible(len(self.get_text()) == 0)

            def get_text(self):
                start, end = self.buf.get_bounds()
                return self.buf.get_text(start, end, True)

            def get_position(self):
                try:
                    mark = self.buf.get_insert()
                    if mark:
                        it = self.buf.get_iter_at_mark(mark)
                        return it.get_offset()
                except Exception:
                    pass
                return len(self.get_text())

            def set_text(self, text):
                self.buf.set_text(text or "")
                self.placeholder_lbl.set_visible(len(text or "") == 0)

            def set_position(self, pos):
                if pos < 0:
                    it = self.buf.get_end_iter()
                else:
                    it = self.buf.get_iter_at_offset(pos)
                self.buf.place_cursor(it)

            def select_region(self, start_pos, end_pos):
                s_it = self.buf.get_iter_at_offset(max(0, start_pos))
                e_it = self.buf.get_end_iter() if end_pos < 0 else self.buf.get_iter_at_offset(end_pos)
                self.buf.select_range(s_it, e_it)

            def grab_focus(self):
                self.tv.grab_focus()

            def get_style_context(self):
                return self.tv.get_style_context()

            def set_has_frame(self, _val):
                pass

            def set_sensitive(self, val):
                self.tv.set_sensitive(val)

            def connect(self, sig, cb, *args):
                if sig == "activate":
                    self._activate_cbs.append(cb)
                    return len(self._activate_cbs)
                elif sig == "changed":
                    self._changed_cbs.append(cb)
                    return len(self._changed_cbs)
                return self.tv.connect(sig, cb, *args)

            def emit_activate(self):
                for cb in self._activate_cbs:
                    cb(self)

        self.entry = MultiLineNeuralEntry()
        self.entry.set_placeholder_text("Ask, type / for skills, or command Mr. Flow... (Shift+Enter: newline)")
