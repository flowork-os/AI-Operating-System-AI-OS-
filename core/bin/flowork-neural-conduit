    def set_attachment(self, file_path, file_type=None):
        if not file_path or not os.path.isfile(file_path):
            return
        ext = os.path.splitext(file_path)[1].lower().lstrip(".")
        is_img = ext in ["png", "jpg", "jpeg", "webp", "gif", "bmp", "svg"]
        ftype = file_type or ("image" if is_img else "file")
        try:
            kb = round(os.path.getsize(file_path) / 1024, 1)
        except Exception:
            kb = 0

        fname = os.path.basename(file_path)
        self.current_attachment = {
            "type": ftype,
            "path": file_path,
            "name": fname,
            "size_kb": kb
        }

        if ftype == "image":
            try:
                pixbuf = GdkPixbuf.Pixbuf.new_from_file_at_scale(file_path, 28, 28, True)
                self.img_attach_thumb.set_from_pixbuf(pixbuf)
                self.img_attach_thumb.show()
                self.lbl_attach_icon.hide()
            except Exception:
                self.lbl_attach_icon.set_markup("<span>🖼️</span>")
                self.lbl_attach_icon.show()
                self.img_attach_thumb.hide()
        else:
            self.lbl_attach_icon.set_markup("<span>📄</span>")
            self.lbl_attach_icon.show()
            self.img_attach_thumb.hide()

        self.lbl_attach_name.set_markup(f"<span size='small' color='#00ff66'>{GLib.markup_escape_text(fname)} ({kb} KB)</span>")
        self.attach_chip.set_no_show_all(False)
        self.attach_chip.show_all()
        self.attach_chip.set_no_show_all(True)
        if ftype == "image":
            self.lbl_attach_icon.hide()
        else:
            self.img_attach_thumb.hide()
        self.entry.grab_focus()

    def clear_attachment(self):
        self.current_attachment = None
        self.attach_chip.hide()
        self.img_attach_thumb.clear()
        self.update_voice_ui()

    def on_screenshot_clicked(self, widget):
        self.update_geometry()
        saved_x = self.pos_x
        saved_y = self.pos_y

        was_console_visible = hasattr(self, "matrix_console") and self.matrix_console.get_visible()
        if was_console_visible:
            self.matrix_console.hide()

        self.hide()

        def _capture_thread():
            time.sleep(0.18)
            home = os.environ.get("HOME") or HOME
            target_dir = os.path.join(home, "Pictures", "Screenshots")
            os.makedirs(target_dir, exist_ok=True)
            ts = time.strftime("%Y%m%d_%H%M%S")
            dest_path = os.path.join(target_dir, f"User_Screenshot_{ts}.png")

            try:
                subprocess.run(
                    ["/opt/floworkos/bin/flowork-screenshot", "-a", "-f", dest_path],
                    timeout=120,
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL
                )
            except Exception:
                try:
                    subprocess.run(["maim", "-s", "-u", dest_path], timeout=60)
                except Exception:
                    pass

            def _restore_ui():
                self.update_geometry()
                self.show_all()
                self.move(saved_x, saved_y)
                # Multi-stage timeout reposition enforcement overrides any window manager centering
                GLib.timeout_add(20, lambda: self.move(saved_x, saved_y) or False)
                GLib.timeout_add(80, lambda: self.move(saved_x, saved_y) or False)
                GLib.timeout_add(160, lambda: self.move(saved_x, saved_y) or False)
                GLib.timeout_add(300, lambda: self.move(saved_x, saved_y) or False)

                if was_console_visible and hasattr(self, "matrix_console"):
                    self.matrix_console.show_all()
                    self.matrix_console.update_position()

                if os.path.isfile(dest_path) and os.path.getsize(dest_path) > 0:
                    self.set_attachment(dest_path)
                self.entry.grab_focus()

            GLib.idle_add(_restore_ui)

        threading.Thread(target=_capture_thread, daemon=True).start()

    def on_attach_file_clicked(self, widget):
        dialog = Gtk.FileChooserDialog(
            title="Pilih Berkas atau Gambar untuk Mr. Flow",
            parent=self,
            action=Gtk.FileChooserAction.OPEN
        )
        dialog.add_button(Gtk.STOCK_CANCEL, Gtk.ResponseType.CANCEL)
        dialog.add_button(Gtk.STOCK_OPEN, Gtk.ResponseType.OK)
        dialog.set_default_response(Gtk.ResponseType.OK)

        res = dialog.run()
        if res == Gtk.ResponseType.OK:
            fname = dialog.get_filename()
            if fname and os.path.isfile(fname):
                self.set_attachment(fname)
        dialog.destroy()

    def on_drag_data_received(self, widget, context, x, y, data, info, time_val):
        uris = data.get_uris()
        if uris:
            for uri in uris:
                clean_path = uri.replace("file://", "").strip()
                if os.path.isfile(clean_path):
                    self.set_attachment(clean_path)
                    context.finish(True, False, time_val)
                    return
        context.finish(False, False, time_val)

    def apply_slash_command(self, cmd_name):
        if cmd_name in ("resume", "sessions"):
            self.entry.set_text("")
            self.show_quick_session_switcher()
            return

        current_text = self.entry.get_text()
        pos = self.entry.get_position()
        if pos < 0:
            pos = len(current_text)
        text_before_cursor = current_text[:pos]
        text_after_cursor = current_text[pos:]

        # Find the slash command token immediately preceding the cursor, e.g. "/ora" or "/"
        match = re.search(r'/[a-zA-Z0-9_\-]*$', text_before_cursor)
        if match:
            start_idx = match.start()
            prefix = text_before_cursor[:start_idx]
            new_text = f"{prefix}/{cmd_name} {text_after_cursor}"
            cursor_pos = len(prefix) + len(cmd_name) + 2  # Position right after "/{cmd_name} "
        else:
            new_text = f"/{cmd_name} {current_text}".strip() + " "
            cursor_pos = len(f"/{cmd_name} ")

        self.entry.grab_focus()
        self.entry.set_text(new_text)
        self.entry.set_position(cursor_pos)
        self.entry.select_region(cursor_pos, cursor_pos)

        def _clear_sel():
            self.entry.set_position(cursor_pos)
            self.entry.select_region(cursor_pos, cursor_pos)
            return False

        GLib.idle_add(_clear_sel)

    def update_voice_ui(self):
        v_ctx = self.btn_voice.get_style_context()
        e_ctx = self.entry.get_style_context()
        if self.is_voice_active:
            if not v_ctx.has_class("active-voice"):
                v_ctx.add_class("active-voice")
            if not e_ctx.has_class("voice-active"):
                e_ctx.add_class("voice-active")
            self.lbl_voice.set_markup("<span size='medium' color='#ffffff'>🔊</span>")
            self.btn_voice.set_tooltip_text("Voice Mode: Active (Voice response enabled | Click to mute)")
            self.entry.set_placeholder_text("🔊 Voice Mode: Type a prompt or / for skills...")
        else:
            if v_ctx.has_class("active-voice"):
                v_ctx.remove_class("active-voice")
            if e_ctx.has_class("voice-active"):
                e_ctx.remove_class("voice-active")
            self.lbl_voice.set_markup("<span size='medium' color='#00f2fe'>🎙️</span>")
            self.btn_voice.set_tooltip_text("Voice Mode: Muted (Click to enable voice response)")
            self.entry.set_placeholder_text("Ask, type / for skills, or command Mr. Flow...")
        self.queue_draw()

    def update_reactor_ui(self, is_open):
        self.is_sidebar_open = is_open
        ctx = self.btn_reactor.get_style_context()
        if is_open:
            if not ctx.has_class("active-reactor"):
                ctx.add_class("active-reactor")
            self.lbl_reactor.set_markup("<span size='large' color='#ffffff'>⚡</span>")
        else:
            if ctx.has_class("active-reactor"):
                ctx.remove_class("active-reactor")
            self.lbl_reactor.set_markup("<span size='large' color='#00ff66'>⚡</span>")

    def update_connector_ui(self, is_open):
        ctx = self.btn_connector.get_style_context()
        if is_open:
            if not ctx.has_class("active-connector"):
                ctx.add_class("active-connector")
            self.lbl_conn.set_markup("<span size='medium' color='#ffffff'>🔌</span>")
        else:
            if ctx.has_class("active-connector"):
                ctx.remove_class("active-connector")
            self.lbl_conn.set_markup("<span size='medium' color='#00f2fe'>🔌</span>")

    def sync_active_states(self):
        v_flag = os.path.exists(VOICE_FLAG_FILE)
        if v_flag != self.is_voice_active:
            self.is_voice_active = v_flag
            self.update_voice_ui()

        if getattr(self, "is_checking_active", False):
            return
        self.is_checking_active = True

        def _bg_check():
            try:
                is_voice_mode_on = os.path.exists(VOICE_FLAG_FILE)
                GLib.idle_add(self.update_reactor_ui, is_voice_mode_on)

                has_conn = False
                try:
                    res = subprocess.run(["wmctrl", "-l"], capture_output=True, text=True, timeout=0.4)
                    for line in res.stdout.splitlines():
                        if "MrFlow Router" in line or "MrFlow Connector" in line:
                            has_conn = True
                            break
                except Exception:
                    pass
                GLib.idle_add(self.update_connector_ui, has_conn)
            finally:
                self.is_checking_active = False

        threading.Thread(target=_bg_check, daemon=True).start()

    def on_entry_changed(self, entry):
        try:
            text = entry.get_text()
            stripped = text.strip()
            ctx = self.btn_send.get_style_context()
            if stripped or self.current_attachment:
                if not ctx.has_class("active-send"):
                    ctx.add_class("active-send")
                self.lbl_send.set_markup("<span size='medium' color='#ffffff'>➤</span>")
            else:
                if ctx.has_class("active-send"):
                    ctx.remove_class("active-send")
                self.lbl_send.set_markup("<span size='medium' color='#00ff66'>➤</span>")

            # Slash Commands trigger check (supported at start, middle, or end of prompt)
            pos = -1
            if hasattr(entry, "get_position"):
                try:
                    pos = entry.get_position()
                except Exception:
                    pos = -1
            text_before_cursor = text[:pos] if pos >= 0 else text
            slash_match = re.search(r'(?:^|\s)(/[a-zA-Z0-9_\-]*)$', text_before_cursor)
            if slash_match:
                query = slash_match.group(1)
                self.show_slash_popover(query)
            else:
                if self.slash_popover.get_visible():
                    self.slash_popover.hide()
        except Exception:
            pass

    def show_slash_popover(self, query):
        self.slash_popover.update_filter(query)
        # Position popover directly above the entry field
        pop_w = self.slash_popover.width
        screen = self.get_screen()
        sw = screen.get_width()
        _, cur_y = self.get_position()
        if cur_y <= 0:
            cur_y = self.pos_y
        pop_x = (sw - pop_w) // 2
        pop_y = cur_y - pop_h - 12
        self.slash_popover.move(pop_x, pop_y)
        self.slash_popover.show_all()

    def on_animation_tick(self):
        self.pulse_phase += 0.08
        if self.pulse_phase > 10000.0:
            self.pulse_phase = 0.0
        if hasattr(self, "companion"):
            self.companion.on_tick(0.05)
        if hasattr(self, "matrix_console") and self.matrix_console.get_visible():
            self.matrix_console.on_tick(0.05)
        self.queue_draw()
        return True

    def on_draw(self, widget, cr):
        if getattr(self, "is_collapsed", False):
            alloc = widget.get_allocation()
            w, h = float(alloc.width), float(alloc.height)
            cr.set_operator(cairo.OPERATOR_CLEAR)
            cr.paint()
            cr.set_operator(cairo.OPERATOR_OVER)

            radius = h / 2.0
            self.draw_rounded_pill(cr, 1.0, 1.0, w - 2.0, h - 2.0, radius)
            cr.set_source_rgba(0.012, 0.024, 0.038, 0.94)
            cr.fill_preserve()

            ar, ag, ab = self.accent_rgb
            cr.set_source_rgba(ar, ag, ab, 0.85)
            cr.set_line_width(1.3)
            cr.stroke()
            return False

        alloc = widget.get_allocation()
        win_w = float(alloc.width)
        win_h = float(alloc.height)

        px = float(getattr(self, "pad_x", 14))
        py = float(getattr(self, "pad_y", 4)) + float(getattr(self, "handle_h", 18))
        bh = float(getattr(self, "bar_h", 50))
        bw = max(100.0, win_w - 2.0 * px)
        radius = bh / 2.0
        ar, ag, ab = self.accent_rgb
        sr, sg, sb = self.sec_rgb

        cr.set_operator(cairo.OPERATOR_CLEAR)
        cr.paint()
        cr.set_operator(cairo.OPERATOR_OVER)

        # 1. Outer Voice Halo (Zero clipping, comfortably inside canvas margins)
        if self.is_voice_active:
            halo_pad = 3.5
            halo_alpha = 0.55 + 0.35 * math.sin(self.pulse_phase * 2.5)
            cr.set_source_rgba(0.0, 0.95, 1.0, halo_alpha)
            cr.set_line_width(2.0)
            self.draw_rounded_pill(cr, px - halo_pad, py - halo_pad, bw + 2.0 * halo_pad, bh + 2.0 * halo_pad, radius + halo_pad)
            cr.stroke()

        # 2. Main Obsidian Glass Capsule Body
        self.draw_rounded_pill(cr, px, py, bw, bh, radius)
        cr.set_source_rgba(0.012, 0.024, 0.038, 0.88)
        cr.fill_preserve()

        # Ambient Subtle Matrix Glow
        pulse_alpha = 0.08 + 0.03 * math.sin(self.pulse_phase)
        glow_grad = cairo.LinearGradient(px, py, px + bw, py + bh)
        glow_grad.add_color_stop_rgba(0.0, ar, ag, ab, pulse_alpha)
        glow_grad.add_color_stop_rgba(0.5, sr, sg, sb, pulse_alpha * 0.5)
        glow_grad.add_color_stop_rgba(1.0, 0.0, 0.0, 0.0, 0.40)
        cr.set_source(glow_grad)
        cr.fill_preserve()

        # 3. Specular Optical Crystal Rim (Pure White Apex with Neon Matrix Green/Cyan Rim)
        rim_grad = cairo.LinearGradient(px, py, px, py + bh)
        rim_grad.add_color_stop_rgba(0.0, 1.0, 1.0, 1.0, 0.90)
        rim_grad.add_color_stop_rgba(0.35, ar, ag, ab, 0.40)
        rim_grad.add_color_stop_rgba(1.0, ar, ag, ab, 0.80)
        cr.set_source(rim_grad)
        cr.set_line_width(1.3)
        cr.stroke()

        return False

    def on_draw_overlay(self, widget, cr):
        return False

    def draw_rounded_pill(self, cr, x, y, width, height, radius):
        cr.new_sub_path()
        cr.arc(x + width - radius, y + radius, radius, -math.pi / 2, 0)
        cr.arc(x + width - radius, y + height - radius, radius, 0, math.pi / 2)
        cr.arc(x + radius, y + height - radius, radius, math.pi / 2, math.pi)
        cr.arc(x + radius, y + radius, radius, math.pi, 3 * math.pi / 2)
        cr.close_path()

    def send_socket_command(self, action, extra=None):
        try:
            if os.path.exists(SOCKET_PATH):
                client = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
                client.settimeout(2.5)
                client.connect(SOCKET_PATH)
                payload = {"action": action}
                if extra and isinstance(extra, dict):
                    payload.update(extra)
                client.sendall(json.dumps(payload).encode("utf-8"))
                res = client.recv(1024)
                client.close()
                return True
        except Exception:
            pass
        return False

    def _format_natural_vocal_reason(self, t_name, reason_raw, params):
        now = time.time()
        elapsed = now - getattr(self, "_last_vocal_time", 0.0)

        # 1. Fallback if reason is completely missing or generic
        if not reason_raw or not str(reason_raw).strip():
            reason_raw = params.get("goal") or ""

        t_low = (t_name or "").lower()
        text = str(reason_raw).strip() if reason_raw else ""

        if not text:
            if any(k in t_low for k in ["read", "view", "cat", "inspect", "grep"]):
                text = "Hmm, coba kita intip kodenya bentar..."
            elif any(k in t_low for k in ["replace", "edit", "write", "patch"]):
                text = "Langsung kita pasang perubahannya..."
            elif any(k in t_low for k in ["run", "command", "bash", "exec"]):
                text = "Eksekusi perintahnya sekarang..."
            elif any(k in t_low for k in ["search", "web", "find"]):
                text = "Telusuri referensinya dulu..."
            else:
                text = f"Lanjut proses {t_name.replace('_', ' ')}..."

        # 2. Anti-Kaset Rusak / Monotony Softener
        stiff_patterns = [
            (r'^(gue|gw|saya)\s+cek\s+', 'Hmm, coba intip '),
            (r'^(gue|gw|saya)\s+mau\s+cek\s+', 'Bentar, intip '),
            (r'^(gue|gw|saya)\s+coba\s+cek\s+', 'Coba telusuri '),
            (r'^(gue|gw|saya)\s+periksa\s+', 'Telusuri '),
            (r'^(gue|gw|saya)\s+mau\s+periksa\s+', 'Intip '),
            (r'^(gue|gw|saya)\s+lihat\s+', 'Tengok '),
            (r'^(gue|gw|saya)\s+buka\s+', 'Tarik isi '),
            (r'^(gue|gw|saya)\s+jalankan\s+', 'Eksekusi '),
            (r'^(gue|gw|saya)\s+akan\s+', 'Langsung kita '),
        ]
        for pat, repl in stiff_patterns:
            if re.search(pat, text, flags=re.IGNORECASE):
                text = re.sub(pat, repl, text, count=1, flags=re.IGNORECASE)
                break

        # 3. Clean up non-Latin scripts (Hanzi/Kanji/Cyrillic), weird symbols, markdown, and backticks
        text = re.sub(r'[\u4e00-\u9fff\u3040-\u30ff\uac00-\ud7af\u0400-\u04ff\u0600-\u06ff]', ' ', text)
        text = re.sub(r'[\u2500-\u257f\u2580-\u259f\u2600-\u26ff\u2700-\u27bf\U0001f300-\U0001f9ff\u2022\u25cf\u25c6\u25ca\u2713\u2714\u2716\u2718\u2794\u27a4\u27a2\u2192\u2190\u2191\u2193]', ' ', text)
        text = re.sub(r'```.*?```', '', text, flags=re.DOTALL)
        text = re.sub(r'[*_#`~|<>\[\]\(\)\{\}\\]', ' ', text)
        text = re.sub(r'\s+', ' ', text).strip()

        # If text became empty after stripping foreign scripts/symbols, provide a clean natural fallback
        if not text or len(text) < 3:
            if any(k in t_low for k in ["read", "view", "cat", "inspect", "grep"]):
                text = "Hmm, coba kita intip kodenya bentar..."
            elif any(k in t_low for k in ["replace", "edit", "write", "patch"]):
                text = "Langsung kita pasang perubahannya..."
            elif any(k in t_low for k in ["run", "command", "bash", "exec"]):
                text = "Eksekusi perintahnya sekarang..."
            else:
                text = f"Lanjut proses {t_name.replace('_', ' ')}..."

        # 4. Anti-Repetition & Cadence Guard
        last_phrase = getattr(self, "_last_vocal_phrase", "")
        if text.lower() == last_phrase.lower() and elapsed < 10.0:
            return None

        # Rapid chaining awareness:
        if elapsed < 2.5:
            self._tool_chain_count = getattr(self, "_tool_chain_count", 0) + 1
            if self._tool_chain_count > 1:
                # In rapid succession, suppress overlapping voice
                return None
            else:
                text = re.sub(r'^(hmm,\s*|bentar,\s*|oke,\s*)', 'Lanjut, ', text, flags=re.IGNORECASE)
        else:
            self._tool_chain_count = 1

        self._last_vocal_phrase = text
        self._last_vocal_time = now
        return text[:140]

    def send_to_mrflow(self, text, attachment_override=None):
        raw_prompt = text.strip()
        attachment = attachment_override if attachment_override is not None else self.current_attachment
        if not raw_prompt and not attachment:
            return

        final_prompt = raw_prompt

        # 1. Process slash command directive mapping (start, middle, or end of prompt)
        parsed_cmd = None
        cmd_args = final_prompt

        # Search for candidate slash command tokens
        matches = list(re.finditer(r'(?:^|\s)/([a-zA-Z0-9_\-]+)(?=\s|$|[.,!?;:])', final_prompt))
        for m in matches:
            cand = m.group(1).lower()
            if cand in NATIVE_SLASH_DIRECTIVES or any(sk["command"].lower() == cand or sk["skill"].lower() == cand for sk in self.skills_cache):
                parsed_cmd = cand
                span = m.span()
                matched_str = final_prompt[span[0]:span[1]]
                slash_idx = matched_str.find('/')
                actual_start = span[0] + slash_idx
                actual_end = span[1]
                args = (final_prompt[:actual_start] + " " + final_prompt[actual_end:]).strip()
                cmd_args = re.sub(r'\s+', ' ', args)
                break

        # Fallback: prompt starts with /command
        if not parsed_cmd and final_prompt.startswith("/"):
            parts = final_prompt.split(None, 1)
            raw_first = parts[0].lstrip("/")
            if "/" not in raw_first and raw_first:
                parsed_cmd = raw_first.lower()
                cmd_args = parts[1].strip() if len(parts) > 1 else ""

        if parsed_cmd:
            raw_cmd = parsed_cmd
            target_skill = None
            for sk in self.skills_cache:
                if sk["command"].lower() == raw_cmd or sk["skill"].lower() == raw_cmd:
                    target_skill = sk["skill"]
                    break

            if raw_cmd in NATIVE_SLASH_DIRECTIVES:
                directive = NATIVE_SLASH_DIRECTIVES[raw_cmd]
                if cmd_args:
                    final_prompt = f"{directive}Task instructions/arguments:\n{cmd_args}"
                else:
                    final_prompt = f"{directive}Execute the standard autonomous workflow for /{raw_cmd}."
            elif target_skill:
                skill_dir = os.path.join(SKILLS_DIR, target_skill)
                skill_sop = os.path.join(skill_dir, "SKILL.md")
                directive = (
                    f'[SYSTEM DIRECTIVE: User invoked slash command "/{raw_cmd}" mapped to Sovereign Skill "{target_skill}". '
                    f'You MUST view the skill SOP via view_file with AbsolutePath="{skill_sop}" and execute the operational instructions defined within.]\n\n'
                )
                if cmd_args:
                    final_prompt = f"{directive}User instructions:\n{cmd_args}"
                else:
                    final_prompt = f"{directive}Execute the sovereign skill workflow."

        # 2. Attach screenshot or file directive
        if attachment:
            att_path = attachment["path"]
            kb = attachment["size_kb"]
            if attachment["type"] == "image":
                final_prompt = (
                    f'[User Attached Screenshot: {att_path} ({kb} KB)]\n'
                    f'SYSTEM DIRECTIVE: The user has attached a screenshot at "{att_path}". '
                    f'You MUST execute view_file with AbsolutePath="{att_path}" to visually inspect the image before answering.\n\n'
                    f'User Instruction/Question:\n{final_prompt}'
                )
            else:
                final_prompt = (
                    f'[User Attached File: {att_path} ({kb} KB)]\n'
                    f'SYSTEM DIRECTIVE: The user has attached file "{att_path}". Inspect it if relevant.\n\n'
                    f'User Instruction/Question:\n{final_prompt}'
                )

        if hasattr(self, "companion"):
            GLib.idle_add(lambda: self.companion.set_state("thinking"))

        # 1. Immediately trigger thinking state in shared memory so Desktop HUD animates with 0ms lag
        try:
            flowork_neural_bridge.set_neural_state("thinking", action="Menganalisis instruksi & merumuskan strategi...", status="running")
        except Exception:
            pass

        self.active_turn_id = getattr(self, "active_turn_id", 0) + 1
        my_turn_id = self.active_turn_id

        def _worker():
            try:
                # Auto-resume latest session if active_session_id is not set and not explicitly starting new chat
                if not getattr(self, "active_session_id", None) and not getattr(self, "_explicit_new_chat", False):
                    latest = self.discover_latest_session()
                    if latest and latest.get("session_id"):
                        self.active_session_id = latest["session_id"]
                        self.active_session_title = latest.get("title")
                        self.active_session_file = latest.get("file_path")
                        self.save_session_anchor(
                            session_id=latest["session_id"],
                            title=latest.get("title"),
                            turns=latest.get("turns", 1),
                            file_path=latest.get("file_path"),
                            last_prompt=latest.get("last_prompt", ""),
                            last_response=latest.get("last_response", "")
                        )
                self._explicit_new_chat = False

                # 2. Run mrflow CLI directly in streaming mode
                cmd = ["/opt/floworkos/bin/mrflow"]
                session_file = getattr(self, "active_session_file", None)
                if session_file and os.path.isfile(session_file):
                    cmd.extend(["--session-file", str(session_file)])
                elif getattr(self, "active_session_id", None):
                    cmd.extend(["--resume", str(self.active_session_id)])
                cmd.extend(["-p", final_prompt, "-o", "stream-json", "--sovereign"])
                proc = subprocess.Popen(
                    cmd,
                    stdin=subprocess.PIPE,
                    stdout=subprocess.PIPE,
                    stderr=subprocess.PIPE,
                    text=True,
                    bufsize=1,
                    start_new_session=True,
                )
                if my_turn_id != getattr(self, "active_turn_id", 0):
                    try:
                        os.killpg(os.getpgid(proc.pid), signal.SIGTERM)
                    except Exception:
                        try:
                            proc.terminate()
                        except Exception:
                            pass
                    return
                self.active_agent_proc = proc

                # Heartbeat daemon thread to keep timestamp fresh so thinking/deliberation HUD never vanishes during execution
                is_proc_alive = [True]
                def _heartbeat():
                    while is_proc_alive[0]:
                        try:
                            st = flowork_neural_bridge.get_neural_state()
                            cur_st = st.get("state", "idle")
                            if cur_st in ("thinking", "deliberation", "tool_use"):
                                flowork_neural_bridge.set_neural_state(
                                    state=cur_st,
                                    tool_name=st.get("tool_name", ""),
                                    morphology=st.get("morphology", ""),
                                    action=st.get("action", ""),
                                    command=st.get("command", ""),
                                    args=st.get("args", {}),
                                    logs=st.get("logs", []),
                                    status="running" if cur_st != "deliberation" else "deliberating",
                                    exit_code=st.get("exit_code", 0),
                                    duration_ms=st.get("duration_ms", 0),
                                    reason=st.get("reason", "")
                                )
                        except Exception:
                            pass
                        time.sleep(2.0)
                hb_thread = threading.Thread(target=_heartbeat, daemon=True)
                hb_thread.start()

                accumulated_speech = []
                last_tool = ""
                is_tool_running = False

                for raw_line in proc.stdout:
                    line = raw_line.strip()
                    if not line:
                        continue
                    try:
                        ev = json.loads(line)
                    except Exception:
                        continue

                    e_type = ev.get("type")
                    if e_type == "init":
                        sid = ev.get("session_id")
                        if sid:
                            self.active_session_id = sid
                            self.save_session_anchor(
                                session_id=sid,
                                title=final_prompt.strip()[:45],
                                turns=1,
                                last_prompt=final_prompt
                            )

                    elif e_type == "error":
                        err_msg = ev.get("message", "")
                        if "session" in err_msg.lower() or "not found" in err_msg.lower():
                            self.active_session_id = None
                            self.clear_session_anchor()
                            if hasattr(self, "continuity_pill"):
                                GLib.idle_add(lambda: self.continuity_pill.hide())
                        print(f"[Conduit] Mr. Flow Error: {err_msg}", file=sys.stderr)

                    elif e_type == "tool_use":
                        is_tool_running = True
                        t_name = ev.get("tool_name", "")
                        last_tool = t_name
                        params = ev.get("parameters") or {}
                        reason = params.get("reason") or params.get("goal") or ""
                        cmd_str = params.get("command") or params.get("CommandLine") or ""

                        # Format vocal reason with anti-kaset rusak softener & chaining filter
                        vocal_phrase = self._format_natural_vocal_reason(t_name, reason, params)
                        display_action = vocal_phrase or reason or f"Processing {t_name.replace('_', ' ')}..."

                        # 1. Update shared neural state in RAM (/dev/shm) for Live Desktop HUD
                        try:
                            flowork_neural_bridge.set_neural_state(
                                state="tool_use",
                                tool_name=t_name,
                                action=display_action,
                                command=cmd_str,
                                status="running",
                                args=params,
                                reason=reason
                            )
                        except Exception:
                            pass

                        # 2. Pre-Tool Vocalization: Natural Voice Reason (Option A)
                        if (self.is_voice_active or os.path.exists(VOICE_FLAG_FILE)) and vocal_phrase:
                            clean_vocal = vocal_phrase.strip()
                            if clean_vocal and len(clean_vocal) >= 3:
                                v_words = set(re.findall(r'\b[a-zA-Z]+\b', clean_vocal.lower()))
                                v_en = {'the', 'is', 'are', 'this', 'that', 'with', 'from', 'have', 'has', 'will', 'you'}
                                v_id = {'halo', 'hai', 'ini', 'dan', 'di', 'ke', 'dari', 'yang', 'untuk', 'saya', 'aku', 'gue', 'gw', 'bisa', 'siap', 'bos', 'tidak', 'nggak', 'ada', 'itu', 'apa', 'kenapa', 'bro', 'lu', 'dong', 'nih', 'bentar', 'tengok', 'intip', 'lanjut'}
                                v_lang = "en" if (v_words & v_en) and not (v_words & v_id) else "id"
                                subprocess.Popen(
                                    ["/opt/floworkos/bin/flowork-say", "--lang", v_lang, clean_vocal[:180]],
                                    stdout=subprocess.DEVNULL,
                                    stderr=subprocess.DEVNULL
                                )

                        if hasattr(self, "companion"):
                            GLib.idle_add(lambda tn=t_name: (
                                self.companion.set_state("tool", tn),
                                self.companion.play_sound_for_state(self.companion.map_tool_to_state(tn))
                            ))

                    elif e_type == "tool_result":
                        is_tool_running = False
                        out_str = ev.get("output", "")
                        st = ev.get("status", "success")
                        ec = 0 if st == "success" else 1
                        logs = [l.strip() for l in str(out_str).splitlines() if l.strip()][-6:]

                        # Transitional deliberation state so desktop theme animates during tool pause
                        try:
                            flowork_neural_bridge.set_neural_state(
                                state="deliberation",
                                tool_name=last_tool,
                                action="Hasil didapat. Merumuskan tindakan selanjutnya...",
                                status="deliberating",
                                exit_code=ec,
                                logs=logs
                            )
                        except Exception:
                            pass

                        if hasattr(self, "companion"):
                            GLib.idle_add(lambda c=ec: self.companion.set_state("success" if c == 0 else "thinking"))

                    elif e_type == "ask_user":
                        req_id = ev.get("id", "")
                        questions = ev.get("questions", [])
                        try:
                            pop_res = subprocess.run(
                                ["/opt/floworkos/bin/flowork-ask-popup", "--json", json.dumps({"questions": questions})],
                                capture_output=True,
                                text=True,
                            )
                            if pop_res.returncode == 0 and pop_res.stdout.strip():
                                ans_payload = json.loads(pop_res.stdout.strip())
                                answers = ans_payload.get("answers", {})
                            else:
                                answers = {"cancelled": True}
                        except Exception as pop_err:
                            answers = {"error": str(pop_err)}
                        if proc.stdin:
                            try:
                                resp_line = json.dumps({"type": "ask_user_response", "id": req_id, "answers": answers}) + "\n"
                                proc.stdin.write(resp_line)
                                proc.stdin.flush()
                            except Exception:
                                pass

                    elif e_type == "message":
                        role = ev.get("role", "assistant")
                        content = ev.get("content", "")
                        # Accumulate speech ONLY from assistant responses (filter out internal system notices)
                        if content and role != "system":
                            accumulated_speech.append(content)
                        # While model is generating message/looping without active tool, show thinking continuously!
                        if not is_tool_running:
                            try:
                                cur_st = flowork_neural_bridge.get_neural_state().get("state")
                                if cur_st != "thinking":
                                    flowork_neural_bridge.set_neural_state(
                                        state="thinking",
                                        action="Merumuskan jawaban komprehensif...",
                                        status="running"
                                    )
                            except Exception:
                                pass

                proc.wait()
                is_proc_alive[0] = False
                if self.active_agent_proc is proc:
                    self.active_agent_proc = None

                was_aborted = (my_turn_id != getattr(self, "active_turn_id", 0))
                if was_aborted:
                    return

                if proc.returncode != 0 and not accumulated_speech:
                    if proc.returncode not in (-signal.SIGTERM, -signal.SIGKILL, 143, 137):
                        # Session failure or crash: reset active session to prevent dead-lock
                        self.active_session_id = None

                # 3. Final voice vocalization & idle state
                full_reply = "".join(accumulated_speech).strip()
                if full_reply:
                    try:
                        flowork_neural_bridge.set_neural_state("speaking", morphology="morph-speech", amplitude=0.85, action="Menjawab...", status="running")
                    except Exception:
                        pass
                    # 3a. Desktop Presentation Stage (<present> or non-speech visual payload in Voice Mode)
                    try:
                        voice_on = bool(self.is_voice_active or os.path.exists(VOICE_FLAG_FILE))
                        present_matches = re.findall(r'<present(?:\s+title="([^"]*)")?>(.*?)</present>', full_reply, re.DOTALL)
                        present_title = "Mr. Flow Presentation"
                        present_body = ""
                        if present_matches:
                            present_title = (present_matches[0][0] or "Mr. Flow Presentation").strip()
                            present_body = "\n\n---\n\n".join(m[1].strip() for m in present_matches if m[1].strip())
                        elif voice_on:
                            non_speech = re.sub(r'<speech>.*?</speech>', '', full_reply, flags=re.DOTALL).strip()
                            has_visual = bool(
                                re.search(r'```|<svg|\|[^\n]+\|', non_speech, re.IGNORECASE)
                                or len(non_speech) >= 60
                            )
                            if has_visual and non_speech:
                                present_body = non_speech

                        if present_body:
                            import tempfile
                            with tempfile.NamedTemporaryFile("w", suffix=".md", prefix="flowork_present_", delete=False, encoding="utf-8") as tf:
                                tf.write(present_body)
                                tmp_present_path = tf.name
                            subprocess.Popen(
                                ["/opt/floworkos/bin/flowork-present", "--title", present_title, "--file", tmp_present_path],
                                stdout=subprocess.DEVNULL,
                                stderr=subprocess.DEVNULL,
                                start_new_session=True,
                            )
                    except Exception:
                        pass

                    speech_text = re.sub(r'<present(?:\s+title="[^"]*")?>.*?</present>', '', full_reply, flags=re.DOTALL).strip()
                    m = re.search(r'<speech>(.*?)</speech>', speech_text, re.DOTALL)
                    if m:
                        speech_text = m.group(1).strip()
                    else:
                        speech_text = re.sub(r'```.*?```', '', speech_text, flags=re.DOTALL)
                        speech_text = re.sub(r'[*_#`]', '', speech_text).strip()

                    # Strip markdown table rows so tables are rendered visually but NEVER spoken aloud
                    speech_text = re.sub(r'^[ \t]*\|.*?\|[ \t]*$', ' ', speech_text, flags=re.MULTILINE)

                    # RIGID SCRIPT & WEIRD SYMBOL SANITIZATION FOR TTS PURITY:
                    # 1. Strip Asian / non-Latin scripts (Hanzi, Kanji, Cyrillic, Hangul, Arabic)
                    speech_text = re.sub(r'[\u4e00-\u9fff\u3040-\u30ff\uac00-\ud7af\u0400-\u04ff\u0600-\u06ff]', ' ', speech_text)
                    # 2. Strip weird esoteric unicode symbols, dingbats, emojis, math glyphs, box drawings
                    speech_text = re.sub(r'[\u2500-\u257f\u2580-\u259f\u2600-\u26ff\u2700-\u27bf\U0001f300-\U0001f9ff\u2022\u25cf\u25c6\u25ca\u2713\u2714\u2716\u2718\u2794\u27a4\u27a2\u2192\u2190\u2191\u2193]', ' ', speech_text)
                    # 3. Clean remaining brackets, hashes, asterisks
                    speech_text = re.sub(r'[*_#`~|<>\[\]\(\)\{\}\\]', ' ', speech_text)
                    speech_text = re.sub(r'\s+', ' ', speech_text).strip()

                    # Only vocalize if voice mode is actively enabled and speech_text has substantive words
                    if speech_text and len(speech_text) >= 3 and (self.is_voice_active or os.path.exists(VOICE_FLAG_FILE)):
                        try:
                            words = set(re.findall(r'\b[a-zA-Z]+\b', speech_text.lower()))
                            en_markers = {'the', 'is', 'are', 'this', 'that', 'with', 'from', 'have', 'has', 'will', 'you'}
                            id_markers = {'halo', 'hai', 'ini', 'dan', 'di', 'ke', 'dari', 'yang', 'untuk', 'saya', 'aku', 'gue', 'gw', 'bisa', 'siap', 'bos', 'tidak', 'nggak', 'ada', 'itu', 'apa', 'kenapa', 'bro', 'lu', 'dong', 'nih'}
                            cmd_lang = "en" if (words & en_markers) and not (words & id_markers) else "id"
                            if words:
                                if len(speech_text) > 3500:
                                    cut = speech_text[:3500]
                                    last_punct = max(cut.rfind('.'), cut.rfind('!'), cut.rfind('?'), cut.rfind('\n'))
                                    speech_to_say = cut[:last_punct + 1] if last_punct > 1500 else cut
                                else:
                                    speech_to_say = speech_text
                                def _play_tts_bg(lang, txt):
                                    try:
                                        self.interrupt_tts()
                                        self.active_tts_proc = subprocess.Popen(["/opt/floworkos/bin/flowork-say", "--lang", lang, txt])
                                        try:
                                            self.active_tts_proc.wait(timeout=90)
                                        except subprocess.TimeoutExpired:
                                            self.interrupt_tts()
                                        finally:
                                            self.active_tts_proc = None
                                    except Exception:
                                        pass
                                threading.Thread(target=_play_tts_bg, args=(cmd_lang, speech_to_say), daemon=True).start()
                        except Exception:
                            pass
                # Turn completion handling:
                def _handle_turn_conclusion():
                    if my_turn_id != getattr(self, "active_turn_id", 0):
                        if self.active_agent_proc is None or self.active_agent_proc.poll() is not None:
                            self.is_agent_busy = False
                            self.set_send_button_state("send")
                        return False
                    if getattr(self, "active_session_id", None):
                        sess_file = self.find_session_file(self.active_session_id)
                        turn_cnt = self.get_session_turn_count(self.active_session_id)
                        title_cand = final_prompt.strip()[:45]
                        if hasattr(self, "active_session_title") and self.active_session_title:
                            title_cand = self.active_session_title
                        self.save_session_anchor(
                            session_id=self.active_session_id,
                            title=title_cand,
                            turns=turn_cnt,
                            file_path=sess_file,
                            last_prompt=final_prompt,
                            last_response=full_reply
                        )

                    if self.queued_messages:
                        next_msg = self.queued_messages.pop(0)
                        self.update_queued_banner()
                        print(f"[Conduit] Reactive auto-dequeue: dispatching '{next_msg['display_text']}'", flush=True)
                        self.send_to_mrflow(next_msg["text"], attachment_override=next_msg.get("attachment"))
                    else:
                        self.is_agent_busy = False
                        self.set_send_button_state("send")
                        self.update_queued_banner()
                        try:
                            flowork_neural_bridge.set_neural_state("idle", status="idle")
                        except Exception:
                            pass
                        if hasattr(self, "companion"):
                            self.companion.set_state("idle")
                    return False

                GLib.idle_add(_handle_turn_conclusion)

            except Exception as e:
                print(f"[Conduit] Error running Mr. Flow: {e}", file=sys.stderr)
                def _handle_error_cleanup():
                    if my_turn_id != getattr(self, "active_turn_id", 0):
                        if self.active_agent_proc is None or self.active_agent_proc.poll() is not None:
                            self.is_agent_busy = False
                            self.set_send_button_state("send")
                        return False
                    self.active_agent_proc = None
                    if self.queued_messages:
                        next_msg = self.queued_messages.pop(0)
                        self.update_queued_banner()
                        self.send_to_mrflow(next_msg["text"], attachment_override=next_msg.get("attachment"))
                    else:
                        self.is_agent_busy = False
                        self.set_send_button_state("send")
                        self.update_queued_banner()
                    return False
                GLib.idle_add(_handle_error_cleanup)

        threading.Thread(target=_worker, daemon=True).start()

    def on_entry_activate(self, widget):
        if hasattr(self, "quick_switcher") and self.quick_switcher.get_visible():
            self.quick_switcher.activate_current()
            return

        if self.slash_popover.get_visible():
            self.slash_popover.activate_current()
            return

        text = self.entry.get_text()
        att = self.current_attachment
        stripped = text.strip()

        # Intercept slash commands for new session
        if stripped in ("/new", "/newchat", "/clear", "/reset"):
            self.entry.set_text("")
            self.on_new_chat_clicked(None)
            return

        # Intercept slash commands for sessions / resume
        if stripped in ("/resume", "/sessions", "/history", "/switch") or stripped.startswith("/resume ") or stripped.startswith("/sessions "):
            self.entry.set_text("")
            f_q = stripped.split(maxsplit=1)[1] if " " in stripped else ""
            self.show_quick_session_switcher(filter_query=f_q)
            return

        # Intercept slash commands for Time-Machine undo / rollback
        if stripped in ("/undo", "/rollback") or stripped.startswith("/rollback "):
            self.entry.set_text("")
            target_id = stripped.split(maxsplit=1)[1] if " " in stripped else "HEAD~1"
            self.execute_timemachine_rollback(target_id)
            return

        # Intercept slash commands for Time-Machine snapshots timeline
        if stripped in ("/snapshots", "/timemachine"):
            self.entry.set_text("")
            self.show_timemachine_snapshots()
            return

        # Intercept slash command for full-duplex voice capture
        if stripped in ("/listen", "/voice", "/speak", "/mic"):
            self.entry.set_text("")
            self.start_voice_capture()
            return

        if not stripped and not att:
            return

        # Dismiss continuity pill if visible when prompt is sent
        if hasattr(self, "continuity_pill") and self.continuity_pill.get_visible():
            self.continuity_pill.hide()

        if self.is_agent_running():
            # Agent is BUSY: Queue message!
            self.queue_user_message(text, att)
            self.entry.set_text("")
            self.clear_attachment()
            self.status_text = "Message queued (sends after agent finishes working)"
            return

        # Agent is IDLE: Run immediately!
        if hasattr(self, "matrix_console") and self.matrix_console.get_visible():
            self.matrix_console.hide()
        subprocess.Popen(["flowork-say", "--stop"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        try:
            flowork_neural_bridge.set_neural_state("thinking", action="Menganalisis instruksi & merumuskan strategi...", status="running")
        except Exception:
            pass
        self.is_agent_busy = True
        self.set_send_button_state("stop")
        self.send_to_mrflow(text)
        self.entry.set_text("")
        self.clear_attachment()
        self.status_text = "Prompt sent to Mr. Flow"

    def on_entry_key_press(self, widget, event):
        # Keyboard handling for Quick Session Switcher Popover
        if hasattr(self, "quick_switcher") and self.quick_switcher.get_visible():
            if event.keyval == Gdk.KEY_Down:
                self.quick_switcher.select_next()
                return True
            elif event.keyval == Gdk.KEY_Up:
                self.quick_switcher.select_prev()
                return True
            elif event.keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter, Gdk.KEY_Tab):
                self.quick_switcher.activate_current()
                return True
            elif event.keyval == Gdk.KEY_Escape:
                self.quick_switcher.hide()
                return True
            elif Gdk.KEY_1 <= event.keyval <= Gdk.KEY_9:
                idx = event.keyval - Gdk.KEY_1
                self.quick_switcher.activate_index(idx)
                return True

        # Keyboard handling for Slash Commands Popover
        if self.slash_popover.get_visible():
            if event.keyval == Gdk.KEY_Down:
                self.slash_popover.select_next()
                return True
            elif event.keyval == Gdk.KEY_Up:
                self.slash_popover.select_prev()
                return True
            elif event.keyval in (Gdk.KEY_Tab, Gdk.KEY_ISO_Left_Tab, Gdk.KEY_Return, Gdk.KEY_KP_Enter):
                self.slash_popover.activate_current()
                return True
            elif event.keyval == Gdk.KEY_Escape:
                self.slash_popover.hide()
                return True

        # Multi-line Shift+Enter vs Enter to send
        if event.keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter):
            if event.state & Gdk.ModifierType.SHIFT_MASK:
                return False
            self.entry.emit_activate()
            return True

        # Keyboard Shortcut: Ctrl+N -> New Chat Session
        if (event.state & Gdk.ModifierType.CONTROL_MASK) and event.keyval in (Gdk.KEY_n, Gdk.KEY_N):
            self.on_new_chat_clicked(None)
            return True

        # Clipboard Paste image / file handler (Ctrl+V)
        if (event.state & Gdk.ModifierType.CONTROL_MASK) and event.keyval in (Gdk.KEY_v, Gdk.KEY_V):
            clip = Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD)
            if clip.wait_is_image_available():
                pixbuf = clip.wait_for_image()
                if pixbuf:
                    home = os.environ.get("HOME") or HOME
                    target_dir = os.path.join(home, "Pictures", "Screenshots")
                    os.makedirs(target_dir, exist_ok=True)
                    ts = time.strftime("%Y%m%d_%H%M%S")
                    dest_path = os.path.join(target_dir, f"User_Pasted_{ts}.png")
                    pixbuf.savev(dest_path, "png", [], [])
                    self.set_attachment(dest_path, "image")
                    return True
            if clip.wait_is_text_available():
                txt = clip.wait_for_text().strip()
                clean_path = txt.replace("file://", "").strip()
                if os.path.isfile(clean_path):
                    self.set_attachment(clean_path)
                    return True

        if event.keyval == Gdk.KEY_Escape:
            if hasattr(self, "continuity_pill") and self.continuity_pill.get_visible() and not self.entry.get_text().strip():
                self.on_dismiss_continuity()
                return True
            if self.is_agent_running():
                # Escape key interrupts running agent cleanly!
                self.stop_active_agent()
                return True
            if hasattr(self, "matrix_console") and self.matrix_console.get_visible():
                self.matrix_console.user_dismissed = True
                self.matrix_console.hide()
            subprocess.Popen(["flowork-say", "--stop"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            if not self.entry.get_text().strip() and not self.current_attachment:
                self.collapse_conduit()
                return True
            self.entry.set_text("")
            self.clear_attachment()
            return True
            self.set_send_button_state("send")
            return True
        return False

    def on_send_clicked(self, widget):
        if self.is_agent_running():
            text = self.entry.get_text()
            att = self.current_attachment
            if not text.strip() and not att:
                # User clicked Stop button!
                self.stop_active_agent()
                return
            else:
                # User typed something and pressed Send: Queue it!
                self.queue_user_message(text, att)
                self.entry.set_text("")
                self.clear_attachment()
                return
        self.on_entry_activate(self.entry)

    def on_reactor_clicked(self, widget):
        voice_flag = f"/run/user/{os.getuid()}/flowork-voice-mode.enabled"
        is_on = os.path.exists(voice_flag)
        if is_on:
            try: os.remove(voice_flag)
            except: pass
            self.update_reactor_ui(False)
            subprocess.Popen(["/opt/floworkos/bin/flowork-sound-forge", "play", "pop"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        else:
            try:
                with open(voice_flag, "w") as f: f.write("1")
            except: pass
            self.update_reactor_ui(True)
            subprocess.Popen(["/opt/floworkos/bin/flowork-sound-forge", "play", "chime_run"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def on_connector_clicked(self, widget):
        ctx = self.btn_connector.get_style_context()
        ctx.add_class("active-connector")
        GLib.timeout_add(1500, lambda: self.sync_active_states() or False)
        def _open_conn():
            try:
                res = subprocess.run(["wmctrl", "-l"], capture_output=True, text=True)
                for line in res.stdout.splitlines():
                    if "MrFlow Router" in line or "MrFlow Connector" in line:
                        win_id = line.split()[0]
                        subprocess.run(["wmctrl", "-ia", win_id])
                        return
            except Exception:
                pass
            if os.path.exists(CONNECTOR_SCRIPT):
                subprocess.Popen(["/usr/bin/python3", CONNECTOR_SCRIPT])
        threading.Thread(target=_open_conn, daemon=True).start()

    def on_toggle_history_vault(self, widget=None):
        if hasattr(self, "history_vault"):
            self.history_vault.toggle_vault()
            subprocess.Popen(["flowork-sound-forge", "play", "pop"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def on_history_clicked(self, widget=None):
        if hasattr(self, "btn_history"):
            ctx = self.btn_history.get_style_context()
            ctx.add_class("active-history")
            GLib.timeout_add(700, lambda: ctx.remove_class("active-history") or False)
        self.on_toggle_history_vault(widget)

    def find_session_file(self, session_id):
        if not session_id:
            return None
        sid = str(session_id)
        short8 = sid[:8]
        home = os.path.expanduser("~")
        search_dirs = [
            f"{home}/.flowork/history/chats/*/*.jsonl",
            "/opt/floworkos/history/chats/*/*.jsonl",
            f"{home}/.gemini/antigravity/brain/{sid}/.system_generated/logs/transcript.jsonl"
        ]
        for pattern in search_dirs:
            for fpath in glob.glob(pattern):
                if sid in fpath or short8 in fpath:
                    return fpath
                try:
                    with open(fpath, "r", encoding="utf-8", errors="ignore") as f:
                        first_line = f.readline()
                        if sid in first_line:
                            return fpath
                except Exception:
                    pass
        return None

    def get_session_turn_count(self, session_id):
        fpath = self.find_session_file(session_id)
        if not fpath:
            return 1
        count = 0
        try:
            sz = os.path.getsize(fpath)
            with open(fpath, "rb") as fb:
                if sz > 524288:
                    fb.seek(sz - 524288)
                    fb.readline()
                    count = max(1, sz // 65536)
                for raw_line in fb:
                    if len(raw_line) > 32768:
                        continue
                    if b'"type":"user"' in raw_line or b'"type": "user"' in raw_line or b'"USER_INPUT"' in raw_line:
                        count += 1
        except Exception:
            pass
        return max(1, count)

    def save_session_anchor(self, session_id, title=None, turns=1, file_path=None, last_prompt="", last_response=""):
        if not session_id:
            return
        try:
            os.makedirs(os.path.dirname(SESSION_STATE_FILE), exist_ok=True)
            anchor = {
                "session_id": str(session_id),
                "title": str(title or f"Session {str(session_id)[:8]}"),
                "turns": int(turns or 1),
                "file_path": str(file_path or self.find_session_file(session_id) or ""),
                "last_prompt": str(last_prompt or ""),
                "last_response": str(last_response or "")[:5000],
                "timestamp": time.time()
            }
            tmp = f"{SESSION_STATE_FILE}.tmp.{os.getpid()}"
            with open(tmp, "w", encoding="utf-8") as f:
                json.dump(anchor, f, indent=2, ensure_ascii=False)
            os.replace(tmp, SESSION_STATE_FILE)
            self.active_session_title = anchor["title"]
        except Exception as e:
            print(f"[Conduit] Error saving session anchor: {e}", file=sys.stderr)

    def load_session_anchor(self):
        if not os.path.exists(SESSION_STATE_FILE):
            return None
        try:
            with open(SESSION_STATE_FILE, "r", encoding="utf-8", errors="ignore") as f:
                data = json.load(f)
            sid = data.get("session_id")
            if not sid:
                return None
            ts = data.get("timestamp", 0)
            if time.time() - ts > 7 * 86400:
                return None
            fpath = data.get("file_path")
            if not fpath or not os.path.exists(fpath):
                found = self.find_session_file(sid)
                if found:
                    data["file_path"] = found
                else:
                    return None
            return data
        except Exception as e:
            print(f"[Conduit] Error loading session anchor: {e}", file=sys.stderr)
            return None

    def clear_session_anchor(self):
        try:
            if os.path.exists(SESSION_STATE_FILE):
                os.remove(SESSION_STATE_FILE)
        except Exception:
            pass

    def discover_latest_session(self):
        home = os.path.expanduser("~")
        candidates = []
        patterns = [
            f"{home}/.flowork/history/chats/*/*.jsonl",
            "/opt/floworkos/history/chats/*/*.jsonl",
            f"{home}/.gemini/antigravity/brain/*/.system_generated/logs/transcript.jsonl",
        ]
        for pat in patterns:
            for fpath in glob.glob(pat):
                try:
                    st = os.stat(fpath)
                    candidates.append((st.st_mtime, fpath))
                except Exception:
                    pass
        if not candidates:
            return None
        candidates.sort(key=lambda x: x[0], reverse=True)
        for _, fpath in candidates:
            try:
                sid = ""
                if "antigravity/brain/" in fpath:
                    parts = fpath.split("/brain/")
                    if len(parts) > 1:
                        sid = parts[1].split("/")[0]
                else:
                    fname = os.path.basename(fpath).replace(".jsonl", "")
                    if fname.startswith("session-"):
                        sid = fname[8:]
                    else:
                        sid = fname
                if not sid:
                    continue

                title = ""
                turns = 0
                last_p = ""
                last_r = ""
                sid_from_header = None
                def _scan_latest(lines_iter):
                    nonlocal turns, last_p, last_r, title, sid_from_header
                    for raw_line in lines_iter:
                        if not raw_line.strip():
                            continue
                        if len(raw_line) > 32768 or b'"preservedTail"' in raw_line or b'"newTokenCount"' in raw_line or b'"compression_snapshot"' in raw_line:
                            continue
                        line = raw_line.decode("utf-8", errors="ignore") if isinstance(raw_line, bytes) else raw_line
                        try:
                            obj = json.loads(line)
                            if not sid_from_header and obj.get("sessionId"):
                                sid_from_header = str(obj["sessionId"])
                            role = obj.get("role") or obj.get("type") or obj.get("source")
                            content = obj.get("content") or obj.get("text") or ""
                            if role in ("user", "USER_INPUT", "USER", "USER_EXPLICIT"):
                                cand_p = ""
                                if isinstance(content, list):
                                    for part in content:
                                        if isinstance(part, dict) and "text" in part:
                                            cand_p += part["text"]
                                elif isinstance(content, str):
                                    cand_p = content
                                clean = clean_history_user_text(cand_p)
                                if clean:
                                    turns += 1
                                    last_p = clean
                                    if not title:
                                        title = clean[:58]
                            elif role in ("assistant", "model", "gemini", "MODEL"):
                                if isinstance(content, list):
                                    for part in content:
                                        if isinstance(part, dict) and "text" in part:
                                            last_r = part["text"]
                                elif isinstance(content, str):
                                    last_r = content
                        except Exception:
                            pass

                sz = os.path.getsize(fpath)
                with open(fpath, "rb") as fb:
                    if sz <= 524288:
                        _scan_latest(fb)
                    else:
                        _scan_latest(fb.read(65536).splitlines())
                        fb.seek(max(0, sz - 131072))
                        fb.readline()
                        _scan_latest(fb)
                        turns = max(turns, max(1, sz // 65536))
                if sid_from_header:
                    sid = sid_from_header
                if not title:
                    title = f"Chat {sid[:10]}"
                return {
                    "session_id": sid,
                    "title": title,
                    "turns": max(1, turns),
                    "file_path": fpath,
                    "last_prompt": last_p,
                    "last_response": last_r[:5000] if last_r else "",
                    "timestamp": candidates[0][0]
                }
            except Exception:
                continue
        return None

    def check_boot_continuity(self):
        anchor = self.load_session_anchor()
        if not anchor or not anchor.get("session_id"):
            anchor = self.discover_latest_session()
            if anchor and anchor.get("session_id"):
                self.save_session_anchor(
                    session_id=anchor["session_id"],
                    title=anchor.get("title"),
                    turns=anchor.get("turns", 1),
                    file_path=anchor.get("file_path"),
                    last_prompt=anchor.get("last_prompt", ""),
                    last_response=anchor.get("last_response", "")
                )

        if anchor and anchor.get("session_id"):
            sid = anchor["session_id"]
            title = anchor.get("title", f"Session {sid[:8]}")
            self.active_session_id = sid
            self.active_session_title = title
            if hasattr(self, "runner"):
                self.runner.current_session_id = sid
            self.status_text = f"Resumed: {title[:32]}..."
            self.entry.set_placeholder_text(f"Resume: \"{title[:28]}\" (type prompt or ✕ new)")
            if hasattr(self, "matrix_console"):
                last_p = anchor.get("last_prompt", "")
                last_r = anchor.get("last_response", "")
                if last_p or last_r:
                    self.matrix_console.rehydrate(last_p, last_r, title=title)
            if hasattr(self, "continuity_pill"):
                GLib.idle_add(lambda: self.continuity_pill.update_anchor(anchor))

    def on_dismiss_continuity(self):
        self._explicit_new_chat = True
        self.clear_session_anchor()
        self.active_session_id = None
        self.active_session_title = None
        if hasattr(self, "runner"):
            self.runner.current_session_id = None
        if hasattr(self, "continuity_pill"):
            self.continuity_pill.hide()
        if hasattr(self, "matrix_console"):
            self.matrix_console.reset_chat()
        self.entry.set_placeholder_text("Ask Mr. Flow anything, or type / for skills...")
        self.status_text = "Fresh session started"
        subprocess.Popen(["flowork-sound-forge", "play", "laser"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        self.queue_draw()

    def show_quick_session_switcher(self, filter_query=""):
        if hasattr(self, "continuity_pill") and self.continuity_pill.get_visible():
            self.continuity_pill.hide()
        if hasattr(self, "quick_switcher"):
            self.quick_switcher.show_switcher(filter_query=filter_query)

    def resume_session(self, session_id, title=None, file_path=None, show_console=False):
        self.active_session_id = session_id
        self.active_session_file = file_path
        if hasattr(self, "runner"):
            self.runner.current_session_id = session_id

        if not file_path or not os.path.exists(file_path):
            file_path = self.find_session_file(session_id)
            if file_path:
                self.active_session_file = file_path

        turns = 0
        last_prompt = ""
        last_response = ""

        if file_path and os.path.exists(file_path) and hasattr(self, "history_vault"):
            try:
                msgs = self.history_vault.parse_messages(file_path)
                user_msgs = [m for m in msgs if m.get("role") == "user"]
                asst_msgs = [m for m in msgs if m.get("role") == "assistant"]
                turns = len(user_msgs)
                if user_msgs:
                    last_prompt = user_msgs[-1].get("text", "")
                    if not title and user_msgs[0].get("text"):
                        title = user_msgs[0].get("text")[:45]
                if asst_msgs:
                    last_response = asst_msgs[-1].get("text", "")

                if hasattr(self, "matrix_console"):
                    self.matrix_console.rehydrate(last_prompt, last_response, title=title)
                    if show_console:
                        self.matrix_console.show_all()
                        self.matrix_console.present()
            except Exception as e:
                print(f"[Conduit] Error rehydrating session: {e}", file=sys.stderr)

        if not title:
            title = f"Session {session_id[:8]}"
        self.active_session_title = title

        self.status_text = f"Resumed: {title[:32]}..."
        self.entry.set_placeholder_text(f"Resume: \"{title[:32]}\" (type prompt...)")
        self.entry.grab_focus()

        self.save_session_anchor(
            session_id=session_id,
            title=title,
            turns=turns,
            file_path=file_path,
            last_prompt=last_prompt,
            last_response=last_response
        )

        if hasattr(self, "continuity_pill"):
            self.continuity_pill.update_anchor(self.load_session_anchor())

        subprocess.Popen(["flowork-sound-forge", "play", "pop"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        self.queue_draw()

    def execute_timemachine_rollback(self, target_id="HEAD~1"):
        self.status_text = f"Time-Machine: Rolling back ({target_id})..."
        def _worker():
            try:
                cmd = ["/opt/floworkos/bin/flowork-timemachine", "rollback", target_id]
                if self.active_session_id:
                    cmd.extend(["-s", self.active_session_id])
                res = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=12)
                if res.returncode == 0:
                    out = res.stdout.strip()
                    subprocess.Popen(["flowork-sound-forge", "play", "chime_run"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                    msg = (
                        "⏪ **[ FLOWORK TIME-MACHINE ROLLBACK SUCCESSFUL ]**\n\n"
                        f"{out}\n\n"
                        "> [!TIP]\n"
                        "> Workspace filesystem state has been restored to snapshot. You can continue execution or inspect files."
                    )
                    def _present_rollback():
                        self.matrix_console.rehydrate(
                            user_prompt=f"/rollback {target_id}",
                            assistant_text=msg,
                            title="Time-Machine Rollback"
                        )
                        self.matrix_console.update_position()
                        self.matrix_console.set_keep_above(True)
                        self.matrix_console.show_all()
                        self.matrix_console.present()
                    GLib.idle_add(_present_rollback)
                    self.status_text = f"Time-Machine: Rolled back ({target_id})"
                else:
                    err = res.stderr.strip() or "Rollback error or no prior snapshot"
                    subprocess.Popen(["flowork-sound-forge", "play", "pop"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                    msg = f"❌ **[ TIME-MACHINE ROLLBACK FAILED ]**\n\n{err}"
                    def _present_err():
                        self.matrix_console.rehydrate(
                            user_prompt=f"/rollback {target_id}",
                            assistant_text=msg,
                            title="Rollback Failed"
                        )
                        self.matrix_console.update_position()
                        self.matrix_console.set_keep_above(True)
                        self.matrix_console.show_all()
                        self.matrix_console.present()
                    GLib.idle_add(_present_err)
                    self.status_text = "Time-Machine: Rollback failed"
            except Exception as e:
                self.status_text = f"Time-Machine error: {e}"
        threading.Thread(target=_worker, daemon=True).start()

    def show_timemachine_snapshots(self):
        def _worker():
            try:
                cmd = ["/opt/floworkos/bin/flowork-timemachine", "list", "-n", "10"]
                if self.active_session_id:
                    cmd.extend(["-s", self.active_session_id])
                res = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=5)
                out = res.stdout.strip() or "No Time-Machine snapshots found."
                msg = (
                    "🏛️ **[ FLOWORK NEURAL TIME-MACHINE SNAPSHOTS ]**\n\n"
                    "```text\n"
                    f"{out}\n"
                    "```\n\n"
                    "Use `/rollback [SNAPSHOT_ID]` to restore any checkpoint, or `/undo` for immediate pre-turn state."
                )
                subprocess.Popen(["flowork-sound-forge", "play", "pop"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                def _present_snaps():
                    self.matrix_console.rehydrate(
                        user_prompt="/snapshots",
                        assistant_text=msg,
                        title="Time-Machine Timeline"
                    )
                    self.matrix_console.update_position()
                    self.matrix_console.set_keep_above(True)
                    self.matrix_console.show_all()
                    self.matrix_console.present()
                GLib.idle_add(_present_snaps)
            except Exception as e:
                pass
        threading.Thread(target=_worker, daemon=True).start()

    def interrupt_tts(self):
        proc = getattr(self, "active_tts_proc", None)
        if proc is not None and proc.poll() is None:
            try:
                proc.terminate()
                proc.wait(timeout=0.5)
            except Exception:
                try:
                    proc.kill()
                except Exception:
                    pass
        self.active_tts_proc = None
        try:
            subprocess.Popen(["/opt/floworkos/bin/flowork-say", "--stop"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception:
            pass

    def start_voice_capture(self):
        self.interrupt_tts()
        self.lbl_voice.set_markup("<span size='medium' color='#00f2fe'>🎙️</span>")
        ctx = self.btn_voice.get_style_context()
        if not ctx.has_class("active-voice"):
            ctx.add_class("active-voice")
        self.status_text = "Listening for voice input... (Barge-in active)"
        subprocess.Popen(["flowork-sound-forge", "play", "pop"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

        def _voice_worker():
            try:
                p = subprocess.run(
                    ["/opt/floworkos/bin/flowork-voice-conductor", "listen", "-m", "15.0", "-s", "1.6"],
                    stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=25
                )
                transcribed = ""
                for line in p.stdout.splitlines():
                    if line.startswith("✓ Transcribed:"):
                        transcribed = line[len("✓ Transcribed:"):].strip()
                        break
                    elif line.strip() and not line.startswith("🎤"):
                        transcribed = line.strip()

                def _on_finish():
                    self.update_voice_ui()
                    if transcribed:
                        subprocess.Popen(["flowork-sound-forge", "play", "chime_run"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                        self.entry.set_text(transcribed)
                        self.on_entry_activate(self.entry)
                    else:
                        self.status_text = "No speech detected"
                GLib.idle_add(_on_finish)
            except Exception as e:
                print(f"[Conduit Voice Error]: {e}", file=sys.stderr)
                GLib.idle_add(self.update_voice_ui)

        threading.Thread(target=_voice_worker, daemon=True).start()

    def on_voice_button_press(self, widget, event):
        if event.button == 3:  # Right-click to speak!
            self.start_voice_capture()
            return True
        return False

    def on_new_chat_clicked(self, widget):
        ctx = self.btn_new_chat.get_style_context()
        ctx.add_class("active-voice")
        GLib.timeout_add(700, lambda: ctx.remove_class("active-voice") or False)
        self._explicit_new_chat = True
        self.active_session_id = None
        self.active_session_title = None
        self.clear_session_anchor()
        if hasattr(self, "continuity_pill"):
            self.continuity_pill.hide()
        if hasattr(self, "runner"):
            self.runner.current_session_id = None
        self.matrix_console.reset_chat()
        self.status_text = "New chat session initialized"
        self.entry.set_placeholder_text("Ask Mr. Flow anything, or type / for skills...")
        self.send_socket_command("hide")
        subprocess.Popen(["flowork-sound-forge", "play", "laser"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def on_voice_toggle(self, widget):
        self.is_voice_active = not self.is_voice_active
        if self.is_voice_active:
            try:
                with open(VOICE_FLAG_FILE, "w") as f:
                    f.write("1\n")
            except Exception:
                pass
            self.update_voice_ui()
            subprocess.Popen(["flowork-say", "Voice mode active. Mr. Flow is ready to respond with audio."])
            subprocess.Popen(["notify-send", "-a", "Flowork Voice", "🔊 Mr. Flow Voice Mode", "Voice mode enabled: Mr. Flow will respond with vocal audio."])
        else:
            try:
                if os.path.exists(VOICE_FLAG_FILE):
                    os.remove(VOICE_FLAG_FILE)
            except Exception:
                pass
            subprocess.Popen(["flowork-say", "--stop"])
            self.update_voice_ui()
            subprocess.Popen(["notify-send", "-a", "Flowork Voice", "🔇 Mr. Flow Voice Mode", "Voice mode disabled (silent)."])
        self.queue_draw()


def main():
    signal.signal(signal.SIGINT, signal.SIG_DFL)
    signal.signal(signal.SIGTERM, signal.SIG_DFL)
    try:
        signal.signal(signal.SIGCHLD, signal.SIG_DFL)
    except Exception:
        pass

    sock_path = f"/tmp/flowork-neural-conduit-{USER}.sock"
    if len(sys.argv) > 1:
        arg = sys.argv[1]
        if arg in ("--attach", "-a") and len(sys.argv) > 2:
            target = os.path.abspath(sys.argv[2])
            try:
                s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
                s.settimeout(2.0)
                s.connect(sock_path)
                s.sendall(json.dumps({"action": "attach", "path": target}).encode("utf-8"))
                res = s.recv(1024)
                s.close()
                print(f"[Conduit] Attached file: {target} (Response: {res.decode().strip()})")
                sys.exit(0)
            except Exception as ex:
                print(f"[Conduit] Failed to attach: {ex}", file=sys.stderr)
                sys.exit(1)
        elif arg in ("--clear", "-c"):
            try:
                s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
                s.settimeout(2.0)
                s.connect(sock_path)
                s.sendall(json.dumps({"action": "clear"}).encode("utf-8"))
                res = s.recv(1024)
                s.close()
                sys.exit(0)
            except Exception as ex:
                print(f"[Conduit] Failed to clear: {ex}", file=sys.stderr)
                sys.exit(1)
        elif arg in ("--text", "-t") and len(sys.argv) > 2:
            txt = sys.argv[2]
            try:
                s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
                s.settimeout(2.0)
                s.connect(sock_path)
                s.sendall(json.dumps({"action": "set_text", "text": txt}).encode("utf-8"))
                res = s.recv(1024)
                s.close()
                sys.exit(0)
            except Exception as ex:
                print(f"[Conduit] Failed to set text: {ex}", file=sys.stderr)
                sys.exit(1)
        elif arg in ("--show-slash", "-s"):
            try:
                s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
                s.settimeout(2.0)
                s.connect(sock_path)
                query = sys.argv[2] if len(sys.argv) > 2 else "/"
                s.sendall(json.dumps({"action": "show_slash", "query": query}).encode("utf-8"))
                res = s.recv(1024)
                s.close()
                sys.exit(0)
            except Exception as ex:
                print(f"[Conduit] Failed to show slash popover: {ex}", file=sys.stderr)
                sys.exit(1)
        elif arg in ("--companion", "-C"):
            if len(sys.argv) > 2:
                st = sys.argv[2]
                tool = sys.argv[3] if len(sys.argv) > 3 else ""
                try:
                    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
                    s.settimeout(2.0)
                    s.connect(sock_path)
                    s.sendall(json.dumps({"action": "companion", "state": st, "tool": tool}).encode("utf-8"))
                    res = s.recv(1024)
                    s.close()
                    print(f"[Conduit] Companion state set to: {st} {tool} (Response: {res.decode().strip()})")
                    sys.exit(0)
                except Exception as ex:
                    print(f"[Conduit] Failed to set companion state: {ex}", file=sys.stderr)
                    sys.exit(1)
            else:
                print("Usage: flowork-neural-conduit --companion <idle|thinking|welder|grid_operator|inspector|scout|success|tool> [tool_name]")
        elif arg in ("--telemetry", "-T"):
            if len(sys.argv) > 2:
                tool = sys.argv[2]
                cmd = sys.argv[3] if len(sys.argv) > 3 else ""
                log = sys.argv[4] if len(sys.argv) > 4 else ""
                code = int(sys.argv[5]) if len(sys.argv) > 5 else 0
                dur = int(sys.argv[6]) if len(sys.argv) > 6 else 142
                logs = [log] if log else []
                try:
                    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
                    s.settimeout(2.0)
                    s.connect(sock_path)
                    payload = {
                        "action": "telemetry",
                        "tool": tool,
                        "command": cmd,
                        "logs": logs,
                        "exit_code": code,
                        "duration_ms": dur
                    }
                    s.sendall(json.dumps(payload).encode("utf-8"))
                    res = s.recv(1024)
                    s.close()
                    print(f"[Conduit] Telemetry dispatched: {tool} {cmd} (Response: {res.decode().strip()})")
                    sys.exit(0)
                except Exception as ex:
                    print(f"[Conduit] Failed to dispatch telemetry: {ex}", file=sys.stderr)
                    sys.exit(1)
        elif arg == "--telemetry-hide":
            try:
                s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
                s.settimeout(2.0)
                s.connect(sock_path)
                s.sendall(json.dumps({"action": "telemetry_hide"}).encode("utf-8"))
                s.close()
                sys.exit(0)
            except Exception as ex:
                print(f"[Conduit] Failed to hide telemetry: {ex}", file=sys.stderr)
                sys.exit(1)
        elif arg == "--telemetry-view" and len(sys.argv) > 2:
            path = sys.argv[2]
            start = int(sys.argv[3]) if len(sys.argv) > 3 else 1
            end = int(sys.argv[4]) if len(sys.argv) > 4 else 25
            try:
                s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
                s.settimeout(2.0)
                s.connect(sock_path)
                payload = {
                    "action": "telemetry",
                    "tool": "view_file",
                    "args": {"AbsolutePath": path, "StartLine": start, "EndLine": end},
                    "exit_code": 0,
                    "duration_ms": 45
                }
                s.sendall(json.dumps(payload).encode("utf-8"))
                res = s.recv(1024)
                s.close()
                sys.exit(0)
            except Exception as ex:
                print(f"[Conduit] Failed to dispatch view telemetry: {ex}", file=sys.stderr)
                sys.exit(1)
        elif arg == "--telemetry-diff" and len(sys.argv) > 4:
            tgt = sys.argv[2]
            old_c = sys.argv[3]
            new_c = sys.argv[4]
            instr = sys.argv[5] if len(sys.argv) > 5 else "Surgical edit"
            start = int(sys.argv[6]) if len(sys.argv) > 6 else 1
            try:
                s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
                s.settimeout(2.0)
                s.connect(sock_path)
                payload = {
                    "action": "telemetry",
                    "tool": "replace_file_content",
                    "args": {
                        "TargetFile": tgt,
                        "TargetContent": old_c,
                        "ReplacementContent": new_c,
                        "Instruction": instr,
                        "StartLine": start
                    },
                    "exit_code": 0,
                    "duration_ms": 78
                }
                s.sendall(json.dumps(payload).encode("utf-8"))
                res = s.recv(1024)
                s.close()
                sys.exit(0)
            except Exception as ex:
                print(f"[Conduit] Failed to dispatch diff telemetry: {ex}", file=sys.stderr)
                sys.exit(1)
        elif arg in ("--prompt", "-p"):
            prompt_text = " ".join(sys.argv[2:]) if len(sys.argv) > 2 else ""
            if not prompt_text:
                print("Usage: flowork-neural-conduit --prompt <text>", file=sys.stderr)
                sys.exit(1)
            try:
                s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
                s.settimeout(3.0)
                s.connect(sock_path)
                s.sendall(json.dumps({"action": "send_prompt", "prompt": prompt_text}).encode("utf-8"))
                res = s.recv(1024)
                s.close()
                print(f"[Conduit] Prompt dispatched (Response: {res.decode().strip()})")
                sys.exit(0)
            except Exception as ex:
                print(f"[Conduit] Failed to dispatch prompt: {ex}", file=sys.stderr)
                sys.exit(1)
        elif arg in ("--stop", "-x"):
            try:
                s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
                s.settimeout(2.0)
                s.connect(sock_path)
                s.sendall(json.dumps({"action": "stop"}).encode("utf-8"))
                res = s.recv(1024)
                s.close()
                print(f"[Conduit] Stopped agent (Response: {res.decode().strip()})")
                sys.exit(0)
            except Exception as ex:
                print(f"[Conduit] Failed to stop agent: {ex}", file=sys.stderr)
                sys.exit(1)
        elif arg in ("--queue", "-q"):
            try:
                s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
                s.settimeout(2.0)
                s.connect(sock_path)
                s.sendall(json.dumps({"action": "get_queue"}).encode("utf-8"))
                res = s.recv(4096)
                s.close()
                print(res.decode().strip())
                sys.exit(0)
            except Exception as ex:
                print(f"[Conduit] Failed to get queue: {ex}", file=sys.stderr)
                sys.exit(1)
        elif arg == "--status":
            try:
                s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
                s.connect(sock_path)
                s.sendall(json.dumps({"action": "status"}).encode("utf-8"))
                res = s.recv(4096)
                s.close()
                print(res.decode().strip())
                sys.exit(0)
            except Exception as ex:
                print(f"[Conduit] Failed to get status: {ex}", file=sys.stderr)
                sys.exit(1)

    app = FloworkNeuralConduit()
    app.show_all()
    Gtk.main()


if __name__ == "__main__":
    main()
