def scan_all_skills():
    """Dynamically scan /opt/floworkos/skills and merge with built-in slash commands."""
    commands = list(BUILTIN_SLASH_COMMANDS)
    if not os.path.isdir(SKILLS_DIR):
        return commands
    try:
        entries = sorted(os.listdir(SKILLS_DIR))
    except Exception:
        return commands

    for entry in entries:
        skill_path = os.path.join(SKILLS_DIR, entry)
        if not os.path.isdir(skill_path):
            continue
        skill_md = os.path.join(skill_path, "SKILL.md")
        if not os.path.isfile(skill_md):
            continue
        name = entry
        description = "Sovereign Capability Package"
        domain = "general"
        keywords = []
        slash_cmd = None
        args_hint = ""
        try:
            with open(skill_md, "r", encoding="utf-8", errors="ignore") as f:
                content = f.read(4096)
            if content.startswith("---"):
                parts = content.split("---", 2)
                if len(parts) >= 3:
                    fm = parts[1]
                    in_keywords = False
                    for line in fm.splitlines():
                        s = line.strip()
                        if s.startswith("keywords:"):
                            in_keywords = True
                            continue
                        elif in_keywords and s.startswith("-"):
                            keywords.append(s.lstrip("- ").strip())
                            continue
                        elif in_keywords and not s.startswith("-"):
                            in_keywords = False

                        if s.startswith("name:"):
                            name = s.split("name:", 1)[1].strip().strip("'\"")
                        elif s.startswith("description:"):
                            description = s.split("description:", 1)[1].strip().strip("'\"")
                        elif s.startswith("domain:"):
                            domain = s.split("domain:", 1)[1].strip().strip("'\"")
                        elif s.startswith("slash_command:"):
                            slash_cmd = s.split("slash_command:", 1)[1].strip().strip("'\"").lstrip("/")
                        elif s.startswith("args_hint:"):
                            args_hint = s.split("args_hint:", 1)[1].strip().strip("'\"")
        except Exception:
            pass

        cmd_name = slash_cmd or name
        # Avoid duplicate command entries
        if not any(c["command"].lower() == cmd_name.lower() for c in commands):
            commands.append({
                "command": cmd_name,
                "skill": name,
                "description": description,
                "domain": domain,
                "keywords": keywords[:6],
                "args_hint": args_hint
            })
    return commands


class SlashCommandsPopover(Gtk.Window):
    """Floating Pure Optical Crystal Glass popover window for live Slash Command autocomplete."""

    def __init__(self, conduit_parent):
        super().__init__(type=Gtk.WindowType.POPUP)
        self.conduit = conduit_parent
        self.set_title("Slash Commands")
        self.set_decorated(False)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)
        self.set_keep_above(True)
        self.set_app_paintable(True)
        self.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.BUTTON_RELEASE_MASK | Gdk.EventMask.POINTER_MOTION_MASK | Gdk.EventMask.SCROLL_MASK)

        screen = self.get_screen()
        visual = screen.get_rgba_visual()
        if visual:
            self.set_visual(visual)

        self.width = 560
        self.height = 310
        self.set_default_size(self.width, self.height)

        self.filtered_commands = []
        self.active_index = 0

        # Main Layout
        self.box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.box.set_margin_start(10)
        self.box.set_margin_end(10)
        self.box.set_margin_top(8)
        self.box.set_margin_bottom(8)
        self.add(self.box)

        # Header Info Bar
        self.header_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        self.lbl_header_title = Gtk.Label()
        self.lbl_header_title.set_markup("<span size='small' weight='bold' color='#00ff66'>⚡ SOVEREIGN SKILLS &amp; SLASH COMMANDS</span>")
        self.header_box.pack_start(self.lbl_header_title, False, False, 4)

        self.lbl_header_count = Gtk.Label()
        self.lbl_header_count.set_markup("<span size='small' color='#94a3b8'>0 ACTIVE</span>")
        self.header_box.pack_end(self.lbl_header_count, False, False, 4)
        self.box.pack_start(self.header_box, False, False, 4)

        # Scrolled list
        self.scrolled = Gtk.ScrolledWindow()
        self.scrolled.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.scrolled.set_hexpand(True)
        self.scrolled.set_vexpand(True)
        self.box.pack_start(self.scrolled, True, True, 2)

        self.listbox = Gtk.ListBox()
        self.listbox.set_selection_mode(Gtk.SelectionMode.SINGLE)
        self.listbox.set_activate_on_single_click(True)
        self.listbox.connect("row-activated", self.on_row_activated)
        self.scrolled.add(self.listbox)

        self.connect("draw", self.on_draw)

    def on_draw(self, widget, cr):
        w, h = float(self.width), float(self.height)
        radius = 18.0
        ar, ag, ab = self.conduit.accent_rgb
        sr, sg, sb = self.conduit.sec_rgb

        cr.set_operator(cairo.OPERATOR_CLEAR)
        cr.paint()
        cr.set_operator(cairo.OPERATOR_OVER)

        # Background Optical Glass Pill
        self.conduit.draw_rounded_pill(cr, 0, 0, w, h, radius)
        cr.set_source_rgba(0.012, 0.024, 0.038, 0.94)
        cr.fill_preserve()

        # Accent Ambient Glow
        glow = cairo.LinearGradient(0, 0, w, h)
        glow.add_color_stop_rgba(0.0, ar, ag, ab, 0.12)
        glow.add_color_stop_rgba(0.5, sr, sg, sb, 0.06)
        glow.add_color_stop_rgba(1.0, 0.0, 0.0, 0.0, 0.40)
        cr.set_source(glow)
        cr.fill_preserve()

        # Razor Specular Rim
        rim = cairo.LinearGradient(0, 0, 0, h)
        rim.add_color_stop_rgba(0.0, 1.0, 1.0, 1.0, 0.80)
        rim.add_color_stop_rgba(0.4, ar, ag, ab, 0.45)
        rim.add_color_stop_rgba(1.0, ar, ag, ab, 0.85)
        cr.set_source(rim)
        cr.set_line_width(1.4)
        cr.stroke()

        return False

    def update_filter(self, query):
        clean_q = query.lstrip("/").strip().lower()
        all_skills = self.conduit.skills_cache
        if not clean_q:
            self.filtered_commands = all_skills
        else:
            self.filtered_commands = [
                c for c in all_skills
                if clean_q in c["command"].lower()
                or clean_q in c["skill"].lower()
                or clean_q in c.get("domain", "").lower()
                or clean_q in c.get("description", "").lower()
                or any(clean_q in kw.lower() for kw in c.get("keywords", []))
            ]

        self.lbl_header_count.set_markup(f"<span size='small' color='#94a3b8'>{len(self.filtered_commands)} ACTIVE</span>")

        # Clear existing list items
        for child in self.listbox.get_children():
            self.listbox.remove(child)

        if not self.filtered_commands:
            row = Gtk.ListBoxRow()
            lbl = Gtk.Label()
            lbl.set_markup(f"<span size='small' color='#64748b' style='italic'>No skills match \"/{clean_q}\"</span>")
            lbl.set_padding(12, 12)
            row.add(lbl)
            self.listbox.add(row)
            self.listbox.show_all()
            return

        for idx, cmd in enumerate(self.filtered_commands):
            row = Gtk.ListBoxRow()
            row_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
            row_box.set_margin_start(8)
            row_box.set_margin_end(8)
            row_box.set_margin_top(5)
            row_box.set_margin_bottom(5)

            # Badge pill
            lbl_cmd = Gtk.Label()
            lbl_cmd.set_markup(f"<span weight='bold' color='#00ff66'>/{cmd['command']}</span>")
            lbl_cmd.set_width_chars(16)
            lbl_cmd.set_xalign(0.0)
            row_box.pack_start(lbl_cmd, False, False, 0)

            # Domain badge
            dom_text = cmd.get("domain", "general").upper()
            lbl_dom = Gtk.Label()
            lbl_dom.set_markup(f"<span size='xx-small' weight='bold' color='#00f2fe'>[{dom_text}]</span>")
            row_box.pack_start(lbl_dom, False, False, 0)

            # Description
            desc = cmd.get("description", "")
            if len(desc) > 50:
                desc = desc[:48] + "..."
            lbl_desc = Gtk.Label()
            lbl_desc.set_markup(f"<span size='small' color='#cbd5e1'>{GLib.markup_escape_text(desc)}</span>")
            lbl_desc.set_xalign(0.0)
            lbl_desc.set_hexpand(True)
            row_box.pack_start(lbl_desc, True, True, 0)

            row.add(row_box)
            row.connect("button-press-event", lambda w, ev, c=cmd["command"]: self.on_row_clicked(c))
            self.listbox.add(row)

        self.listbox.show_all()
        self.active_index = 0
        self.highlight_active_row()

    def highlight_active_row(self):
        children = self.listbox.get_children()
        if 0 <= self.active_index < len(children):
            self.listbox.select_row(children[self.active_index])
            # Scroll to make visible
            adj = self.scrolled.get_vadjustment()
            if adj:
                row = children[self.active_index]
                alloc = row.get_allocation()
                adj.clamp_page(alloc.y, alloc.y + alloc.height)

    def select_next(self):
        count = len(self.filtered_commands)
        if count > 0:
            self.active_index = (self.active_index + 1) % count
            self.highlight_active_row()

    def select_prev(self):
        count = len(self.filtered_commands)
        if count > 0:
            self.active_index = (self.active_index - 1 + count) % count
            self.highlight_active_row()

    def activate_current(self):
        if 0 <= self.active_index < len(self.filtered_commands):
            cmd = self.filtered_commands[self.active_index]
            self.conduit.apply_slash_command(cmd["command"])
            self.hide()

    def on_row_clicked(self, cmd_name):
        self.conduit.apply_slash_command(cmd_name)
        self.hide()
        return True

    def on_row_activated(self, listbox, row):
        idx = row.get_index()
        if 0 <= idx < len(self.filtered_commands):
            cmd = self.filtered_commands[idx]
            self.conduit.apply_slash_command(cmd["command"])
            self.hide()


def clean_history_user_text(raw):
    if not raw:
        return ""
    text = str(raw)
    if (
        "State snapshot restored. Continue autonomous execution" in text
        or "Snapshot distillation" in text
        or "First, reason through the state snapshot" in text
        or "Now critically evaluate" in text
        or "<state_snapshot>" in text
        or "Please summarize the conversation" in text
    ):
        return ""
    m = re.search(r"<USER_REQUEST>(.*?)</USER_REQUEST>", text, re.DOTALL)
    if m:
        text = m.group(1)
    text = re.sub(r"<CONTEXT_SUMMARY>.*?</CONTEXT_SUMMARY>", "", text, flags=re.DOTALL)
    text = re.sub(r"<[^>]+>", "", text)
    text = re.sub(r"\[SYSTEM DIRECTIVE:[^\]]+\]", "", text)
    text = re.sub(r"User Instruction/Question:\s*", "", text)
    text = re.sub(r"Task instructions/arguments:\s*", "", text)
    text = re.sub(r"User instructions:\s*", "", text)
    return text.strip()


def clean_history_agent_text(raw):
    if not raw:
        return ""
    text = str(raw)
    if text.startswith("Created At:") and "[DOKTRIN TERMINAL" in text:
        return ""
    if "Keluaran Standar (Stdout):" in text or "[DOKTRIN TERMINAL FLOWORK]" in text:
        return ""
    if (
        "<state_snapshot>" in text
        or "<scratchpad>" in text
        or "Understood. Continuing seamlessly from the compressed state snapshot." in text
    ):
        return ""
    return text.strip()


def format_relative_time(timestamp):
    if not timestamp:
        return ""
    try:
        now = time.time()
        diff = max(0, now - float(timestamp))
        if diff < 60:
            return "baru saja"
        elif diff < 3600:
            mins = max(1, int(diff // 60))
            return f"{mins}m lalu"
        elif diff < 86400:
            hours = max(1, int(diff // 3600))
            return f"{hours}j lalu"
        elif diff < 86400 * 2:
            return "kemarin"
        else:
            days = int(diff // 86400)
            if days < 7:
                return f"{days}h lalu"
            return time.strftime("%d %b", time.localtime(float(timestamp)))
    except Exception:
        return ""


class QueuedMessagesBanner(Gtk.Window):
    """
    Floating Pure Optical Crystal Glass Queued Messages banner.
    Replicates Antigravity's pending/queued message queue UI:
    - Header: 'Queued Messages (N) • Sends after agent finishes working ⌄'
    - Item Cards: Thumbnail + Truncated Text + [➔ Send Now] + [✏️ Edit] + [🗑️ Delete]
    - Autonomous reactive dequeue when active turn finishes.
    """
    def __init__(self, conduit):
        super().__init__(type=Gtk.WindowType.POPUP)
        self.conduit = conduit
        self.set_title("Queued Messages")
        self.set_decorated(False)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)
        self.set_keep_above(True)
        self.set_app_paintable(True)
        self.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.BUTTON_RELEASE_MASK | Gdk.EventMask.POINTER_MOTION_MASK)

        screen = self.get_screen()
        visual = screen.get_rgba_visual()
        if visual:
            self.set_visual(visual)

        self.banner_w = 880
        self.collapsed = False

        self.box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        self.box.set_margin_start(14)
        self.box.set_margin_end(14)
        self.box.set_margin_top(8)
        self.box.set_margin_bottom(8)
        self.add(self.box)

        # Header Box
        self.header_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)

        # Title "Queued Messages"
        self.lbl_title = Gtk.Label()
        self.lbl_title.set_markup("<span font_family='Inter, sans-serif' size='small' weight='bold' color='#f1f5f9'>Queued Messages</span>")
        self.header_box.pack_start(self.lbl_title, False, False, 0)

        # Count Badge Pill
        self.badge_box = Gtk.Box()
        self.badge_box.get_style_context().add_class("queue-badge")
        self.lbl_count = Gtk.Label()
        self.lbl_count.set_markup("<span font_family='JetBrains Mono, monospace' size='xx-small' weight='bold' color='#00f2fe'>1</span>")
        self.badge_box.pack_start(self.lbl_count, False, False, 6)
        self.header_box.pack_start(self.badge_box, False, False, 0)

        # Subtitle
        self.lbl_sub = Gtk.Label()
        self.lbl_sub.set_markup("<span font_family='Inter, sans-serif' size='small' color='#94a3b8'>Sends after agent finishes working</span>")
        self.header_box.pack_start(self.lbl_sub, False, False, 0)

        # Spacer
        sp = Gtk.Box()
        sp.set_hexpand(True)
        self.header_box.pack_start(sp, True, True, 0)

        # Chevron collapse/expand button
        self.btn_chevron = Gtk.Button()
        self.btn_chevron.set_relief(Gtk.ReliefStyle.NONE)
        self.btn_chevron.set_can_focus(False)
        self.btn_chevron.get_style_context().add_class("queue-btn-action")
        self.lbl_chevron = Gtk.Label()
        self.lbl_chevron.set_markup("<span size='small' color='#94a3b8'>⌄</span>")
        self.btn_chevron.add(self.lbl_chevron)
        self.btn_chevron.connect("clicked", self.on_toggle_collapse)
        self.header_box.pack_end(self.btn_chevron, False, False, 0)

        self.box.pack_start(self.header_box, False, False, 0)

        # Scrolled / List of queued items with height capping
        self.scrolled = Gtk.ScrolledWindow()
        self.scrolled.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.scrolled.set_max_content_height(190)
        self.scrolled.set_propagate_natural_height(True)

        self.items_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        self.scrolled.add(self.items_box)
        self.box.pack_start(self.scrolled, True, True, 2)

        self.connect("draw", self.on_draw)

    def on_toggle_collapse(self, widget):
        self.collapsed = not self.collapsed
        if self.collapsed:
            self.lbl_chevron.set_markup("<span size='small' color='#94a3b8'>⌃</span>")
            self.scrolled.hide()
        else:
            self.lbl_chevron.set_markup("<span size='small' color='#94a3b8'>⌄</span>")
            self.scrolled.show()
        self.reposition()

    def update_items(self, messages):
        # Clear existing items
        for ch in self.items_box.get_children():
            self.items_box.remove(ch)

        count = len(messages)
        self.lbl_count.set_markup(f"<span font_family='JetBrains Mono, monospace' size='xx-small' weight='bold' color='#00f2fe'>{count}</span>")

        if count == 0:
            self.hide()
            return

        for item in messages:
            msg_id = item.get("id", "")
            raw_text = item.get("text", "")
            disp_text = item.get("display_text", "") or raw_text
            att = item.get("attachment")

            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            row.get_style_context().add_class("queue-item-row")

            # 1. Left Thumbnail or Icon
            if att and isinstance(att, dict) and att.get("type") == "image" and os.path.isfile(att.get("path", "")):
                try:
                    pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(att["path"], 28, 28, True)
                    img = Gtk.Image.new_from_pixbuf(pb)
                    row.pack_start(img, False, False, 2)
                except Exception:
                    lbl_ic = Gtk.Label()
                    lbl_ic.set_markup("<span size='small'>🖼️</span>")
                    row.pack_start(lbl_ic, False, False, 2)
            elif att and isinstance(att, dict):
                lbl_ic = Gtk.Label()
                lbl_ic.set_markup("<span size='small'>📎</span>")
                row.pack_start(lbl_ic, False, False, 2)
            else:
                lbl_ic = Gtk.Label()
                lbl_ic.set_markup("<span size='small' color='#38bdf8'>💬</span>")
                row.pack_start(lbl_ic, False, False, 2)

            # 2. Text Snippet
            clean_snippet = disp_text.replace("\n", " ").strip()
            if len(clean_snippet) > 85:
                clean_snippet = clean_snippet[:82] + "..."
            lbl_txt = Gtk.Label()
            lbl_txt.set_markup(f"<span font_family='Inter, sans-serif' size='small' color='#e2e8f0'>{GLib.markup_escape_text(clean_snippet)}</span>")
            lbl_txt.set_xalign(0.0)
            lbl_txt.set_hexpand(True)
            lbl_txt.set_ellipsize(Pango.EllipsizeMode.END)
            row.pack_start(lbl_txt, True, True, 2)

            # 3. Action Buttons Cluster [➔] [✏️] [🗑️]
            # Send Now (Promote / Interrupt active turn)
            btn_now = Gtk.Button()
            btn_now.set_relief(Gtk.ReliefStyle.NONE)
            btn_now.set_can_focus(False)
            btn_now.set_tooltip_text("Send Now (Interrupt current turn & execute immediately)")
            btn_now.get_style_context().add_class("queue-btn-action")
            lbl_now = Gtk.Label()
            lbl_now.set_markup("<span font_family='JetBrains Mono' size='small' weight='bold' color='#00f2fe'>➔</span>")
            btn_now.add(lbl_now)
            btn_now.connect("clicked", lambda w, mid=msg_id: self.conduit.promote_queued_message(mid))
            row.pack_start(btn_now, False, False, 1)

            # Edit (Restore to entry & remove from queue)
            btn_edit = Gtk.Button()
            btn_edit.set_relief(Gtk.ReliefStyle.NONE)
            btn_edit.set_can_focus(False)
            btn_edit.set_tooltip_text("Edit message (restore to input field)")
            btn_edit.get_style_context().add_class("queue-btn-action")
            lbl_edit = Gtk.Label()
            lbl_edit.set_markup("<span size='small' color='#94a3b8'>✏️</span>")
            btn_edit.add(lbl_edit)
            btn_edit.connect("clicked", lambda w, mid=msg_id: self.conduit.edit_queued_message(mid))
            row.pack_start(btn_edit, False, False, 1)

            # Delete (Discard from queue)
            btn_del = Gtk.Button()
            btn_del.set_relief(Gtk.ReliefStyle.NONE)
            btn_del.set_can_focus(False)
            btn_del.set_tooltip_text("Discard message from queue")
            btn_del.get_style_context().add_class("queue-btn-action")
            lbl_del = Gtk.Label()
            lbl_del.set_markup("<span size='small' color='#f87171'>🗑️</span>")
            btn_del.add(lbl_del)
            btn_del.connect("clicked", lambda w, mid=msg_id: self.conduit.remove_queued_message(mid))
            row.pack_start(btn_del, False, False, 1)

            self.items_box.pack_start(row, False, False, 1)

        self.show_all()
        if self.collapsed:
            self.scrolled.hide()
        self.reposition()

    def reposition(self):
        screen = self.get_screen()
        sw = screen.get_width()
        _, cur_y = self.conduit.get_position()
        if cur_y <= 0:
            cur_y = self.conduit.pos_y
        self.check_resize()
        _, nat_h = self.get_preferred_height()
        target_h = max(min(nat_h, 240), 44)
        pos_x = (sw - self.banner_w) // 2
        pos_y = cur_y - target_h - 10
        self.move(pos_x, pos_y)
        self.resize(self.banner_w, target_h)

    def on_draw(self, widget, cr):
        alloc = self.get_allocation()
        w, h = float(alloc.width), float(alloc.height)
        radius = 14.0
        ar, ag, ab = self.conduit.accent_rgb
        sr, sg, sb = self.conduit.sec_rgb

        cr.set_operator(cairo.OPERATOR_CLEAR)
        cr.paint()
        cr.set_operator(cairo.OPERATOR_OVER)

        # Background Optical Glass Pill
        self.conduit.draw_rounded_pill(cr, 0, 0, w, h, radius)
        cr.set_source_rgba(0.016, 0.028, 0.044, 0.94)
        cr.fill_preserve()

        # Accent Ambient Glow
        glow = cairo.LinearGradient(0, 0, w, h)
        glow.add_color_stop_rgba(0.0, ar, ag, ab, 0.08)
        glow.add_color_stop_rgba(0.6, sr, sg, sb, 0.04)
        glow.add_color_stop_rgba(1.0, 0.0, 0.0, 0.0, 0.40)
        cr.set_source(glow)
        cr.fill_preserve()

        # Razor Specular Rim
        rim = cairo.LinearGradient(0, 0, 0, h)
        rim.add_color_stop_rgba(0.0, 1.0, 1.0, 1.0, 0.70)
        rim.add_color_stop_rgba(0.4, sr, sg, sb, 0.35)
        rim.add_color_stop_rgba(1.0, ar, ag, ab, 0.65)
        cr.set_source(rim)
        cr.set_line_width(1.2)
        cr.stroke()

        return False


class SessionContinuityPill(Gtk.Window):
    """
    Floating Pure Optical Crystal Glass Session Continuity Pill.
    Appears across reboots/restarts when an earlier session anchor exists:
    [ ⟲ Resume: "Session Title..." (N turns) • 10m lalu ]  [ ✕ Fresh ]
    """
    def __init__(self, conduit):
        super().__init__(type=Gtk.WindowType.POPUP)
        self.conduit = conduit
        self.set_title("Session Continuity")
        self.set_decorated(False)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)
        self.set_keep_above(True)
        self.set_app_paintable(True)
        self.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.BUTTON_RELEASE_MASK | Gdk.EventMask.POINTER_MOTION_MASK)

        screen = self.get_screen()
        visual = screen.get_rgba_visual()
        if visual:
            self.set_visual(visual)

        self.pill_w = 480
        self.pill_h = 36
        self.anchor = None

        self.box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        self.box.set_margin_start(10)
        self.box.set_margin_end(10)
        self.box.set_margin_top(4)
        self.box.set_margin_bottom(4)
        self.add(self.box)

        # Resume Button (Left / Main interactive chip)
        self.btn_resume = Gtk.Button()
        self.btn_resume.set_relief(Gtk.ReliefStyle.NONE)
        self.btn_resume.set_can_focus(False)
        self.btn_resume.get_style_context().add_class("continuity-btn")
        self.btn_resume.set_tooltip_text("Resume this session (Click to view history or type prompt and press Enter)")

        btn_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        self.lbl_icon = Gtk.Label()
        self.lbl_icon.set_markup("<span font_family='JetBrains Mono, monospace' size='small' weight='bold' color='#00ff66'>⟲</span>")
        btn_box.pack_start(self.lbl_icon, False, False, 0)

        self.lbl_text = Gtk.Label()
        self.lbl_text.set_markup("<span font_family='Inter, sans-serif' size='x-small' weight='bold' color='#f1f5f9'>Resume Session</span>")
        self.lbl_text.set_ellipsize(Pango.EllipsizeMode.END)
        self.lbl_text.set_max_width_chars(36)
        btn_box.pack_start(self.lbl_text, False, False, 0)

        self.lbl_turns = Gtk.Label()
        self.lbl_turns.set_markup("<span font_family='JetBrains Mono, monospace' size='xx-small' color='#c084fc'>[1 turn]</span>")
        btn_box.pack_start(self.lbl_turns, False, False, 0)

        self.lbl_time = Gtk.Label()
        self.lbl_time.set_markup("<span font_family='JetBrains Mono, monospace' size='xx-small' color='#64748b'>• baru saja</span>")
        btn_box.pack_start(self.lbl_time, False, False, 0)

        self.btn_resume.add(btn_box)
        self.btn_resume.connect("clicked", self.on_resume_clicked)
        self.box.pack_start(self.btn_resume, True, True, 0)

        # Spacer
        sp = Gtk.Box()
        sp.set_hexpand(True)
        self.box.pack_start(sp, True, True, 0)

        # Dismiss / Fresh Button (Right chip)
        self.btn_dismiss = Gtk.Button()
        self.btn_dismiss.set_relief(Gtk.ReliefStyle.NONE)
        self.btn_dismiss.set_can_focus(False)
        self.btn_dismiss.get_style_context().add_class("continuity-dismiss")
        self.btn_dismiss.set_tooltip_text("Tutup & Mulai Sesi Baru (Fresh Session)")
        self.lbl_dismiss = Gtk.Label()
        self.lbl_dismiss.set_markup("<span font_family='JetBrains Mono, monospace' size='xx-small' weight='bold' color='#94a3b8'>✕ Fresh</span>")
        self.btn_dismiss.add(self.lbl_dismiss)
        self.btn_dismiss.connect("clicked", self.on_dismiss_clicked)
        self.box.pack_end(self.btn_dismiss, False, False, 0)

        self.connect("draw", self.on_draw)

    def update_anchor(self, anchor):
        if not anchor or not anchor.get("session_id"):
            self.anchor = None
            self.hide()
            return

        self.anchor = anchor
        title = anchor.get("title", f"Session {anchor['session_id'][:8]}")
        turns = anchor.get("turns", 1)
        rel_time = format_relative_time(anchor.get("timestamp", time.time()))

        clean_title = GLib.markup_escape_text(title)
        self.lbl_text.set_markup(f"<span font_family='Inter, sans-serif' size='x-small' weight='bold' color='#ffffff'>Resume: &quot;{clean_title}&quot;</span>")
        self.lbl_turns.set_markup(f"<span font_family='JetBrains Mono, monospace' size='xx-small' color='#c084fc'>[{turns} turns]</span>")
        self.lbl_time.set_markup(f"<span font_family='JetBrains Mono, monospace' size='xx-small' color='#64748b'>• {rel_time}</span>")

        self.show_all()
        self.reposition()

    def reposition(self):
        screen = self.get_screen()
        sw = screen.get_width()
        _, cur_y = self.conduit.get_position()
        if cur_y <= 0:
            cur_y = self.conduit.pos_y
        self.check_resize()
        _, nat_w = self.get_preferred_width()
        _, nat_h = self.get_preferred_height()
        target_w = max(min(nat_w, 620), 400)
        target_h = max(nat_h, 36)
        self.pill_w = target_w
        self.pill_h = target_h
        pos_x = (sw - self.pill_w) // 2
        if hasattr(self.conduit, "queued_banner") and self.conduit.queued_banner.get_visible():
            _, q_y = self.conduit.queued_banner.get_position()
            pos_y = q_y - target_h - 6
        else:
            pos_y = cur_y - target_h - 10
        self.move(pos_x, pos_y)
        self.resize(self.pill_w, target_h)

    def on_resume_clicked(self, widget):
        if self.anchor and self.anchor.get("session_id"):
            sid = self.anchor["session_id"]
            title = self.anchor.get("title")
            fpath = self.anchor.get("file_path")
            self.conduit.resume_session(sid, title=title, file_path=fpath, show_console=True)
            self.hide()

    def on_dismiss_clicked(self, widget):
        self.conduit.on_dismiss_continuity()

    def on_draw(self, widget, cr):
        alloc = self.get_allocation()
        w, h = float(alloc.width), float(alloc.height)
        radius = 14.0
        ar, ag, ab = self.conduit.accent_rgb
        sr, sg, sb = self.conduit.sec_rgb

        cr.set_operator(cairo.OPERATOR_CLEAR)
        cr.paint()
        cr.set_operator(cairo.OPERATOR_OVER)

        # Background Optical Glass Pill
        self.conduit.draw_rounded_pill(cr, 0, 0, w, h, radius)
        cr.set_source_rgba(0.016, 0.028, 0.044, 0.94)
        cr.fill_preserve()

        # Accent Ambient Glow
        glow = cairo.LinearGradient(0, 0, w, h)
        glow.add_color_stop_rgba(0.0, ar, ag, ab, 0.12)
        glow.add_color_stop_rgba(0.6, sr, sg, sb, 0.05)
        glow.add_color_stop_rgba(1.0, 0.0, 0.0, 0.0, 0.35)
        cr.set_source(glow)
        cr.fill_preserve()

        # Razor Specular Rim
        rim = cairo.LinearGradient(0, 0, 0, h)
        rim.add_color_stop_rgba(0.0, 1.0, 1.0, 1.0, 0.70)
        rim.add_color_stop_rgba(0.4, ar, ag, ab, 0.40)
        rim.add_color_stop_rgba(1.0, ar, ag, ab, 0.75)
        cr.set_source(rim)
        cr.set_line_width(1.2)
        cr.stroke()

        return False


class QuickSessionSwitcher(Gtk.Window):
    """
    Floating Pure Optical Crystal Glass Quick Session Switcher.
    Opened via slash commands /resume or /sessions.
    Allows keyboard-navigable or click-to-resume switching between recent sessions across projects.
    """
    def __init__(self, conduit):
        super().__init__(type=Gtk.WindowType.POPUP)
        self.conduit = conduit
        self.set_title("Quick Session Switcher")
        self.set_decorated(False)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)
        self.set_keep_above(True)
        self.set_app_paintable(True)
        self.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.BUTTON_RELEASE_MASK | Gdk.EventMask.POINTER_MOTION_MASK | Gdk.EventMask.SCROLL_MASK)

        screen = self.get_screen()
        visual = screen.get_rgba_visual()
        if visual:
            self.set_visual(visual)

        self.width = 640
        self.height = 340
        self.set_default_size(self.width, self.height)

        self.sessions = []
        self.active_index = 0

        self.box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        self.box.set_margin_start(12)
        self.box.set_margin_end(12)
        self.box.set_margin_top(8)
        self.box.set_margin_bottom(8)
        self.add(self.box)

        # Header Box
        self.header_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        
        lbl_icon = Gtk.Label()
        lbl_icon.set_markup("<span font_family='JetBrains Mono, monospace' size='small' weight='bold' color='#00ff66'>⌬</span>")
        self.header_box.pack_start(lbl_icon, False, False, 0)

        lbl_title = Gtk.Label()
        lbl_title.set_markup("<span font_family='JetBrains Mono, monospace' size='small' weight='bold' letter_spacing='1000' color='#ffffff'>QUICK SESSION SWITCHER</span> <span size='xx-small' color='#64748b'>// [↑↓ Select, Enter Switch, Esc Close]</span>")
        self.header_box.pack_start(lbl_title, False, False, 0)

        sp = Gtk.Box()
        sp.set_hexpand(True)
        self.header_box.pack_start(sp, True, True, 0)

        btn_close = Gtk.Button()
        btn_close.set_relief(Gtk.ReliefStyle.NONE)
        btn_close.set_can_focus(False)
        btn_close.get_style_context().add_class("vault-action-btn")
        lbl_c = Gtk.Label()
        lbl_c.set_markup("<span font_family='JetBrains Mono, monospace' size='x-small' color='#94a3b8'>✕</span>")
        btn_close.add(lbl_c)
        btn_close.connect("clicked", lambda w: self.hide())
        self.header_box.pack_end(btn_close, False, False, 0)

        self.box.pack_start(self.header_box, False, False, 2)

        # Scrolled List
        self.scrolled = Gtk.ScrolledWindow()
        self.scrolled.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.scrolled.set_hexpand(True)
        self.scrolled.set_vexpand(True)
        self.box.pack_start(self.scrolled, True, True, 2)

        self.listbox = Gtk.ListBox()
        self.listbox.set_selection_mode(Gtk.SelectionMode.SINGLE)
        self.listbox.set_activate_on_single_click(True)
        self.listbox.connect("row-activated", self.on_row_activated)
        self.scrolled.add(self.listbox)

        # Bottom Fresh Session Action
        self.btn_new = Gtk.Button()
        self.btn_new.set_relief(Gtk.ReliefStyle.NONE)
        self.btn_new.set_can_focus(False)
        self.btn_new.get_style_context().add_class("continuity-btn")
        b_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        lbl_plus = Gtk.Label()
        lbl_plus.set_markup("<span font_family='JetBrains Mono, monospace' size='small' weight='bold' color='#00ff66'>＋</span>")
        b_box.pack_start(lbl_plus, False, False, 4)
        lbl_new_txt = Gtk.Label()
        lbl_new_txt.set_markup("<span font_family='Inter, sans-serif' size='x-small' weight='bold' color='#f1f5f9'>Mulai Sesi Baru (Fresh Session)</span>")
        b_box.pack_start(lbl_new_txt, False, False, 0)
        self.btn_new.add(b_box)
        self.btn_new.connect("clicked", self.on_start_fresh_clicked)
        self.box.pack_start(self.btn_new, False, False, 2)

        self.connect("draw", self.on_draw)

    def load_recent_sessions(self, filter_query=""):
        if hasattr(self.conduit, "history_vault"):
            self.conduit.history_vault.load_sessions()
            all_sess = list(self.conduit.history_vault.sessions)
        else:
            all_sess = []

        q = filter_query.strip().lower()
        if q:
            filtered = [s for s in all_sess if q in s.get("title", "").lower() or q in s.get("id", "").lower()]
        else:
            filtered = all_sess

        self.sessions = filtered[:7]
        self.render_rows()

    def render_rows(self):
        for ch in self.listbox.get_children():
            self.listbox.remove(ch)

        current_active = getattr(self.conduit, "active_session_id", None)

        if not self.sessions:
            row = Gtk.ListBoxRow()
            row.set_selectable(False)
            empty_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
            empty_box.set_margin_top(16)
            empty_box.set_margin_bottom(16)
            lbl = Gtk.Label()
            lbl.set_markup("<span font_family='Inter, sans-serif' size='small' color='#64748b'>Belum ada riwayat percakapan yang tersimpan.</span>")
            empty_box.pack_start(lbl, True, True, 0)
            row.add(empty_box)
            self.listbox.add(row)
            self.listbox.show_all()
            return

        for idx, s in enumerate(self.sessions):
            sid = s.get("id", "")
            title = s.get("title", f"Session {sid[:8]}")
            turns = s.get("turns", 0)
            rel_time = format_relative_time(s.get("mtime", time.time()))
            is_active = (sid == current_active)

            row = Gtk.ListBoxRow()
            row.session_data = s
            row.set_activatable(True)
            row.set_can_focus(False)

            card = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            card.get_style_context().add_class("switcher-card")

            lbl_num = Gtk.Label()
            lbl_num.set_markup(f"<span font_family='JetBrains Mono, monospace' size='xx-small' weight='bold' color='#64748b'>[{idx + 1}]</span>")
            card.pack_start(lbl_num, False, False, 2)

            lbl_ic = Gtk.Label()
            lbl_ic.set_markup("<span font_family='JetBrains Mono, monospace' size='small' color='#00ff66'>💬</span>" if not is_active else "<span font_family='JetBrains Mono, monospace' size='small' color='#00f2fe'>★</span>")
            card.pack_start(lbl_ic, False, False, 0)

            lbl_title = Gtk.Label()
            clean_title = GLib.markup_escape_text(title)
            lbl_title.set_markup(f"<span font_family='Inter, sans-serif' size='small' weight='bold' color='#f1f5f9'>{clean_title}</span>")
            lbl_title.set_ellipsize(Pango.EllipsizeMode.END)
            lbl_title.set_xalign(0.0)
            card.pack_start(lbl_title, True, True, 0)

            lbl_turns = Gtk.Label()
            lbl_turns.set_markup(f"<span font_family='JetBrains Mono, monospace' size='xx-small' color='#c084fc'>[{turns} turns]</span>")
            card.pack_start(lbl_turns, False, False, 0)

            lbl_time = Gtk.Label()
            lbl_time.set_markup(f"<span font_family='JetBrains Mono, monospace' size='xx-small' color='#64748b'>{rel_time}</span>")
            card.pack_start(lbl_time, False, False, 0)

            if is_active:
                lbl_act = Gtk.Label()
                lbl_act.set_markup("<span font_family='JetBrains Mono, monospace' size='xx-small' weight='bold' color='#00ff66'>[AKTIF]</span>")
                card.pack_start(lbl_act, False, False, 2)

            row.add(card)
            self.listbox.add(row)

        self.listbox.show_all()
        self.active_index = 0
        self.highlight_active_row()

    def highlight_active_row(self):
        children = self.listbox.get_children()
        if 0 <= self.active_index < len(children):
            self.listbox.select_row(children[self.active_index])
            adj = self.scrolled.get_vadjustment()
            if adj:
                row = children[self.active_index]
                alloc = row.get_allocation()
                adj.clamp_page(alloc.y, alloc.y + alloc.height)

    def select_next(self):
        count = len(self.sessions)
        if count > 0:
            self.active_index = (self.active_index + 1) % count
            self.highlight_active_row()

    def select_prev(self):
        count = len(self.sessions)
        if count > 0:
            self.active_index = (self.active_index - 1 + count) % count
            self.highlight_active_row()

    def activate_current(self):
        children = self.listbox.get_children()
        if 0 <= self.active_index < len(children):
            row = children[self.active_index]
            if hasattr(row, "session_data"):
                self.resume_selected_session(row.session_data)
                return
        self.hide()

    def activate_index(self, idx):
        if 0 <= idx < len(self.sessions):
            self.resume_selected_session(self.sessions[idx])

    def resume_selected_session(self, sess):
        sid = sess.get("id")
        title = sess.get("title")
        fpath = sess.get("file_path")
        self.conduit.resume_session(sid, title=title, file_path=fpath, show_console=True)
        self.hide()

    def on_row_activated(self, listbox, row):
        if hasattr(row, "session_data"):
            self.resume_selected_session(row.session_data)

    def on_start_fresh_clicked(self, widget):
        self.hide()
        self.conduit.on_new_chat_clicked(None)

    def show_switcher(self, filter_query=""):
        self.load_recent_sessions(filter_query=filter_query)
        self.reposition()
        self.show_all()
        self.present()

    def reposition(self):
        screen = self.get_screen()
        sw = screen.get_width()
        _, cur_y = self.conduit.get_position()
        if cur_y <= 0:
            cur_y = self.conduit.pos_y
        pop_w = 640
        pop_h = min(360, max(180, 48 * max(1, len(self.sessions)) + 80))
        self.width = pop_w
        self.height = pop_h
        pos_x = (sw - pop_w) // 2
        pos_y = cur_y - pop_h - 12
        self.move(pos_x, pos_y)
        self.resize(pop_w, pop_h)

    def on_draw(self, widget, cr):
        alloc = self.get_allocation()
        w, h = float(alloc.width), float(alloc.height)
        radius = 18.0
        ar, ag, ab = self.conduit.accent_rgb
        sr, sg, sb = self.conduit.sec_rgb

        cr.set_operator(cairo.OPERATOR_CLEAR)
        cr.paint()
        cr.set_operator(cairo.OPERATOR_OVER)

        # Background Optical Glass
        self.conduit.draw_rounded_pill(cr, 0, 0, w, h, radius)
        cr.set_source_rgba(0.012, 0.024, 0.038, 0.95)
        cr.fill_preserve()

        # Ambient Glow
        glow = cairo.LinearGradient(0, 0, w, h)
        glow.add_color_stop_rgba(0.0, ar, ag, ab, 0.12)
        glow.add_color_stop_rgba(0.5, sr, sg, sb, 0.06)
        glow.add_color_stop_rgba(1.0, 0.0, 0.0, 0.0, 0.40)
        cr.set_source(glow)
        cr.fill_preserve()

        # Razor Specular Rim
        rim = cairo.LinearGradient(0, 0, 0, h)
        rim.add_color_stop_rgba(0.0, 1.0, 1.0, 1.0, 0.80)
        rim.add_color_stop_rgba(0.4, ar, ag, ab, 0.45)
        rim.add_color_stop_rgba(1.0, ar, ag, ab, 0.85)
        cr.set_source(rim)
        cr.set_line_width(1.4)
        cr.stroke()

        return False


