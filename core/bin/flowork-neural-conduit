        # Periodic refresh
        GLib.timeout_add(100, self.on_animation_tick)
        GLib.timeout_add_seconds(2, self.check_screen_and_theme)
        GLib.timeout_add_seconds(10, self.refresh_skills_cache)

        # Smart Hot-Reload Watcher (syntax-checked & idle-gated)
        self._hot_reload_watch = {}
        for _watch_path in (os.path.realpath(__file__), "/opt/floworkos/lib/flowork_agent_runner.py"):
            if os.path.exists(_watch_path):
                try:
                    self._hot_reload_watch[_watch_path] = os.path.getmtime(_watch_path)
                except Exception:
                    pass
        self._hot_reload_bad_mtime = {}
        self._pending_hot_reload = False
        GLib.timeout_add_seconds(3, self.check_hot_reload)

        # Sovereign IPC Socket Server for external control (--attach, etc.)
        self.conduit_socket_path = f"/tmp/flowork-neural-conduit-{USER}.sock"
        self._ipc_server_sock = None
        self.start_ipc_server()

    def check_hot_reload(self):
        try:
            for path, boot_mtime in list(self._hot_reload_watch.items()):
                if not os.path.exists(path):
                    continue
                cur_mtime = os.path.getmtime(path)
                if cur_mtime != boot_mtime:
                    if self._hot_reload_bad_mtime.get(path) == cur_mtime:
                        continue
                    try:
                        py_compile.compile(path, doraise=True)
                    except Exception as e:
                        self._hot_reload_bad_mtime[path] = cur_mtime
                        print(f"[HOT-RELOAD] Syntax check failed for {path}, skipping reload: {e}", flush=True)
                        continue
                    self._pending_hot_reload = True

            if self._pending_hot_reload:
                if self.is_agent_running():
                    return True
                if getattr(self, "active_session_id", None):
                    try:
                        self.save_session_anchor(self.active_session_id)
                    except Exception:
                        pass
                if getattr(self, "_ipc_server_sock", None):
                    try:
                        self._ipc_server_sock.close()
                    except Exception:
                        pass
                print("[HOT-RELOAD] Verified code update & agent idle. Re-execing flowork-neural-conduit...", flush=True)
                os.execv(sys.executable, [sys.executable] + sys.argv)
        except Exception as e:
            print(f"[HOT-RELOAD] Watcher error: {e}", flush=True)
        return True

    def is_agent_running(self):
        return bool(
            self.is_agent_busy or
            (self.active_agent_proc is not None and self.active_agent_proc.poll() is None) or
            (hasattr(self, "runner") and self.runner.is_running())
        )

    def set_send_button_state(self, state):
        ctx = self.btn_send.get_style_context()
        if state == "stop":
            self.lbl_send.set_markup("<span size='medium' color='#ff3b30'>■</span>")
            self.btn_send.set_tooltip_text("Stop Mr. Flow (Interrupt Active Turn)")
            if not ctx.has_class("btn-stop-agent"):
                ctx.add_class("btn-stop-agent")
        else:
            self.lbl_send.set_markup("<span size='medium' color='#00ff66'>➤</span>")
            self.btn_send.set_tooltip_text("Send Command (Enter)")
            if ctx.has_class("btn-stop-agent"):
                ctx.remove_class("btn-stop-agent")

    def queue_user_message(self, text, attachment=None):
        import uuid
        msg_id = str(uuid.uuid4())[:8]
        disp = text.strip() if text and text.strip() else (os.path.basename(attachment["path"]) if attachment and "path" in attachment else "Instruction")
        item = {
            "id": msg_id,
            "text": text,
            "attachment": dict(attachment) if attachment else None,
            "timestamp": time.time(),
            "display_text": disp
        }
        self.queued_messages.append(item)
        self.update_queued_banner()
        subprocess.Popen(["flowork-sound-forge", "play", "pop"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return False

    def update_queued_banner(self):
        if self.queued_messages:
            self.queued_banner.update_items(self.queued_messages)
        else:
            self.queued_banner.hide()
        return False

    def stop_active_agent(self):
        self.active_turn_id = getattr(self, "active_turn_id", 0) + 1
        proc = self.active_agent_proc
        if proc:
            try:
                pgid = os.getpgid(proc.pid)
                if pgid != os.getpgrp():
                    os.killpg(pgid, signal.SIGTERM)
                else:
                    proc.terminate()
                time.sleep(0.05)
                if proc.poll() is None:
                    if pgid != os.getpgrp():
                        os.killpg(pgid, signal.SIGKILL)
                    else:
                        proc.kill()
            except Exception:
                try:
                    proc.kill()
                except Exception:
                    pass
            self.active_agent_proc = None

        if hasattr(self, "runner"):
            self.runner.abort()

        subprocess.Popen(["flowork-say", "--stop"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        subprocess.Popen(["flowork-sound-forge", "play", "pop"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        self.is_agent_busy = False
        self.set_send_button_state("send")

        try:
            flowork_neural_bridge.set_neural_state("idle", status="idle")
        except Exception:
            pass

        if hasattr(self, "companion"):
            self.companion.set_state("idle")
        if hasattr(self, "matrix_console"):
            self.matrix_console.on_turn_complete()

        self.status_text = "Agent interrupted"

    def promote_queued_message(self, msg_id):
        target = None
        for i, it in enumerate(self.queued_messages):
            if it["id"] == msg_id:
                target = self.queued_messages.pop(i)
                break
        if hasattr(self, "runner") and self.runner:
            self.runner.remove_from_queue(msg_id)
        if target:
            self.stop_active_agent()
            time.sleep(0.05)
            self.update_queued_banner()
            self.is_agent_busy = True
            self.set_send_button_state("stop")
            self.send_to_mrflow(target["text"], attachment_override=target.get("attachment"))
        return False

    def edit_queued_message(self, msg_id):
        target = None
        for i, it in enumerate(self.queued_messages):
            if it["id"] == msg_id:
                target = self.queued_messages.pop(i)
                break
        if hasattr(self, "runner") and self.runner:
            self.runner.remove_from_queue(msg_id)
        if target:
            self.entry.set_text(target.get("text", ""))
            if target.get("attachment"):
                att = target["attachment"]
                self.set_attachment(att.get("path"), att.get("type"))
            self.update_queued_banner()
            self.entry.grab_focus()
            self.entry.set_position(-1)
        return False

    def remove_queued_message(self, msg_id):
        for i, it in enumerate(self.queued_messages):
            if it["id"] == msg_id:
                self.queued_messages.pop(i)
                break
        if hasattr(self, "runner") and self.runner:
            self.runner.remove_from_queue(msg_id)
        self.update_queued_banner()
        return False

    def update_geometry(self):
        screen = self.get_screen()
        self.screen_w = screen.get_width()
        self.screen_h = screen.get_height()

        # Responsive & Sleek Width Calibration
        # Avoids excessive width on ultrawide monitors and fits comfortably on smaller screens
        if self.screen_w >= 2400:
            self.bar_w = 700
        elif self.screen_w >= 1900:
            self.bar_w = 660
        elif self.screen_w >= 1400:
            self.bar_w = 620
        elif self.screen_w >= 1200:
            self.bar_w = 560
        elif self.screen_w >= 1000:
            self.bar_w = 500
        else:
            # Low resolution monitors / mini laptops (800x600, 1024x600)
            self.bar_w = max(390, min(480, int(self.screen_w * 0.85)))

        self.handle_h = 18
        self.bar_h = 50
        self.win_w = self.bar_w + 2 * self.pad_x
        self.win_h = self.bar_h + self.handle_h + 2 * self.pad_y
        self.pos_x = (self.screen_w - self.win_w) // 2
        self.pos_y = self.screen_h - self.win_h - 6

        if not getattr(self, "is_collapsed", False):
            if hasattr(self, "main_box"):
                self.main_box.set_size_request(self.bar_w, self.bar_h)
            self.set_size_request(self.win_w, self.win_h)
            self.resize(self.win_w, self.win_h)
            self.move(self.pos_x, self.pos_y)
        else:
            tab_w = 68
            tab_h = 24
            if hasattr(self, "main_box"):
                self.main_box.set_size_request(-1, -1)
            self.set_size_request(tab_w, tab_h)
            self.resize(tab_w, tab_h)
            pos_x = (self.screen_w - tab_w) // 2
            pos_y = self.screen_h - tab_h - 2
            self.move(pos_x, pos_y)

        self.queue_draw()

    def on_size_allocate(self, widget, allocation):
        screen = self.get_screen()
        sw = screen.get_width()
        real_w = allocation.width
        centered_x = (sw - real_w) // 2
        if not hasattr(self, "_last_conduit_x") or self._last_conduit_x != centered_x:
            self._last_conduit_x = centered_x
            self.pos_x = centered_x
            self.move(self.pos_x, self.pos_y)

    def on_window_map(self, widget, event):
        screen = self.get_screen()
        sw = screen.get_width()
        alloc = self.get_allocation()
        cur_w = alloc.width if alloc.width > 20 else (self.win_w if not getattr(self, "is_collapsed", False) else 68)
        self.pos_x = (sw - cur_w) // 2
        if not getattr(self, "is_collapsed", False):
            self.move(self.pos_x, self.pos_y)
        else:
            tab_h = 24
            pos_y = self.screen_h - tab_h - 2
            self.move(self.pos_x, pos_y)
        return False

    def on_toggle_collapse(self, widget=None):
        if getattr(self, "is_collapsed", False):
            self.expand_conduit()
        else:
            self.collapse_conduit()

    def collapse_conduit(self):
        self.is_collapsed = True
        self.main_box.hide()
        if hasattr(self, "continuity_pill"):
            self.continuity_pill.hide()
        if hasattr(self, "btn_toggle_tab"):
            self.btn_toggle_tab.get_style_context().add_class("conduit-tab-collapsed")
            self.lbl_toggle_tab.set_markup("<span font_family='JetBrains Mono, monospace' size='x-small' weight='heavy' color='#00ff66'>∧</span>")
            self.btn_toggle_tab.set_tooltip_text("Show Mr. Flow Bar (Click or Super+Space)")
        tab_w = 68
        tab_h = 24
        if hasattr(self, "main_box"):
            self.main_box.set_size_request(-1, -1)
        self.set_size_request(tab_w, tab_h)
        self.resize(tab_w, tab_h)
        pos_x = (self.screen_w - tab_w) // 2
        pos_y = self.screen_h - tab_h - 2
        self.move(pos_x, pos_y)
        self.queue_draw()
        subprocess.Popen(["flowork-sound-forge", "play", "pop"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def expand_conduit(self):
        self.is_collapsed = False
        if hasattr(self, "btn_toggle_tab"):
            self.btn_toggle_tab.get_style_context().remove_class("conduit-tab-collapsed")
            self.lbl_toggle_tab.set_markup("<span font_family='JetBrains Mono, monospace' size='x-small' weight='heavy' color='#00ff66'>⌵</span>")
            self.btn_toggle_tab.set_tooltip_text("Hide Mr. Flow Bar (Click or Esc)")
        self.update_geometry()
        self.main_box.show_all()
        screen = self.get_screen()
        sw = screen.get_width()
        self.pos_x = (sw - self.win_w) // 2
        self.move(self.pos_x, self.pos_y)
        self.entry.grab_focus()
        self.queue_draw()
        subprocess.Popen(["flowork-sound-forge", "play", "laser"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def on_realize(self, widget):
        pass

    def update_input_shape(self):
        pass

    def on_agent_event(self, event_type, payload):
        GLib.idle_add(self._handle_agent_event, event_type, payload)

    def _handle_agent_event(self, event_type, payload):
        if event_type == "turn_start":
            self.is_agent_busy = True
            self.set_send_button_state("stop")
            self.matrix_console.on_turn_start(payload.get("prompt", ""))
            if hasattr(self, "companion"):
                self.companion.set_state("thinking")
        elif event_type == "content":
            self.matrix_console.append_chat_content(payload.get("text", ""), payload.get("full", ""))
        elif event_type == "thought":
            self.matrix_console.set_thought(payload.get("text", ""))
        elif event_type == "tool_use":
            tname = payload.get("tool_name") or payload.get("tool") or ""
            targs = payload.get("parameters") or payload.get("args") or {}
            if hasattr(self, "companion"):
                self.companion.set_state("tool", tname)
            self.matrix_console.on_tool_start(tname, targs)
            if hasattr(self, "history_vault"):
                act = targs.get("toolAction") or targs.get("command") or targs.get("CommandLine") or targs.get("TargetFile") or targs.get("query") or str(targs)[:60]
                self.history_vault.show_tool_running(tname, act)
        elif event_type == "tool_result":
            logs = payload.get("logs") or payload.get("output") or payload.get("content") or ""
            code = payload.get("exit_code", 0)
            dur = payload.get("duration_ms")
            if isinstance(logs, list):
                for l in logs:
                    self.matrix_console.append_log("STDOUT", str(l))
            elif isinstance(logs, str) and logs:
                for l in logs.splitlines():
                    self.matrix_console.append_log("STDOUT", l)
            self.matrix_console.on_tool_finish(code, dur)
            if hasattr(self, "history_vault"):
                if code != 0:
                    self.history_vault.show_tool_error(f"Tool {getattr(self.matrix_console, 'active_tool', 'tool')} failed with exit code {code}")
                else:
                    self.history_vault.hide_tool_indicator()
        elif event_type in ("done", "turn_finish"):
            full = payload.get("full", "")
            if full and event_type == "done":
                self.matrix_console.set_final_chat_content(full)
            if hasattr(self, "companion"):
                self.companion.set_state("success")
            self.matrix_console.on_turn_complete()
            if hasattr(self, "history_vault"):
                self.history_vault.hide_tool_indicator()
            if not self.queued_messages and not (hasattr(self, "runner") and self.runner.message_queue):
                self.is_agent_busy = False
                self.set_send_button_state("send")
                self.update_queued_banner()
        elif event_type == "idle":
            self.is_agent_busy = False
            self.set_send_button_state("send")
            self.update_queued_banner()
            if hasattr(self, "companion"):
                self.companion.set_state("idle")
            if hasattr(self, "history_vault"):
                self.history_vault.hide_tool_indicator()
        elif event_type == "queue_updated":
            q_items = payload.get("queue", [])
            self.queued_messages = [
                {
                    "id": it["id"],
                    "text": it["prompt"],
                    "attachment": it.get("attachment"),
                    "timestamp": it.get("created_at", time.time()),
                    "display_text": it.get("display_text", it["prompt"][:80])
                }
                for it in q_items
            ]
            self.update_queued_banner()
        elif event_type == "error":
            err_msg = payload.get("message", "Error")
            self.matrix_console.append_log("ERR", err_msg, "del")
            if hasattr(self, "companion"):
                self.companion.set_state("thinking")
            if hasattr(self, "history_vault"):
                self.history_vault.show_tool_error(err_msg)

    def start_ipc_server(self):
        def _ipc_worker():
            if os.path.exists(self.conduit_socket_path):
                try:
                    os.remove(self.conduit_socket_path)
                except Exception:
                    pass
            try:
                server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
                server.bind(self.conduit_socket_path)
                server.listen(5)
                self._ipc_server_sock = server
            except Exception as e:
                print(f"[Conduit] IPC bind error: {e}", file=sys.stderr)
                return

            while True:
                try:
                    conn, _ = server.accept()
                    try:
                        raw = conn.recv(4096)
                        if raw:
                            data = json.loads(raw.decode("utf-8"))
                            action = data.get("action")
                            if action == "attach":
                                path = data.get("path")
                                ftype = data.get("type")
                                GLib.idle_add(lambda p=path, t=ftype: self.set_attachment(p, t))
                                try:
                                    conn.sendall(b"OK\n")
                                except Exception:
                                    pass
                            elif action == "toggle":
                                GLib.idle_add(self.on_toggle_collapse)
                                try: conn.sendall(b"OK" + bytes([10]))
                                except: pass
                            elif action in ("collapse", "hide_bar"):
                                GLib.idle_add(self.collapse_conduit)
                                try: conn.sendall(b"OK" + bytes([10]))
                                except: pass
                            elif action in ("expand", "show_bar"):
                                GLib.idle_add(self.expand_conduit)
                                try: conn.sendall(b"OK" + bytes([10]))
                                except: pass
                            elif action == "switch_tab":
                                t = data.get("tab", "chat")
                                GLib.idle_add(lambda tb=t: self.matrix_console.switch_tab(tb))
                                try: conn.sendall(b"OK" + bytes([10]))
                                except: pass
                            elif action == "show":
                                GLib.idle_add(lambda: (self.matrix_console.show_all(), self.matrix_console.present()))
                                try: conn.sendall(b"OK" + bytes([10]))
                                except: pass
                            elif action == "hide":
                                GLib.idle_add(self.matrix_console.hide)
                                try: conn.sendall(b"OK" + bytes([10]))
                                except: pass
                            elif action == "new_chat":
                                GLib.idle_add(lambda: self.on_new_chat_clicked(None))
                                try: conn.sendall(b"OK" + bytes([10]))
                                except: pass
                            elif action == "screenshot":
                                GLib.idle_add(lambda: self.on_screenshot_clicked(None))
                                try: conn.sendall(b"OK" + bytes([10]))
                                except: pass
                            elif action in ("toggle_history", "history"):
                                GLib.idle_add(lambda: self.on_toggle_history_vault(None))
                                try: conn.sendall(b"OK" + bytes([10]))
                                except: pass
                            elif action in ("switcher", "quick_switcher", "resume", "sessions"):
                                q = data.get("query", "")
                                GLib.idle_add(lambda query=q: self.show_quick_session_switcher(filter_query=query))
                                try: conn.sendall(b"OK" + bytes([10]))
                                except: pass
                            elif action == "inspect_first_session":
                                def _open_first():
                                    if hasattr(self, "history_vault"):
                                        if not self.history_vault.get_visible():
                                            self.history_vault.toggle_vault()
                                        if self.history_vault.sessions:
                                            self.history_vault.open_transcript_view(self.history_vault.sessions[0])
                                GLib.idle_add(_open_first)
                            elif action == "open_session":
                                sid = data.get("session_id", "")
                                def _open_s():
                                    if hasattr(self, "history_vault"):
                                        if not self.history_vault.get_visible():
                                            self.history_vault.toggle_vault()
                                        for s in self.history_vault.sessions:
                                            if sid in s["id"] or sid in s.get("file_path", ""):
                                                self.history_vault.open_transcript_view(s)
                                                break
                                GLib.idle_add(_open_s)
                                try: conn.sendall(b"OK" + bytes([10]))
                                except: pass
                            elif action == "set_session":
                                sid = data.get("session_id")
                                if sid:
                                    self.active_session_id = sid
                                    self.status_text = f"Resumed: {sid[:8]}..."
                                    subprocess.Popen(["flowork-sound-forge", "play", "pop"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                                try: conn.sendall(b"OK" + bytes([10]))
                                except: pass
                            elif action in ("send_prompt", "prompt"):
                                p = data.get("prompt", "")
                                def _ipc_dispatch_prompt(prompt_text):
                                    if hasattr(self, "is_collapsed") and self.is_collapsed:
                                        if hasattr(self, "expand_conduit"):
                                            self.expand_conduit()
                                    self.present()
                                    if hasattr(self, "is_agent_running") and self.is_agent_running():
                                        if hasattr(self, "queue_user_message"):
                                            self.queue_user_message(prompt_text, None)
                                        self.status_text = "Prompt queued for Mr. Flow"
                                    else:
                                        self.is_agent_busy = True
                                        if hasattr(self, "set_send_button_state"):
                                            self.set_send_button_state("stop")
                                        self.send_to_mrflow(prompt_text)
                                GLib.idle_add(_ipc_dispatch_prompt, p)
                                try: conn.sendall(b"OK" + bytes([10]))
                                except: pass
                            elif action in ("stop", "interrupt", "abort"):
                                GLib.idle_add(self.stop_active_agent)
                                try: conn.sendall(b"OK\n")
                                except: pass
                            elif action == "get_queue":
                                try: conn.sendall(json.dumps(self.queued_messages).encode("utf-8") + b"\n")
                                except: pass
                            elif action == "promote_queue":
                                mid = data.get("id")
                                if mid:
                                    GLib.idle_add(lambda m=mid: (self.promote_queued_message(m), False)[1])
                                try: conn.sendall(b"OK\n")
                                except: pass
                            elif action in ("timemachine_rollback", "undo", "rollback"):
                                tid = data.get("target_id", "HEAD~1")
                                GLib.idle_add(lambda t=tid: self.execute_timemachine_rollback(t))
                                try: conn.sendall(b"OK\n")
                                except: pass
                            elif action in ("timemachine_snapshots", "snapshots"):
                                GLib.idle_add(self.show_timemachine_snapshots)
                                try: conn.sendall(b"OK\n")
                                except: pass
                            elif action in ("voice_listen", "listen"):
                                GLib.idle_add(self.start_voice_capture)
                                try: conn.sendall(b"OK\n")
                                except: pass
                            elif action == "remove_queue":
                                mid = data.get("id")
                                if mid:
                                    GLib.idle_add(lambda m=mid: (self.remove_queued_message(m), False)[1])
                                try: conn.sendall(b"OK\n")
                                except: pass
                            elif action == "queue_message":
                                p = data.get("prompt", "")
                                if p:
                                    GLib.idle_add(lambda pr=p: (self.queue_user_message(pr), False)[1])
                                try: conn.sendall(b"OK\n")
                                except: pass
                            elif action == "clear_queue":
                                self.queued_messages.clear()
                                if hasattr(self, "runner") and self.runner:
                                    self.runner.clear_queue()
                                GLib.idle_add(lambda: (self.update_queued_banner(), False)[1])
                                try: conn.sendall(b"OK\n")
                                except: pass
                            elif action == "clear":
                                GLib.idle_add(self.clear_attachment)
                                try:
                                    conn.sendall(b"OK\n")
                                except Exception:
                                    pass
                            elif action == "set_text":
                                text = data.get("text", "")
                                GLib.idle_add(lambda t=text: self.entry.set_text(t))
                                try:
                                    conn.sendall(b"OK\n")
                                except Exception:
                                    pass
                            elif action == "show_slash":
                                q = data.get("query", "/")
                                GLib.idle_add(lambda query=q: (self.entry.set_text(query), self.show_slash_popover(query)))
                                try:
                                    conn.sendall(b"OK\n")
                                except Exception:
                                    pass
                            elif action == "companion":
                                st = data.get("state", "idle")
                                tool = data.get("tool", "")
                                if hasattr(self, "companion"):
                                    GLib.idle_add(lambda s=st, t=tool: self.companion.set_state(s, t))
                                try:
                                    conn.sendall(b"OK\n")
                                except Exception:
                                    pass
                            elif action == "telemetry":
                                t_tool = data.get("tool", "run_command")
                                t_args = data.get("args") or {
                                    "CommandLine": data.get("command", ""),
                                    "AbsolutePath": data.get("path", ""),
                                    "TargetFile": data.get("target_file", ""),
                                    "TargetContent": data.get("target_content", ""),
                                    "ReplacementContent": data.get("replacement_content", ""),
                                    "StartLine": data.get("start_line", 1),
                                    "EndLine": data.get("end_line", 25),
                                    "Instruction": data.get("instruction", "")
                                }
                                t_logs = data.get("logs", [])
                                t_code = data.get("exit_code", 0)
                                t_dur = data.get("duration_ms", 142)
                                def _trigger_telemetry():
                                    if hasattr(self, "companion"):
                                        self.companion.set_state("tool", t_tool)
                                    if hasattr(self, "matrix_console"):
                                        self.matrix_console.on_tool_start(t_tool, t_args)
                                        if isinstance(t_logs, list):
                                            for l in t_logs:
                                                self.matrix_console.append_log("STDOUT", l)
                                        elif isinstance(t_logs, str):
                                            self.matrix_console.append_log("STDOUT", t_logs)
                                        self.matrix_console.on_tool_finish(t_code, t_dur)
                                GLib.idle_add(_trigger_telemetry)
                                try:
                                    conn.sendall(b"OK\n")
                                except Exception:
                                    pass
                            elif action == "telemetry_start":
                                t_tool = data.get("tool", "run_command")
                                t_args = data.get("args") or {"CommandLine": data.get("command", "")}
                                def _start():
                                    if hasattr(self, "companion"):
                                        self.companion.set_state("tool", t_tool)
                                    if hasattr(self, "matrix_console"):
                                        self.matrix_console.on_tool_start(t_tool, t_args)
                                GLib.idle_add(_start)
                                try:
                                    conn.sendall(b"OK\n")
                                except Exception:
                                    pass
                            elif action == "telemetry_log":
                                t_tag = data.get("tag", "STDOUT")
                                t_line = data.get("line", "")
                                if hasattr(self, "matrix_console") and t_line:
                                    GLib.idle_add(lambda tg=t_tag, l=t_line: self.matrix_console.append_log(tg, l))
                                try:
                                    conn.sendall(b"OK\n")
                                except Exception:
                                    pass
                            elif action == "telemetry_finish":
                                t_code = data.get("exit_code", 0)
                                t_dur = data.get("duration_ms")
                                def _finish():
                                    if hasattr(self, "companion"):
                                        self.companion.set_state("success" if t_code == 0 else "thinking")
                                    if hasattr(self, "matrix_console"):
                                        self.matrix_console.on_tool_finish(t_code, t_dur)
                                GLib.idle_add(_finish)
                                try:
                                    conn.sendall(b"OK\n")
                                except Exception:
                                    pass
                            elif action == "telemetry_hide":
                                if hasattr(self, "matrix_console"):
                                    GLib.idle_add(self.matrix_console.hide)
                                try:
                                    conn.sendall(b"OK\n")
                                except Exception:
                                    pass
                            elif action == "status":
                                st = {
                                    "attachment": self.current_attachment,
                                    "voice_active": self.is_voice_active,
                                    "active_session_id": getattr(self, "active_session_id", None),
                                    "entry_text": self.entry.get_text(),
                                    "companion_state": getattr(self.companion, "state", "unknown") if hasattr(self, "companion") else "none", "active_tab": getattr(self.matrix_console, "active_tab", "none"), "user_tab_override": getattr(self.matrix_console, "user_tab_override", False)
                                }
                                try:
                                    conn.sendall(json.dumps(st).encode("utf-8") + b"\n")
                                except Exception:
                                    pass
                    finally:
                        try:
                            conn.close()
                        except Exception:
                            pass
                except Exception:
                    pass

        threading.Thread(target=_ipc_worker, daemon=True).start()

    def start_bus_listener(self):
        def _bus_worker():
            sock_candidates = [
                "/run/flowork/bus.sock",
                "/tmp/flowork-neural-bus.sock",
                os.path.expanduser("~/.flowork/bus.sock"),
                "/tmp/flowork_bus.sock"
            ]
            while True:
                sock_path = None
                for p in sock_candidates:
                    if os.path.exists(p):
                        sock_path = p
                        break
                if not sock_path:
                    time.sleep(3.0)
                    continue

                try:
                    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
                    s.settimeout(120.0)
                    s.connect(sock_path)
                    buf = ""
                    while True:
                        chunk = s.recv(4096).decode("utf-8", errors="ignore")
                        if not chunk:
                            break
                        buf += chunk
                        while "\n" in buf:
                            line, buf = buf.split("\n", 1)
                            line = line.strip()
                            if not line:
                                continue
                            try:
                                evt = json.loads(line)
                                act = evt.get("action", "")
                                payload = evt.get("payload") or {}
                                if not isinstance(payload, dict):
                                    payload = {}

                                if act in ("tool_start", "agent:tool_call", "tool_call"):
                                    tool = payload.get("tool") or payload.get("name") or ""
                                    args = payload.get("args") or payload.get("arguments") or payload
                                    if hasattr(self, "companion"):
                                        GLib.idle_add(lambda t=tool: self.companion.set_state("tool", t))
                                    if hasattr(self, "matrix_console"):
                                        GLib.idle_add(lambda t=tool, a=args: self.matrix_console.on_tool_start(t, a))
                                elif act in ("tool_log", "stdout", "stderr", "log"):
                                    tag = "STDERR" if act == "stderr" else "STDOUT"
                                    msg = payload.get("log") or payload.get("line") or payload.get("text") or ""
                                    if hasattr(self, "matrix_console") and msg:
                                        GLib.idle_add(lambda tg=tag, m=msg: self.matrix_console.append_log(tg, m))
                                elif act in ("tool_end", "tool_done", "agent:tool_done"):
                                    code = payload.get("exit_code", 0)
                                    dur = payload.get("duration_ms")
                                    if hasattr(self, "companion"):
                                        GLib.idle_add(lambda: self.companion.set_state("thinking") if self.companion.state != "idle" else None)
                                    if hasattr(self, "matrix_console"):
                                        GLib.idle_add(lambda c=code, d=dur: self.matrix_console.on_tool_finish(c, d))
                                elif act in ("turn_complete", "success", "exit_0"):
                                    if hasattr(self, "companion"):
                                        GLib.idle_add(lambda: self.companion.set_state("success"))
                                    if hasattr(self, "matrix_console"):
                                        GLib.idle_add(lambda: self.matrix_console.on_turn_complete())
                                elif act == "companion":
                                    c_st = payload.get("state", "idle")
                                    c_tool = payload.get("tool", "")
                                    if hasattr(self, "companion"):
                                        GLib.idle_add(lambda s=c_st, t=c_tool: self.companion.set_state(s, t))
                            except Exception:
                                pass
                except Exception:
                    time.sleep(3.0)

        threading.Thread(target=_bus_worker, daemon=True).start()

    def start_transcript_watcher(self):
        def _watcher_worker():
            home = os.path.expanduser("~")
            cur_file = None
            cur_fp = None
            cur_inode = None
            last_pos = 0
            last_scan_time = 0.0
            target = None

            while True:
                try:
                    now = time.time()
                    if target is None or (now - last_scan_time > 0.8):
                        last_scan_time = now
                        candidates = (
                            glob.glob(f"{home}/.gemini/antigravity/brain/*/.system_generated/logs/transcript.jsonl") +
                            glob.glob(f"{home}/.flowork/history/chats/*/*.jsonl") +
                            glob.glob(f"/opt/floworkos/history/chats/*/*.jsonl")
                        )
                        vault_fpath = getattr(self.history_vault, "current_session", {}).get("file_path") if hasattr(self, "history_vault") and self.history_vault.current_session else None
                        if vault_fpath and os.path.exists(vault_fpath):
                            target = vault_fpath
                        else:
                            transcripts = sorted(
                                [c for c in candidates if os.path.exists(c)],
                                key=lambda p: os.path.getmtime(p),
                                reverse=True
                            )
                            target = transcripts[0] if transcripts else None

                    if not target or not os.path.exists(target):
                        time.sleep(0.5)
                        continue

                    st = os.stat(target)
                    if cur_file != target or cur_inode != st.st_ino or cur_fp is None:
                        if cur_fp:
                            try:
                                cur_fp.close()
                            except Exception:
                                pass
                        cur_file = target
                        cur_inode = st.st_ino
                        cur_fp = open(target, "r", encoding="utf-8", errors="replace")
                        cur_fp.seek(0, os.SEEK_END)
                        last_pos = cur_fp.tell()

                    if st.st_size < last_pos:
                        last_pos = 0
                        cur_fp.seek(0, os.SEEK_SET)

                    if st.st_size <= last_pos:
                        time.sleep(0.04)
                        continue

                    cur_fp.seek(last_pos)

                    while True:
                        line = cur_fp.readline()
                        if not line:
                            break
                        last_pos = cur_fp.tell()
                        line = line.strip()
                        if not line:
                            continue
                        try:
                            obj = json.loads(line)
                            t_type = obj.get("type", "")

                            # Live Thinking Step
                            thinking_txt = obj.get("thinking")
                            if thinking_txt and isinstance(thinking_txt, str) and thinking_txt.strip():
                                def _on_thinking(tt=thinking_txt):
                                    if hasattr(self, "companion"):
                                        self.companion.set_state("thinking")
                                    if hasattr(self, "history_vault"):
                                        self.history_vault.show_thinking(tt)
                                GLib.idle_add(_on_thinking)

                            # Mr. Flow Tool Calls
                            tool_calls = obj.get("toolCalls") or obj.get("tool_calls") or []
                            if tool_calls:
                                for call in tool_calls:
                                    t_name = call.get("name") or call.get("tool_name") or ""
                                    clean_args = call.get("args") or call.get("parameters") or {}
                                    def _on_call(tn=t_name, ca=clean_args):
                                        if hasattr(self, "companion"):
                                            self.companion.set_state("tool", tn)
                                        if hasattr(self, "matrix_console"):
                                            self.matrix_console.on_tool_start(tn, ca)
                                        if hasattr(self, "history_vault"):
                                            act = ca.get("toolAction") or ca.get("command") or ca.get("CommandLine") or str(ca)[:60]
                                            self.history_vault.show_tool_running(tn, act)
                                    GLib.idle_add(_on_call)

                            # Mr. Flow Tool Function Responses
                            func_res = None
                            content_arr = obj.get("content")
                            if isinstance(content_arr, list):
                                for item in content_arr:
                                    if isinstance(item, dict) and "functionResponse" in item:
                                        func_res = item["functionResponse"]
                                        break

                            if func_res:
                                resp = func_res.get("response") or {}
                                ec = resp.get("exit_code", 0)
                                stdout_txt = resp.get("stdout", "") or resp.get("output", "")
                                lines_out = stdout_txt.splitlines() if stdout_txt else []
                                def _on_res(lo=lines_out, e=ec):
                                    if hasattr(self, "matrix_console"):
                                        for l_txt in lo[:10]:
                                            self.matrix_console.append_log("STDOUT", l_txt)
                                        self.matrix_console.on_tool_finish(e)
                                    if hasattr(self, "companion"):
                                        self.companion.set_state("success" if e == 0 else "thinking")
                                    if hasattr(self, "history_vault"):
                                        if e != 0:
                                            self.history_vault.show_tool_error(f"Tool failed with exit code {e}")
                                        else:
                                            self.history_vault.show_thinking("Analyzing tool output...")
                                GLib.idle_add(_on_res)

                            # Assistant Turn Finished (MODEL source without active tool calls or Flowork chat assistant)
                            elif (obj.get("source") == "MODEL" and not tool_calls and obj.get("type") not in ("PLANNER_RESPONSE", "GENERIC")) or (t_type in ("gemini", "assistant", "model")):
                                def _on_model_done():
                                    if hasattr(self, "companion"):
                                        self.companion.set_state("idle")
                                    if hasattr(self, "history_vault"):
                                        self.history_vault.hide_tool_indicator()
                                GLib.idle_add(_on_model_done)

                            # Mr. Flow Error Event
                            elif obj.get("status") == "ERROR" or obj.get("type") == "error":
                                err_txt = obj.get("content") or obj.get("error") or "Execution error"
                                def _on_err(et=str(err_txt)):
                                    if hasattr(self, "history_vault"):
                                        self.history_vault.show_tool_error(et)
                                GLib.idle_add(_on_err)

                            # Mr. Flow User Turn
                            elif t_type in ("user", "USER_INPUT") or obj.get("source") in ("USER_EXPLICIT", "USER"):
                                def _on_user():
                                    if hasattr(self, "companion"):
                                        self.companion.set_state("thinking")
                                    if hasattr(self, "history_vault"):
                                        self.history_vault.show_thinking("Formulating response...")
                                GLib.idle_add(_on_user)

                        except Exception:
                            pass

                except Exception:
                    time.sleep(1.0)

                time.sleep(0.04)

        threading.Thread(target=_watcher_worker, daemon=True).start()

    def refresh_skills_cache(self):
        self.skills_cache = scan_all_skills()
        return True

    def load_theme_colors(self):
        if os.path.exists(CURRENT_THEME_FILE):
            try:
                with open(CURRENT_THEME_FILE, "r", encoding="utf-8") as f:
                    data = json.load(f)
                self.accent_hex = data.get("accent_color", "#00ff66")
                rgb = data.get("accent_rgb", [0, 255, 102])
                self.accent_rgb = (rgb[0] / 255.0, rgb[1] / 255.0, rgb[2] / 255.0)
                sec = data.get("secondary_rgb", [0, 242, 254])
                self.sec_rgb = (sec[0] / 255.0, sec[1] / 255.0, sec[2] / 255.0)
            except Exception:
                pass

    def check_screen_and_theme(self):
        self.load_theme_colors()
        self.sync_active_states()
        if hasattr(self, "matrix_console"):
            self.matrix_console.update_position()
        if hasattr(self, "continuity_pill") and self.continuity_pill.get_visible():
            self.continuity_pill.reposition()
        if hasattr(self, "quick_switcher") and self.quick_switcher.get_visible():
            self.quick_switcher.reposition()
        if hasattr(self, "queued_banner") and self.queued_banner.get_visible():
            self.queued_banner.reposition()
        screen = self.get_screen()
        w = screen.get_width()
        h = screen.get_height()
        if w != self.screen_w or h != self.screen_h:
            self.screen_w = w
            self.screen_h = h
            self.update_geometry()
        return True

