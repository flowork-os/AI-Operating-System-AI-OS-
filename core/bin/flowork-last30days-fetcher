#!/usr/bin/env python3
# ==============================================================================
# 📰 FLOWORK OS — LAST 30 DAYS INTELLIGENCE FETCHER
# Mengambil Isu Panas & Suara Mentah Komunitas 30 Hari Terakhir
# Sumber: Hacker News / Developer & Market Community Data
# Simpan ke: /opt/floworkos/cache/last30days_widget.json
# ==============================================================================

import os
import sys
import time
import json
import html
import re
import urllib.request

CACHE_FILE = "/opt/floworkos/cache/last30days_widget.json"
os.makedirs(os.path.dirname(CACHE_FILE), exist_ok=True)

def fetch_last30days():
    # Ambil cerita trending 24 jam terakhir (Hari Ini) dari Hacker News Algolia
    since = int(time.time() - 86400)
    url = f"https://hn.algolia.com/api/v1/search?tags=story&numericFilters=created_at_i>{since}&hitsPerPage=20"
    req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0 (FloworkOS Trending Engine)"})

    try:
        with urllib.request.urlopen(req, timeout=5.0) as res:
            data = json.loads(res.read().decode())
    except Exception as e:
        sys.stderr.write(f"Error fetching HN stories: {e}\n")
        return False

    stories = []
    best_story_id = None
    seen_titles = []
    
    # Filter dan ambil cerita tech, software, pasar yang relevan hari ini
    for hit in data.get("hits", []):
        title = hit.get("title", "").strip()
        pts = hit.get("points", 0)
        cmts = hit.get("num_comments", 0)
        obj_id = hit.get("objectID")

        lower = title.lower()
        if "has died" in lower or "died at" in lower or "passes away" in lower:
            continue

        # Cegah judul duplikat atau topik yang sama persis
        words = set([w for w in lower.split() if len(w) > 3])
        is_dup = False
        for seen in seen_titles:
            common = words.intersection(seen)
            if len(common) >= 3 and len(common) / max(1, len(words)) > 0.5:
                is_dup = True
                break
        if is_dup:
            continue
        seen_titles.append(words)

        discussion_url = f"https://news.ycombinator.com/item?id={obj_id}"

        stories.append({
            "title": title,
            "points": pts,
            "comments": cmts,
            "url": discussion_url,
            "id": obj_id
        })

        if not best_story_id and cmts >= 50:
            best_story_id = obj_id

        if len(stories) >= 6:
            break

    # Ambil kutipan komentar asli dari cerita terbaik
    quote_data = {
        "quote": "Banyak praktisi di lapangan mulai meninggalkan hype dan menuntut efisiensi komputasi nyata.",
        "author": "komunitas",
        "source": "Hacker News",
        "url": "https://news.ycombinator.com"
    }

    if best_story_id:
        try:
            c_url = f"https://hn.algolia.com/api/v1/search?tags=comment,story_{best_story_id}&hitsPerPage=8"
            c_req = urllib.request.Request(c_url, headers={"User-Agent": "Mozilla/5.0 (FloworkOS Last30Days Engine)"})
            with urllib.request.urlopen(c_req, timeout=5.0) as c_res:
                c_data = json.loads(c_res.read().decode())
                for c in c_data.get("hits", []):
                    raw = html.unescape(c.get("comment_text", ""))
                    clean = re.sub(r"<[^<]+?>", "", raw).strip()
                    clean = " ".join(clean.split())
                    author = c.get("author", "praktisi")
                    
                    if 45 <= len(clean) <= 240 and not clean.startswith(">") and "http" not in clean[:30]:
                        quote_data = {
                            "quote": clean,
                            "author": author,
                            "source": "Hacker News",
                            "url": f"https://news.ycombinator.com/item?id={c.get('objectID')}"
                        }
                        break
        except Exception as e:
            sys.stderr.write(f"Error fetching comment: {e}\n")

    payload = {
        "updated_at": time.strftime("%H:%M:%S"),
        "updated_date": time.strftime("%d %b %Y"),
        "stories": stories,
        "featured_quote": quote_data
    }

    # Tulis ke cache file secara atomic
    tmp_file = CACHE_FILE + ".tmp"
    with open(tmp_file, "w", encoding="utf-8") as f:
        json.dump(payload, f, indent=2, ensure_ascii=False)
    os.replace(tmp_file, CACHE_FILE)
    print(f"✓ Berhasil memperbarui data last30days ke {CACHE_FILE}")
    return True

if __name__ == "__main__":
    fetch_last30days()
