#!/usr/bin/env bash
# ==============================================================================
# 👑 FLOWORK OS — SOVEREIGN TARGETED REPOSITORY UPLOADER & DELTA OTA SYNCHRONIZER
# Target: https://github.com/flowork-os/AI-Operating-System-AI-OS-.git
# ==============================================================================
# FITUR UTAMA & JAMINAN ARSITEKTUR:
# 1. TARGETED DELTA SYNC: Hanya memindai dan menyalin berkas yang benar-benar
#    berubah/baru diedit. Tidak menyalin ulang payload runtime besar (on-demand).
# 2. VAKSIN ANTI-HASH MISMATCH: Otomatis menjalankan flowork-manifest-gen,
#    memvalidasi integritas 100% SHA-256 (0 mismatches), memperbarui manifest.json.gz,
#    dan meng-commit bersamaan dengan kode dalam 1 commit atomik.
# 3. ZERO-LEAK SECURITY SHIELD: Menolak dan membersihkan token, vault.json,
#    flowork.dev, SSH keys, cookies, browser user_data, dan chat logs.
# 4. UNIVERSAL CLI SUPPORT:
#    - `./upload-flowork-os.sh "pesan komit"`
#    - `./upload-flowork-os.sh /path/ke/file_baru "pesan komit"`
#    - `./upload-flowork-os.sh --dry-run`
# ==============================================================================
set -euo pipefail

# ANSI HUD Colors
BOLD="\033[1m"
GREEN="\033[38;2;0;255;102m"
CYAN="\033[38;2;0;242;254m"
AMBER="\033[38;2;255;184;0m"
RED="\033[38;2;255;51;102m"
MUTED="\033[38;2;100;116;139m"
RESET="\033[0m"

echo -e "${BOLD}${CYAN}================================================================${RESET}"
echo -e "${BOLD}${GREEN}  👑 FLOWORK OS — TARGETED OTA UPLOADER & HASH-GUARD ENGINE     ${RESET}"
echo -e "${BOLD}${CYAN}================================================================${RESET}"

# Paths resolution
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_URL="https://github.com/flowork-os/AI-Operating-System-AI-OS-.git"
REPO_API="https://api.github.com/repos/flowork-os/AI-Operating-System-AI-OS-"
FLOWORK_ROOT="/opt/floworkos"

if [ -f "${SCRIPT_DIR}/token" ]; then
    TOKEN_PATH="${SCRIPT_DIR}/token"
elif [ -f "${HOME}/Downloads/token" ]; then
    TOKEN_PATH="${HOME}/Downloads/token"
else
    TOKEN_PATH="/home/awenkaudico/Downloads/token"
fi

if [ -n "${FLOWORK_REPO_DIR:-}" ] && [ -d "${FLOWORK_REPO_DIR}/.git" ]; then
    STAGE_DIR="${FLOWORK_REPO_DIR}"
elif [ -d "${HOME}/flowork-os-repo/.git" ]; then
    STAGE_DIR="${HOME}/flowork-os-repo"
else
    STAGE_DIR="/opt/flowork-os-repo"
fi

# Options & arguments parsing
CUSTOM_MSG=""
DRY_RUN=0
EXPLICIT_FILES=()

while [ $# -gt 0 ]; do
    case "$1" in
        --dry-run)
            DRY_RUN=1; shift ;;
        -m|--message)
            CUSTOM_MSG="${2:-}"; shift 2 ;;
        -h|--help)
            echo "Usage: $(basename "$0") [options] [files...] [message]"
            echo ""
            echo "Options:"
            echo "  -m, --message <msg>  Custom commit message"
            echo "  --dry-run            Audit and verify without committing/pushing"
            echo "  -h, --help           Show this help"
            echo ""
            echo "Examples:"
            echo "  $(basename "$0") \"fix: resolve sidebar socket issue\""
            echo "  $(basename "$0") /opt/floworkos/bin/flowork-newtool \"feat: add new tool\""
            exit 0
            ;;
        *)
            if [ -f "$1" ] || [ -d "$1" ]; then
                EXPLICIT_FILES+=("$1"); shift
            elif [ -z "$CUSTOM_MSG" ]; then
                CUSTOM_MSG="$1"; shift
            else
                shift
            fi
            ;;
    esac
done

# 1. Token Validation & GitHub API Connectivity
echo -e "\n${BOLD}${CYAN}[1/5] Validating GitHub Authentication & Connectivity...${RESET}"
if [ ! -f "$TOKEN_PATH" ]; then
    echo -e "${RED}[ERROR] GitHub Token file not found at: ${TOKEN_PATH}${RESET}" >&2
    exit 1
fi
chmod 600 "$TOKEN_PATH" 2>/dev/null || true
GH_TOKEN="$(tr -d '\r\n[:space:]' < "$TOKEN_PATH")"
if [ -z "$GH_TOKEN" ]; then
    echo -e "${RED}[ERROR] GitHub Token file is empty!${RESET}" >&2
    exit 1
fi

HTTP_STATUS=$(printf 'header = "Authorization: Bearer %s"\n' "${GH_TOKEN}" | curl -s --retry 3 -o /dev/null -w "%{http_code}" -K - "${REPO_API}" || echo "000")
if [ "$HTTP_STATUS" != "200" ]; then
    echo -e "${RED}[ERROR] GitHub API returned HTTP ${HTTP_STATUS}. Check your token/permissions.${RESET}" >&2
    exit 1
fi
echo -e "${GREEN}✓ GitHub token authenticated successfully. Target: ${REPO_URL}${RESET}"

# 2. Targeted Synchronization (Only Modified or Explicitly Added Files)
echo -e "\n${BOLD}${CYAN}[2/5] Scanning & Syncing Targeted Modifications...${RESET}"

# Handle explicit files passed via CLI
if [ "${#EXPLICIT_FILES[@]}" -gt 0 ]; then
    for ef in "${EXPLICIT_FILES[@]}"; do
        abs_ef="$(realpath "$ef")"
        if [ ! -e "$abs_ef" ]; then
            echo -e "${AMBER}  [!] Skipping missing file: ${ef}${RESET}"
            continue
        fi
        # Determine mapping into repo
        if [[ "$abs_ef" == "${FLOWORK_ROOT}"* ]]; then
            rel="${abs_ef#"${FLOWORK_ROOT}/"}"
            dest="${STAGE_DIR}/core/${rel}"
        elif [[ "$abs_ef" == "/usr/local/bin/"* ]]; then
            rel="${abs_ef#/usr/local/bin/}"
            dest="${STAGE_DIR}/system/bin/${rel}"
        elif [[ "$abs_ef" == "/etc/systemd/system/"* ]]; then
            rel="${abs_ef#/etc/systemd/system/}"
            dest="${STAGE_DIR}/system/systemd/${rel}"
        elif [[ "$abs_ef" == "/etc/skel/"* ]]; then
            rel="${abs_ef#/etc/skel/}"
            dest="${STAGE_DIR}/skel/${rel}"
        elif [[ "$abs_ef" == "${STAGE_DIR}/"* ]]; then
            dest="$abs_ef"
        else
            echo -e "${AMBER}  [!] Unrecognized system path, skipping: ${abs_ef}${RESET}"
            continue
        fi
        mkdir -p "$(dirname "$dest")"
        cp -af "$abs_ef" "$dest"
        echo -e "${GREEN}  ✓ Synced target: ${abs_ef} -> ${dest#"${STAGE_DIR}/"}${RESET}"
    done
fi

# Run two-way .gitignore-driven mirror & SHA-256 Zero-Drift Gate
STAGE_DIR_ENV="${STAGE_DIR}" DRY_RUN_ENV="${DRY_RUN}" python3 - <<'PYEOF'
import os, sys, shutil, hashlib, subprocess

stage_dir = os.environ["STAGE_DIR_ENV"]
dry_run = os.environ.get("DRY_RUN_ENV", "0") == "1"
flowork_root = "/opt/floworkos"

full_targets = [
    ("core", flowork_root),
    ("system/bin", "/usr/local/bin"),
    ("skel", "/etc/skel"),
    ("iso-builder", os.path.join(flowork_root, "iso-builder")),
]

PROTECTED_PREFIXES = (
    "core/connector/",
    "core/apps/connector/",
    "core/bin/flowork-connector",
    "core/system/manifest.json",
    "core/system/version.json",
)

MAX_FILE_BYTES = 95 * 1024 * 1024  # 95 MB GitHub safety ceiling

def is_protected(rrel):
    return any(rrel == p.rstrip("/") or rrel.startswith(p) for p in PROTECTED_PREFIXES)

def sha256_file(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(65536), b""):
            h.update(chunk)
    return h.hexdigest()

def git_ignored_set(paths):
    if not paths:
        return set()
    res = set()
    chunk_size = 5000
    for i in range(0, len(paths), chunk_size):
        batch = paths[i:i + chunk_size]
        p = subprocess.run(
            ["git", "-C", stage_dir, "check-ignore", "--no-index", "--stdin"],
            input="\n".join(batch),
            text=True,
            capture_output=True,
        )
        res.update(p.stdout.splitlines())
    return res

def collect_pc_entries():
    entries = {}  # rrel -> (sf, is_link)
    for rsub, ssub in full_targets:
        if not os.path.exists(ssub):
            continue
        for root, dirs, files in os.walk(ssub):
            dirs[:] = [d for d in dirs if d != ".git"]
            for name in files:
                sf = os.path.join(root, name)
                is_link = os.path.islink(sf)
                if not is_link and (not os.path.isfile(sf) or not os.access(sf, os.R_OK)):
                    continue
                rel = os.path.relpath(sf, ssub)
                rrel = os.path.join(rsub, rel).replace("\\", "/")
                if is_protected(rrel):
                    continue
                entries[rrel] = (sf, is_link)
    # Scoped Flowork-only systemd units
    sysd_src = "/etc/systemd/system"
    if os.path.exists(sysd_src):
        for name in os.listdir(sysd_src):
            if not name.startswith("flowork"):
                continue
            sf = os.path.join(sysd_src, name)
            is_link = os.path.islink(sf)
            if is_link or os.path.isfile(sf):
                rrel = f"system/systemd/{name}"
                entries[rrel] = (sf, is_link)
    return entries

def collect_repo_entries():
    entries = {}  # rrel -> (rf, is_link)
    for rsub, _ in full_targets:
        rb = os.path.join(stage_dir, rsub)
        if not os.path.exists(rb):
            continue
        for root, dirs, files in os.walk(rb):
            dirs[:] = [d for d in dirs if d != ".git"]
            for name in files:
                rf = os.path.join(root, name)
                is_link = os.path.islink(rf)
                if not is_link and not os.path.isfile(rf):
                    continue
                rel = os.path.relpath(rf, rb)
                rrel = os.path.join(rsub, rel).replace("\\", "/")
                if is_protected(rrel):
                    continue
                entries[rrel] = (rf, is_link)
    sysd_repo = os.path.join(stage_dir, "system", "systemd")
    if os.path.exists(sysd_repo):
        for name in os.listdir(sysd_repo):
            if not name.startswith("flowork"):
                continue
            rf = os.path.join(sysd_repo, name)
            is_link = os.path.islink(rf)
            if is_link or os.path.isfile(rf):
                entries[f"system/systemd/{name}"] = (rf, is_link)
    return entries

pc_all = collect_pc_entries()
repo_all = collect_repo_entries()
ignored = git_ignored_set(sorted(set(pc_all.keys()) | set(repo_all.keys())))

pc_active = {k: v for k, v in pc_all.items() if k not in ignored}
repo_active = {k: v for k, v in repo_all.items() if k not in ignored}

adds, updates, deletes, oversized = [], [], [], []

for rrel, (sf, is_link) in sorted(pc_active.items()):
    rf = os.path.join(stage_dir, rrel)
    if not is_link:
        try:
            sz = os.path.getsize(sf)
            if sz > MAX_FILE_BYTES:
                oversized.append((sz, rrel))
        except OSError:
            continue
    if rrel not in repo_active:
        adds.append((rrel, sf, rf, is_link))
    else:
        rf_cur, r_is_link = repo_active[rrel]
        if is_link != r_is_link:
            updates.append((rrel, sf, rf, is_link))
        elif is_link:
            if os.readlink(sf) != os.readlink(rf_cur):
                updates.append((rrel, sf, rf, is_link))
        else:
            try:
                if sha256_file(sf) != sha256_file(rf_cur) or (os.stat(sf).st_mode & 0o100) != (os.stat(rf_cur).st_mode & 0o100):
                    updates.append((rrel, sf, rf, is_link))
            except OSError:
                updates.append((rrel, sf, rf, is_link))

for rrel, (rf, _) in sorted(repo_active.items()):
    if rrel not in pc_active:
        deletes.append((rrel, rf))

if oversized:
    print("  [ERROR] Files exceeding 95 MB GitHub safety limit detected (add to .gitignore):")
    for sz, rrel in oversized[:20]:
        print(f"    - {sz/1024/1024:.2f} MB  {rrel}")
    sys.exit(1)

print(f"  → Mirror plan: +{len(adds)} add, ~{len(updates)} update, -{len(deletes)} delete (ignored: {len(ignored)})")
if dry_run:
    for tag, items in [("ADD", adds), ("UPDATE", updates), ("DELETE", deletes)]:
        for item in items[:15]:
            print(f"    [{tag}] {item[0]}")
        if len(items) > 15:
            print(f"    [{tag}] ... and {len(items) - 15} more")
    sys.exit(0)

for rrel, sf, rf, is_link in adds + updates:
    os.makedirs(os.path.dirname(rf), exist_ok=True)
    if os.path.lexists(rf):
        os.unlink(rf)
    if is_link:
        os.symlink(os.readlink(sf), rf)
    else:
        shutil.copy2(sf, rf)

for rrel, rf in deletes:
    if os.path.lexists(rf):
        os.unlink(rf)
    parent = os.path.dirname(rf)
    while parent.startswith(stage_dir) and parent != stage_dir:
        try:
            if not os.listdir(parent):
                os.rmdir(parent)
                parent = os.path.dirname(parent)
            else:
                break
        except OSError:
            break

# Zero-Drift Verification Gate
pc_post = {k: v for k, v in collect_pc_entries().items() if k not in ignored}
repo_post = {k: v for k, v in collect_repo_entries().items() if k not in ignored}
drift_missing_repo = sorted(set(pc_post) - set(repo_post))
drift_missing_pc = sorted(set(repo_post) - set(pc_post))
drift_hash = []
for rrel in sorted(set(pc_post) & set(repo_post)):
    sf, s_link = pc_post[rrel]
    rf, r_link = repo_post[rrel]
    if s_link != r_link:
        drift_hash.append(rrel)
    elif s_link:
        if os.readlink(sf) != os.readlink(rf):
            drift_hash.append(rrel)
    elif sha256_file(sf) != sha256_file(rf):
        drift_hash.append(rrel)

if drift_missing_repo or drift_missing_pc or drift_hash:
    print(f"  [ERROR] Zero-Drift Gate FAILED: missing_in_repo={len(drift_missing_repo)}, missing_on_pc={len(drift_missing_pc)}, diff_hash={len(drift_hash)}")
    for p in (drift_missing_repo + drift_missing_pc + drift_hash)[:15]:
        print(f"    - {p}")
    sys.exit(1)

print(f"  ✓ Zero-Drift Gate PASSED: {len(pc_post)} active files 100% SHA-256 identical to PC.")
PYEOF

if [ "$DRY_RUN" -eq 1 ]; then
    echo -e "\n${AMBER}[DRY-RUN] Preview complete. No files modified, no manifest regenerated, no git push executed.${RESET}"
    exit 0
fi

# Clean orphan temporary files in staging
find "${STAGE_DIR}" \( -name "*.bak" -o -name "*.orig" -o -name "*~" -o -name "*.tmp" \) -delete 2>/dev/null || true
rm -f "${STAGE_DIR}/core/flowork.dev" "${STAGE_DIR}/core/system/flowork.dev" "${STAGE_DIR}/flowork.dev" 2>/dev/null || true
rm -f "${STAGE_DIR}/core/system/manifest.json"* 2>/dev/null || true

# 3. Strict Zero-Leak Security Shield
echo -e "\n${BOLD}${CYAN}[3/5] Enforcing Strict Zero-Leak Security Shield...${RESET}"

FORBIDDEN_PATTERNS=(
    "*vault.json*"
    "*token*"
    "*.key"
    "*.pem"
    "id_rsa*"
    "id_ed25519*"
    "*flowork.dev*"
    "*user_data*"
    "*history/chats/*"
    "*screenshots/*"
    "*.db"
    "*.db-*"
    "*.sqlite*"
)

LEAK_FOUND=0
cd "${STAGE_DIR}"
mapfile -t UNTRACKED_FILES < <(git status --porcelain | awk '$1 !~ /D/ {print $2}' || true)

for fpath in "${UNTRACKED_FILES[@]}"; do
    base_name=$(basename "$fpath")
    if [[ "$base_name" == ".gitkeep" ]] || [[ "$base_name" == ".gitignore" ]]; then
        continue
    fi
    for pat in "${FORBIDDEN_PATTERNS[@]}"; do
        if [[ "$fpath" == $pat ]] || [[ "$base_name" == $pat ]]; then
            echo -e "${RED}[ALERT LEAK DETECTED] Removing prohibited file from staging: ${fpath}${RESET}" >&2
            git rm --cached -f "$fpath" 2>/dev/null || true
            rm -rf "${STAGE_DIR:?}/${fpath}" 2>/dev/null || true
            LEAK_FOUND=1
        fi
    done
done

if [ "$LEAK_FOUND" -eq 1 ]; then
    echo -e "${AMBER}→ Prohibited files purged cleanly. Zero-leak shield verified.${RESET}"
fi

# Check if there are real changes to commit
mapfile -t REAL_CHANGES < <(git status --porcelain | grep -v -E "manifest\.json" || true)
if [ "${#REAL_CHANGES[@]}" -eq 0 ]; then
    echo -e "\n${BOLD}${GREEN}================================================================${RESET}"
    echo -e "${BOLD}${GREEN}  ✓ ZERO CHANGES: Repository is already 100% up to date!        ${RESET}"
    echo -e "${BOLD}${GREEN}  No new features, bugfixes, or modifications detected.        ${RESET}"
    echo -e "${BOLD}${GREEN}================================================================${RESET}"
    exit 0
fi

echo -e "${GREEN}✓ Real modifications detected (${#REAL_CHANGES[@]} file(s)):${RESET}"
for ch in "${REAL_CHANGES[@]:0:10}"; do
    echo "  ${ch}"
done

# 4. Mandatory Cryptographic Manifest Synchronization (Hash Mismatch Vaccine)
echo -e "\n${BOLD}${CYAN}[4/5] Synchronizing Cryptographic SHA-256 Manifest (Mismatch Guard)...${RESET}"
if [ ! -x "/opt/floworkos/bin/flowork-manifest-gen" ]; then
    echo -e "${RED}[ERROR] flowork-manifest-gen not found or not executable!${RESET}" >&2
    exit 1
fi

/opt/floworkos/bin/flowork-manifest-gen --repo-dir "${STAGE_DIR}" --quiet

# Verify 100% zero-mismatch invariant between manifest and disk
python3 - <<PYEOF
import json, hashlib, os, sys

repo_dir = "${STAGE_DIR}"
mf_path = os.path.join(repo_dir, "manifest.json")
if not os.path.exists(mf_path):
    sys.stderr.write("Missing manifest.json\n")
    sys.exit(1)

with open(mf_path, "r", encoding="utf-8") as f:
    mf = json.load(f)

mismatches = 0
for rel, info in mf.get("files", {}).items():
    fp = os.path.join(repo_dir, rel)
    if not os.path.exists(fp):
        mismatches += 1
        continue
    h = hashlib.sha256()
    with open(fp, "rb") as f:
        while chunk := f.read(65536):
            h.update(chunk)
    if h.hexdigest() != info["sha256"]:
        mismatches += 1

if mismatches > 0:
    sys.stderr.write(f"[ERROR] Manifest verification failed: {mismatches} mismatches found!\n")
    sys.exit(1)

print(f"  ✓ Cryptographic SHA-256 Audit: {len(mf.get('files', {}))} files verified. 0 mismatches.")
PYEOF

# Update system version metadata
NEW_MID=$(python3 -c "import json; print(json.load(open('${STAGE_DIR}/manifest.json')).get('manifest_id',''))")
NOW_UTC=$(date -u +"%Y-%m-%dT%H:%M:%SZ")

python3 - <<PYEOF
import os, json
mid = "${NEW_MID}"
now = "${NOW_UTC}"
for vp in ["/opt/floworkos/system/version.json", "${STAGE_DIR}/core/system/version.json"]:
    try:
        if os.path.exists(vp):
            with open(vp, "r") as f:
                v = json.load(f)
            if mid:
                v["manifest_id"] = mid
            v["last_updated"] = now
            with open(vp, "w") as f:
                json.dump(v, f, indent=2)
    except Exception:
        pass
PYEOF

# Copy manifest to /opt/floworkos/system and stage core/system
cp -f "${STAGE_DIR}/manifest.json" "${FLOWORK_ROOT}/system/manifest.json" 2>/dev/null || true
cp -f "${STAGE_DIR}/manifest.json.gz" "${FLOWORK_ROOT}/system/manifest.json.gz" 2>/dev/null || true
mkdir -p "${STAGE_DIR}/core/system"
cp -f "${STAGE_DIR}/manifest.json" "${STAGE_DIR}/core/system/manifest.json" 2>/dev/null || true
cp -f "${STAGE_DIR}/manifest.json.gz" "${STAGE_DIR}/core/system/manifest.json.gz" 2>/dev/null || true

if [ "$DRY_RUN" -eq 1 ]; then
    echo -e "\n${AMBER}[DRY-RUN COMPLETE] All files verified. Exiting without git commit or push.${RESET}"
    exit 0
fi

# 5. Atomic Targeted Git Commit & Push (Only Modified/Repaired Files)
echo -e "\n${BOLD}${CYAN}[5/5] Committing & Pushing Targeted Updates to GitHub...${RESET}"
git config user.name "Flowork OS"
git config user.email "floworkos@gmail.com"

# Stage ONLY modified tracked files and explicit targets (never blanket git add -A)
if [ "${#EXPLICIT_FILES[@]}" -gt 0 ]; then
    for ef in "${EXPLICIT_FILES[@]}"; do
        abs_ef="$(realpath "$ef" 2>/dev/null || echo "$ef")"
        if [[ "$abs_ef" == "${STAGE_DIR}/"* ]]; then
            rel="${abs_ef#"${STAGE_DIR}/"}"
            git add "$rel" 2>/dev/null || true
        elif [[ "$abs_ef" == "${FLOWORK_ROOT}"* ]]; then
            rel="${abs_ef#"${FLOWORK_ROOT}/"}"
            git add "core/${rel}" 2>/dev/null || true
        else
            git add "$ef" 2>/dev/null || true
        fi
    done
fi

# Untrack any previously tracked files that now match .gitignore (without deleting from PC)
git ls-files -c -i --exclude-standard -z | xargs -0 -r git rm --cached --quiet || true

# Stage all non-ignored additions, updates, and deletions in mirrored directories
git add -A core/ system/ skel/ iso-builder/
git add -u README.md DISTRIBUTION_MANUAL.md llms.txt .gitignore 2>/dev/null || true
git add -u manifest.json manifest.json.gz core/system/manifest.json core/system/manifest.json.gz 2>/dev/null || true

mapfile -t STAGED_FILES < <(git diff --cached --name-only || true)
if [ "${#STAGED_FILES[@]}" -eq 0 ]; then
    echo -e "${AMBER}  [!] No modified files staged to push. Repository is up to date.${RESET}"
    exit 0
fi

echo -e "${GREEN}✓ Targeted staged files (${#STAGED_FILES[@]} file(s)):${RESET}"
for sf in "${STAGED_FILES[@]:0:15}"; do
    echo "  → ${sf}"
done

if [ -n "$CUSTOM_MSG" ]; then
    COMMIT_MSG="$CUSTOM_MSG"
else
    mapfile -t MOD_NAMES < <(git diff --cached --name-only | grep -v 'manifest.json' || true)
    if [ "${#MOD_NAMES[@]}" -gt 0 ]; then
        SUMMARY_CHANGES=$(printf '%s, ' "${MOD_NAMES[@]:0:3}" | sed 's/, $//')
        COMMIT_MSG="update(flowork-os): ${SUMMARY_CHANGES}"
    else
        COMMIT_MSG="fix(flowork-os): targeted update & delta manifest sync (${NOW_UTC})"
    fi
fi

# Normal targeted commit (preserves history unless explicitly requested)
git commit -m "$COMMIT_MSG"
NEW_COMMIT=$(git rev-parse HEAD)
echo -e "${GREEN}✓ Committed: ${NEW_COMMIT:0:10} - ${COMMIT_MSG}${RESET}"

# Setup askpass for non-interactive secure push
ASKPASS_SCRIPT="$(mktemp /tmp/.flowork_git_askpass.XXXXXX)"
chmod 700 "${ASKPASS_SCRIPT}"
cat > "${ASKPASS_SCRIPT}" <<EOF
#!/usr/bin/env bash
case "\$1" in
    *Username*) echo "x-access-token" ;;
    *Password*) echo "${GH_TOKEN}" ;;
    *) echo "" ;;
esac
EOF

trap 'rm -f "${ASKPASS_SCRIPT}"' EXIT

git remote remove origin 2>/dev/null || true
git remote add origin "$REPO_URL"

# Normal push of targeted commit (no hard force push)
echo -e "${CYAN}→ Pushing targeted modifications to origin main (normal push)...${RESET}"
GIT_ASKPASS="${ASKPASS_SCRIPT}" git push origin main

# Also update commit in host version.json
python3 -c "
import json
vp = '/opt/floworkos/system/version.json'
try:
    with open(vp, 'r') as f: v = json.load(f)
    v['commit'] = '${NEW_COMMIT}'
    with open(vp, 'w') as f: json.dump(v, f, indent=2)
except Exception: pass
" 2>/dev/null || true

echo -e "\n${BOLD}${GREEN}================================================================${RESET}"
