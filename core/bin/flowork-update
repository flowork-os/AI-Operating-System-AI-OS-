#!/usr/bin/env python3
import argparse
import gzip
import hashlib
import json
import os
import shutil
import sys
import tempfile
import urllib.request
from datetime import datetime, timezone

DEFAULT_MANIFEST_URL = "https://raw.githubusercontent.com/flowork-os/AI-Operating-System-AI-OS-/main/manifest.json.gz"
BACKUP_ROOT = os.path.expanduser("~/.flowork/timemachine/ota_backups")
PROTECTED_PREFIXES = ("/opt/floworkos/connector/",)


def sha256_file(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(65536), b""):
            h.update(chunk)
    return h.hexdigest()


def load_manifest(url, local_path=None):
    if local_path:
        with gzip.open(local_path, "rb") as f:
            return json.loads(f.read().decode("utf-8"))
    req = urllib.request.Request(url, headers={"User-Agent": "flowork-update/1.0"})
    with urllib.request.urlopen(req, timeout=20) as resp:
        raw = resp.read()
    return json.loads(gzip.decompress(raw).decode("utf-8"))


def compute_delta(manifest):
    files = manifest.get("files", {})
    changed = []
    for rel_path, meta in files.items():
        target = meta.get("target")
        expected_sha = meta.get("sha256")
        if not target or not expected_sha:
            continue
        if any(target.startswith(p) for p in PROTECTED_PREFIXES):
            continue
        if not os.path.isfile(target):
            changed.append({"rel": rel_path, "target": target, "reason": "missing", "meta": meta})
        else:
            try:
                local_sha = sha256_file(target)
            except PermissionError:
                continue
            if local_sha != expected_sha:
                changed.append({"rel": rel_path, "target": target, "reason": "modified", "meta": meta})
    return changed


def apply_delta(manifest, changed):
    if not changed:
        return {"applied": 0, "backup_dir": None}
    ts = datetime.now(timezone.utc).strftime("%Y%m%d_%H%M%S")
    backup_dir = os.path.join(BACKUP_ROOT, ts)
    os.makedirs(backup_dir, exist_ok=True)
    raw_base = manifest.get("raw_base_url", "").rstrip("/")
    applied = 0

    for item in changed:
        target = item["target"]
        rel = item["rel"]
        expected_sha = item["meta"]["sha256"]
        mode = int(item["meta"].get("mode", "644"), 8)
        url = f"{raw_base}/{rel}"

        req = urllib.request.Request(url, headers={"User-Agent": "flowork-update/1.0"})
        with urllib.request.urlopen(req, timeout=30) as resp:
            data = resp.read()

        actual_sha = hashlib.sha256(data).hexdigest()
        if actual_sha != expected_sha:
            raise RuntimeError(f"SHA-256 mismatch for {rel}: expected {expected_sha}, got {actual_sha}")

        if os.path.isfile(target):
            b_path = os.path.join(backup_dir, target.lstrip("/"))
            os.makedirs(os.path.dirname(b_path), exist_ok=True)
            shutil.copy2(target, b_path)

        os.makedirs(os.path.dirname(target), exist_ok=True)
        fd, tmp_path = tempfile.mkstemp(dir=os.path.dirname(target), prefix=".ota_")
        try:
            with os.fdopen(fd, "wb") as f:
                f.write(data)
            os.chmod(tmp_path, mode)
            os.replace(tmp_path, target)
        except Exception:
            if os.path.exists(tmp_path):
                os.unlink(tmp_path)
            raise
        applied += 1

    return {"applied": applied, "backup_dir": backup_dir}


def rollback_latest():
    if not os.path.isdir(BACKUP_ROOT):
        return {"restored": 0, "backup_dir": None}
    snaps = sorted(d for d in os.listdir(BACKUP_ROOT) if os.path.isdir(os.path.join(BACKUP_ROOT, d)))
    if not snaps:
        return {"restored": 0, "backup_dir": None}
    latest = os.path.join(BACKUP_ROOT, snaps[-1])
    restored = 0
    for root, _, files in os.walk(latest):
        for fname in files:
            src = os.path.join(root, fname)
            rel = os.path.relpath(src, latest)
            dst = "/" + rel
            os.makedirs(os.path.dirname(dst), exist_ok=True)
            shutil.copy2(src, dst)
            restored += 1
    return {"restored": restored, "backup_dir": latest}


def main():
    parser = argparse.ArgumentParser(description="Flowork OS Delta OTA Updater")
    parser.add_argument("--check", action="store_true", help="Check for delta updates")
    parser.add_argument("--apply", action="store_true", help="Apply delta updates with backup")
    parser.add_argument("--rollback", action="store_true", help="Rollback latest OTA backup")
    parser.add_argument("--manifest-url", default=DEFAULT_MANIFEST_URL)
    parser.add_argument("--local-manifest", default=None, help="Use local manifest.json.gz for verification")
    parser.add_argument("--json", action="store_true", help="Output JSON")
    args = parser.parse_args()

    if args.rollback:
        res = rollback_latest()
        print(json.dumps(res, indent=2) if args.json else f"Rolled back {res['restored']} files from {res['backup_dir']}")
        return

    manifest = load_manifest(args.manifest_url, args.local_manifest)
    changed = compute_delta(manifest)

    if args.apply:
        res = apply_delta(manifest, changed)
        out = {"commit": manifest.get("commit"), "delta_count": len(changed), **res}
        print(json.dumps(out, indent=2) if args.json else f"Applied {res['applied']} delta updates (backup: {res['backup_dir']})")
    else:
        out = {
            "commit": manifest.get("commit"),
            "total_manifest_files": len(manifest.get("files", {})),
            "delta_count": len(changed),
            "sample_deltas": [{"target": c["target"], "reason": c["reason"]} for c in changed[:20]],
        }
        if args.json:
            print(json.dumps(out, indent=2))
        else:
            print(f"Remote commit: {out['commit']} | Manifest files: {out['total_manifest_files']} | Delta: {out['delta_count']}")
            for c in out["sample_deltas"]:
                print(f"  - [{c['reason']}] {c['target']}")


if __name__ == "__main__":
    main()
