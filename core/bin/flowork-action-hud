#!/usr/bin/env python3
"""
Flowork OS — Pure Optical Crystal Glass Action Confirmation HUD
Pops up on cursor drop to confirm action before transforming media.
Decoupled from XDND transaction: 100% immune to X11 grab deadlocks and Nemo freezing.
"""
import os
import sys
import threading
import subprocess
from pathlib import Path

import gi
gi.require_version('Gtk', '3.0')
gi.require_version('Gdk', '3.0')
gi.require_version('GdkPixbuf', '2.0')
from gi.repository import Gtk, Gdk, GdkPixbuf, GLib

TRANSFORMER_BIN = "/opt/floworkos/bin/flowork-transformer"
SFX_COMPLETE = "/usr/share/sounds/freedesktop/stereo/complete.oga"

