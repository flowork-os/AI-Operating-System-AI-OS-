#!/usr/bin/env python3
# ==============================================================================
# 🚀 FLOWORK OS — GITHUB TRENDING REPOSITORIES FETCHER (DAILY / HARI INI)
# Mengambil Repository Paling Trending Hari Ini Secara Real & Terverifikasi
# Hemat Sumber Daya: Cache Lokal 24 Jam (86400 Detik) — Nol Beban RAM & CPU
# ==============================================================================

import os
import sys
import time
import json
import re
import html
import urllib.request

CACHE_FILE = "/opt/floworkos/cache/trending_repos.json"
CACHE_TTL = 86400  # 24 jam penuh

os.makedirs(os.path.dirname(CACHE_FILE), exist_ok=True)

def fetch_from_github_trending():
    url = "https://github.com/trending?since=daily"
    req = urllib.request.Request(
        url,
        headers={"User-Agent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"}
    )
    with urllib.request.urlopen(req, timeout=6.0) as res:
        page = res.read().decode("utf-8", errors="ignore")

    articles = re.findall(r'<article class="Box-row">([\s\S]*?)</article>', page)
    items = []
    for art in articles[:6]:
        m = re.search(r'href="/([^"/]+/[^"/]+)"\s+data-view-component', art)
        repo = m.group(1).strip() if m else ""
        if not repo:
            m2 = re.search(r'href="/([a-zA-Z0-9_\-\.]+/[a-zA-Z0-9_\-\.]+)"', art)
            repo = m2.group(1).strip() if m2 else ""
        if not repo or "/stargazers" in repo:
            continue

        desc_m = re.search(r'<p class="[^"]*color-fg-muted[^"]*">([\s\S]*?)</p>', art)
        desc = ""
        if desc_m:
            desc = html.unescape(re.sub(r'<[^>]+>', '', desc_m.group(1))).strip()
            desc = " ".join(desc.split())

        lang_m = re.search(r'itemprop="programmingLanguage">([^<]+)<', art)
        lang = lang_m.group(1).strip() if lang_m else "Code"

        st_m = re.search(r'([\d,]+)\s+stars today', art)
        stars_today = st_m.group(1).replace(",", "") if st_m else ""

        tot_m = re.search(r'href="/[^"]+/stargazers"[\s\S]*?([0-9,]+)\s*</a>', art)
        total_stars = tot_m.group(1).replace(",", "") if tot_m else ""

        items.append({
            "name": repo,
            "stars": int(total_stars) if total_stars else (int(stars_today) if stars_today else 0),
            "stars_today": f"+{int(stars_today):,}" if stars_today else "",
            "desc": desc or "Tidak ada deskripsi.",
            "lang": lang,
            "url": f"https://github.com/{repo}"
        })

    return items


def fetch_from_github_api():
    since_date = time.strftime("%Y-%m-%d", time.gmtime(time.time() - 3 * 86400))
    url = f"https://api.github.com/search/repositories?q=created:>{since_date}+stars:>50&sort=stars&order=desc&per_page=6"
    req = urllib.request.Request(url, headers={"User-Agent": "FloworkOS-Trending-Engine/1.0"})
    with urllib.request.urlopen(req, timeout=6.0) as res:
        raw = json.loads(res.read().decode())
        items = []
        for item in raw.get("items", [])[:4]:
            desc = item.get("description", "") or "Tidak ada deskripsi."
            desc = " ".join(desc.split())
            items.append({
                "name": item.get("full_name", ""),
                "stars": item.get("stargazers_count", 0),
                "stars_today": f"+{item.get('stargazers_count', 0):,}",
                "desc": desc,
                "lang": item.get("language", "") or "Source",
                "url": item.get("html_url", "")
            })
        return items


def fetch_trending_repos(force=False):
    # 1. Cek masa aktif cache lokal (24 jam)
    if not force and os.path.exists(CACHE_FILE):
        try:
            mtime = os.path.getmtime(CACHE_FILE)
            age = time.time() - mtime
            if age < CACHE_TTL:
                with open(CACHE_FILE, "r", encoding="utf-8") as f:
                    data = json.load(f)
                return data
        except Exception:
            pass

    # 2. Ambil trending repos harian
    items = []
    try:
        items = fetch_from_github_trending()
    except Exception as e:
        sys.stderr.write(f"Scraping trending gagal, coba API: {e}\n")

    if not items:
        try:
            items = fetch_from_github_api()
        except Exception as e:
            sys.stderr.write(f"API fallback gagal: {e}\n")

    if items:
        payload = {
            "cached_at": time.time(),
            "cached_time_str": time.strftime("%d %b %Y %H:%M"),
            "repos": items
        }
        tmp_file = CACHE_FILE + ".tmp"
        with open(tmp_file, "w", encoding="utf-8") as f:
            json.dump(payload, f, indent=2, ensure_ascii=False)
        os.replace(tmp_file, CACHE_FILE)
        return payload

    if os.path.exists(CACHE_FILE):
        with open(CACHE_FILE, "r", encoding="utf-8") as f:
            return json.load(f)

    return {"cached_at": time.time(), "cached_time_str": "--:--", "repos": []}


if __name__ == "__main__":
    force_run = "--force" in sys.argv
    res = fetch_trending_repos(force=force_run)
    print(f"✓ Berhasil mengelola cache trending repos ({len(res.get('repos', []))} repos terdaftar)")
