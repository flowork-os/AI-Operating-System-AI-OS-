[Unit]
Description=Flowork OS Desktop SEO Keyword Research Widget (Top Search Pill & Results HUD)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/opt/floworkos/bin/flowork-seo-widget
Restart=always
RestartSec=3
Environment=DISPLAY=:0

[Install]
WantedBy=default.target
