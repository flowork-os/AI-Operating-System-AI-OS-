[Unit]
Description=Flowork OS Sovereign Chrono Sentinel Desktop HUD (Power & Sleep Timer)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/opt/floworkos/bin/flowork-chrono-sentinel
Restart=always
RestartSec=3
Environment=DISPLAY=:0

[Install]
WantedBy=graphical-session.target default.target
