[Desktop Entry]
Name=Files
Name[id]=Berkas
Comment=Access and organize files
Comment[id]=Akses dan kelola berkas
Exec=nemo %U
Icon=system-file-manager
Keywords=folders;filesystem;explorer;
Terminal=false
Type=Application
StartupNotify=false
Categories=GNOME;GTK;Utility;Core;
MimeType=inode/directory;application/x-gnome-saved-search;
Actions=open-home;open-computer;open-trash;Remix;
X-XFCE-Source=file:///usr/share/applications/nemo.desktop

[Desktop Action open-home]
Name=Home
Name[id]=Beranda
Exec=nemo %U

[Desktop Action open-computer]
Name=Computer
Name[id]=Komputer
Exec=nemo computer:///

[Desktop Action open-trash]
Name=Trash
Name[id]=Tempat sampah
Exec=nemo trash:///

[Desktop Action Remix]
Name=🛠️ Remix with Mr. Flow
Exec=/opt/floworkos/bin/flowork-launch --remix nemo
